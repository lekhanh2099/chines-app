          "type": "grammar_structure",
          "order": 2,
          "title": "Tính từ đơn âm tiết: AA 的 + danh từ",
          "pattern": "AA 的 + 名词",
          "meaning_vi": "Miêu tả đặc điểm nhìn thấy được, sinh động và mềm hơn dạng tính từ thường.",
          "formulas": [
            {
              "label": "mẫu",
              "pattern": "高 → 高高的；黄 → 黄黄的；蓝 → 蓝蓝的"
            }
