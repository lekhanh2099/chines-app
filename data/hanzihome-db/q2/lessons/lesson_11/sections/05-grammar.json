  "items": [
    {
      "id": "grammar_001",
      "type": "grammar_point",
      "order": 1,
      "title": "是……的",
      "title_vi": "Cấu trúc nhấn mạnh 是……的",
      "level": "HSK3+",
      "tags": [
        "语法",
        "emphasis"
      ],
      "source_origin": "textbook_checked",
      "check_needed": false,
      "blocks": [
        {
          "id": "b7c5d870-2db8-4e2e-950f-f0e6e522ac16",
          "type": "grammar_overview",
          "order": 1,
          "title": "Bản chất",
          "content_vi": "是……的 dùng để nhấn mạnh thông tin cụ thể của một hành động đã xảy ra: thời gian, địa điểm, cách thức, người đi cùng hoặc mục đích.",
          "examples": [
            {
              "id": "example_001",
              "zh": "我是跟旅游团一起来的。",
              "pinyin": "Wǒ shì gēn lǚyóutuán yìqǐ lái de.",
              "vi": "Tôi đi cùng đoàn du lịch đến.",
              "en": "",
              "highlight": [],
              "grammar_refs": [
                "grammar_001"
              ],
              "vocab_refs": [],
              "source_ref": "",
              "note_vi": "",
              "audio_key": "",
              "source_origin": "textbook_checked",
              "check_needed": false
            },
            {
              "id": "example_002",
              "zh": "你的汉语是在哪儿学的？",
              "pinyin": "Nǐ de Hànyǔ shì zài nǎr xué de?",
              "vi": "Tiếng Hán của bạn học ở đâu vậy?",
              "en": "",
              "highlight": [],
              "grammar_refs": [
                "grammar_001"
              ],
              "vocab_refs": [],
              "source_ref": "",
              "note_vi": "",
              "audio_key": "",
              "source_origin": "textbook_checked",
              "check_needed": false
            }
          ]
        },
        {
          "id": "b3534a40-3bab-464a-97dd-67889b8bcb7b",
          "type": "grammar_structure",
          "order": 2,
          "title": "Cấu trúc chính",
          "pattern": "主语 + 是 + 被强调成分 + 动词 + 的",
          "meaning_vi": "Chính là... / là... mà...; nhấn mạnh chi tiết của hành động đã xảy ra.",
          "formulas": [
            {
              "label": "khẳng định",
              "pattern": "S + 是 + detail + V + 的"
            },
            {
              "label": "lược 是",
              "pattern": "S + detail + V + 的"
            }
          ],
          "examples": [
            {
              "id": "example_003",
              "zh": "前天刚到的。",
              "pinyin": "Qiántiān gāng dào de.",
              "vi": "Vừa đến hôm kia.",
              "en": "",
              "highlight": [],
              "grammar_refs": [
                "grammar_001"
              ],
              "vocab_refs": [],
              "source_ref": "",
              "note_vi": "",
              "audio_key": "",
              "source_origin": "textbook_checked",
              "check_needed": false
            },
            {
              "id": "example_004",
              "zh": "我是从去年暑假才开始学习汉语的。",
              "pinyin": "Wǒ shì cóng qùnián shǔjià cái kāishǐ xuéxí Hànyǔ de.",
              "vi": "Tôi bắt đầu học tiếng Hán từ kỳ nghỉ hè năm ngoái.",
              "en": "",
              "highlight": [],
              "grammar_refs": [
                "grammar_001"
              ],
              "vocab_refs": [],
              "source_ref": "",
              "note_vi": "",
              "audio_key": "",
              "source_origin": "textbook_checked",
              "check_needed": false
            }
          ]
        },
        {
          "id": "0ea62f46-0157-49d6-aadc-75dbed1d507b",
          "type": "grammar_question_form",
          "order": 3,
          "title": "Dạng nghi vấn",
          "pattern": "主语 + 是 + 疑问成分 + 动词 + 的？",
          "meaning_vi": "Hỏi chi tiết được nhấn mạnh: khi nào, ở đâu, đi với ai, bằng cách nào.",
          "examples": [
            {
              "id": "example_005",
              "zh": "你是什么时候来的？",
              "pinyin": "Nǐ shì shénme shíhou lái de?",
              "vi": "Bạn đến lúc nào?",
              "en": "",
              "highlight": [],
              "grammar_refs": [
                "grammar_001"
              ],
              "vocab_refs": [],
              "source_ref": "",
              "note_vi": "",
              "audio_key": "",
              "source_origin": "textbook_checked",
              "check_needed": false
            },
            {
              "id": "example_006",
              "zh": "你是怎么来的？",
              "pinyin": "Nǐ shì zěnme lái de?",
              "vi": "Bạn đến bằng cách nào?",
              "en": "",
              "highlight": [],
              "grammar_refs": [
                "grammar_001"
              ],
              "vocab_refs": [],
              "source_ref": "",
              "note_vi": "",
              "audio_key": "",
              "source_origin": "textbook_checked",
              "check_needed": false
            }
          ]
        },
        {
          "id": "d20f2f52-d6ab-478a-b684-6adcb0004a12",
          "type": "grammar_negative_form",
          "order": 4,
          "title": "Dạng phủ định",
          "pattern": "不是 + 被强调成分 + 动词 + 的",
          "wrong_pattern": "不是 phủ định chi tiết, không phủ định toàn bộ sự kiện đã xảy ra",
          "meaning_vi": "Phủ định chi tiết được nhấn mạnh.",
          "correct_examples": [
            {
              "id": "grammar_001_correct_001",
              "zh": "我不是一个人来的。",
              "pinyin": "Wǒ bú shì yí ge rén lái de.",
              "vi": "Tôi không phải đi một mình đến.",
              "explanation_vi": "Phủ định chi tiết 'một mình'."
            },
            {
              "id": "grammar_001_correct_002",
              "zh": "我不是坐飞机来的，是坐高铁来的。",
              "pinyin": "Wǒ bú shì zuò fēijī lái de, shì zuò gāotiě lái de.",
              "vi": "Tôi không phải đến bằng máy bay, mà đến bằng tàu cao tốc.",
              "explanation_vi": "Phủ định phương tiện."
            }
          ],
          "wrong_examples": [
            {
              "id": "grammar_001_wrong_001",
              "zh": "我是跟旅游团一起来了。",
              "pinyin": "Wǒ shì gēn lǚyóutuán yìqǐ lái le.",
              "vi": "",
              "explanation_vi": "Muốn nhấn mạnh 'đi cùng đoàn du lịch' thì dùng 是……的, không dùng 了 ở cuối câu."
            }
          ]
        }
      ]
    },
    {
      "id": "grammar_002",
      "type": "grammar_point",
      "order": 2,
      "title": "一……就……",
      "title_vi": "Vừa/hễ... thì...",
      "level": "HSK3+",
      "tags": [
        "语法",
        "sequence"
      ],
      "source_origin": "textbook_checked",
      "check_needed": false,
      "blocks": [
        {
          "id": "470b1ca1-e0a1-449f-b55e-a8aa481a4dd4",
          "type": "grammar_overview",
          "order": 1,
          "title": "Bản chất",
          "content_vi": "一……就…… diễn tả hành động/tình huống thứ nhất vừa xảy ra thì hành động/kết quả thứ hai lập tức xảy ra.",
          "examples": [
            {
              "id": "example_007",
              "zh": "中国人一听就知道你是老外。",
              "pinyin": "Zhōngguó rén yì tīng jiù zhīdào nǐ shì lǎowài.",
              "vi": "Người Trung Quốc vừa nghe là biết bạn là người nước ngoài.",
              "en": "",
              "highlight": [],
              "grammar_refs": [
                "grammar_002"
              ],
              "vocab_refs": [],
              "source_ref": "",
              "note_vi": "",
              "audio_key": "",
              "source_origin": "textbook_checked",
              "check_needed": false
            },
            {
              "id": "example_008",
              "zh": "一有来中国的旅游团，他就安排我陪团来。",
              "pinyin": "Yì yǒu lái Zhōngguó de lǚyóutuán, tā jiù ānpái wǒ péi tuán lái.",
              "vi": "Hễ có đoàn du lịch đến Trung Quốc, ông ấy liền sắp xếp cho tôi đi theo đoàn.",
              "en": "",
              "highlight": [],
              "grammar_refs": [
                "grammar_002"
              ],
              "vocab_refs": [],
              "source_ref": "",
              "note_vi": "",
              "audio_key": "",
              "source_origin": "textbook_checked",
              "check_needed": false
            }
          ]
        },
        {
          "id": "0ef2b790-3209-4b5c-a519-ca5a424e4d49",
          "type": "grammar_structure",
          "order": 2,
          "title": "Cấu trúc chính",
          "pattern": "一 + V/情况1 + 就 + 结果/动作2",
          "meaning_vi": "Ngay sau khi điều kiện/hành động đầu xảy ra, kết quả/hành động sau xảy ra.",
          "formulas": [
            {
              "label": "công thức",
              "pattern": "一 + V1 + 就 + V2"
            }
          ],
          "examples": [
            {
              "id": "example_009",
              "zh": "老师一进教室，学生就安静了。",
              "pinyin": "Lǎoshī yí jìn jiàoshì, xuésheng jiù ānjìng le.",
              "vi": "Thầy vừa vào lớp, học sinh liền im lặng.",
              "en": "",
              "highlight": [],
              "grammar_refs": [
                "grammar_002"
              ],
              "vocab_refs": [],
              "source_ref": "",
              "note_vi": "",
              "audio_key": "",
              "source_origin": "generated_checked",
              "check_needed": false
            },
            {
              "id": "example_010",
              "zh": "他一有空就看中文书。",
              "pinyin": "Tā yì yǒu kòng jiù kàn Zhōngwén shū.",
              "vi": "Hễ rảnh là anh ấy đọc sách tiếng Trung.",
              "en": "",
              "highlight": [],
              "grammar_refs": [
                "grammar_002"
              ],
              "vocab_refs": [],
              "source_ref": "",
              "note_vi": "",
              "audio_key": "",
              "source_origin": "generated_checked",
              "check_needed": false
            }
          ]
        },
        {
          "id": "7ef0fe1b-7a15-4bc5-a252-97371e9335a3",
          "type": "grammar_negative_form",
          "order": 3,
          "title": "Dạng phủ định",
          "pattern": "一 + V1 + 就 + 不/没 + V2",
          "meaning_vi": "Hễ/vừa xảy ra tình huống đầu thì kết quả phủ định xuất hiện.",
          "correct_examples": [
            {
              "id": "grammar_002_correct_001",
              "zh": "他一紧张就说不好汉语。",
              "pinyin": "Tā yì jǐnzhāng jiù shuō bù hǎo Hànyǔ.",
              "vi": "Hễ căng thẳng là anh ấy nói tiếng Hán không tốt.",
              "explanation_vi": "就 nối kết quả sau tình huống 一紧张."
            },
            {
              "id": "grammar_002_correct_002",
              "zh": "我一听快句子就听不懂。",
              "pinyin": "Wǒ yì tīng kuài jùzi jiù tīng bù dǒng.",
              "vi": "Tôi cứ nghe câu nhanh là không hiểu.",
              "explanation_vi": "Kết quả phủ định là 听不懂."
            }
          ],
          "wrong_examples": [
            {
              "id": "grammar_002_wrong_001",
              "zh": "我一有空看电视。",
              "pinyin": "Wǒ yì yǒu kòng kàn diànshì.",
              "vi": "",
              "explanation_vi": "Thiếu 就; đúng là 我一有空就看电视。"
            }
          ]
        }
      ]
    },
    {
      "id": "grammar_003",
      "type": "grammar_point",
      "order": 3,
      "title": "形容词重叠",
      "title_vi": "Tính từ lặp lại",
