          "order": 1,
          "title": "Bản chất",
          "content_vi": "Tính từ lặp lại làm câu miêu tả mềm hơn, hình tượng hơn và tự nhiên hơn, nhất là khi tả dáng vẻ, màu sắc, trạng thái.",
          "examples": [
            {
              "id": "example_011",
              "zh": "高高的鼻子，黄黄的头发，蓝蓝的眼睛。",
              "pinyin": "Gāogāo de bízi, huánghuáng de tóufa, lánlán de yǎnjing.",
              "vi": "Mũi cao cao, tóc vàng vàng, mắt xanh xanh.",
              "en": "",
              "highlight": [],
              "grammar_refs": [
