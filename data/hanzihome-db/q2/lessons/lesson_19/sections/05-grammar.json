                "c99a633b-27a2-429b-a139-44113a84c189",
                "d45d5488-9293-41ae-9deb-1e5b51cee446"
              ],
              "source_ref": "",
              "note_vi": "",
              "audio_key": "",
              "source_origin": "textbook/generated_mixed",
              "check_needed": false
            },
            {
