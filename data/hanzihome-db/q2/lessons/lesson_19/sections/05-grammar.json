      "blocks": [
        {
          "id": "b7c5d870-2db8-4e2e-950f-f0e6e522ac16",
          "type": "grammar_overview",
          "order": 1,
          "title": "Bản chất",
          "content_vi": "被 dùng khi chủ ngữ là người/vật chịu tác động, không phải người chủ động làm hành động. Bài này dùng nhiều cho các chuyện không may như bị xe đâm, bị trộm ví, bị mưa làm ướt, bị phạt.",
          "examples": [
            {
              "id": "2e38466f-cc5f-451a-9612-b188f7cd2dcf",
              "zh": "我的腿被自行车撞伤了。",
              "pinyin": "Wǒ de tuǐ bèi zìxíngchē zhuàng shāng le.",
              "vi": "Chân tôi bị xe đạp đâm bị thương.",
              "en": "",
              "highlight": [],
              "grammar_refs": [
                "grammar_q2_l19_01"
              ],
              "vocab_refs": [
                "3dc505f1-bc0e-4a96-b448-17fed89fdc60",
                "68c05a12-9d8e-45d9-a413-786bcf2f780a",
                "54613016-834a-4fc3-9912-2357a6d27058",
                "54b36889-82be-485b-8342-fb8aab572065"
              ],
              "source_ref": "",
              "note_vi": "",
              "audio_key": "",
              "source_origin": "textbook/generated_mixed",
              "check_needed": false
            }
          ]
        },
        {
          "id": "9d83e784-897b-4a04-a96a-5150b897141f",
          "type": "grammar_structure",
          "order": 2,
          "title": "Cấu trúc chính",
          "pattern": "Chủ ngữ chịu tác động + 被 + tác nhân + động từ + thành phần kết quả",
          "meaning_vi": "Dùng để nói người/vật bị một tác nhân nào đó làm cho thay đổi trạng thái.",
          "formulas": [
            {
              "label": "被",
              "pattern": "S chịu tác động + 被 + tác nhân + V + kết quả"
            }
          ],
          "examples": [
            {
              "id": "64dc50f6-13c5-4723-9aed-94e0d978cb90",
              "zh": "我的钱包儿被小偷儿偷走了。",
              "pinyin": "Wǒ de qiánbāor bèi xiǎotōur tōu zǒu le.",
              "vi": "Ví của tôi bị kẻ trộm lấy mất.",
              "en": "",
              "highlight": [],
              "grammar_refs": [
                "grammar_q2_l19_01"
              ],
              "vocab_refs": [
                "689eb64b-5d4f-469f-9afa-74017d399614",
