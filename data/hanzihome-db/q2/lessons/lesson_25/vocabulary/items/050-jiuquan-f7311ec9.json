    {
      "id": "777f76f3-660b-4825-b1d9-4bb29ff24ce6",
      "order": 1,
      "zh": "这个词常出现在“九泉之下”里。",
      "pinyin": "Zhège cí cháng chūxiàn zài “jiǔquán zhī xià” lǐ.",
      "vi": "Từ này thường xuất hiện trong cụm “dưới chín suối”.",
      "analysis_vi": "九泉之下 là cụm cố định, không nên tách nghĩa từng chữ để dùng bừa.",
      "highlight": [
        "九泉"
      ],
      "grammar_refs": [],
