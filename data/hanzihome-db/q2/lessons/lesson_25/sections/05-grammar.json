          "type": "grammar_overview",
          "order": 1,
          "title": "Bản chất",
          "content_vi": "Đưa một trường hợp đặc biệt/cực đoan ra để nhấn mạnh. Khi trường hợp đó còn như vậy, các trường hợp khác càng khỏi nói.",
          "examples": []
        },
        {
          "id": "a6012e0f-4ca0-438c-bcf0-1043d8150bda",
          "type": "grammar_structure",
          "order": 2,
          "title": "Dùng trong câu phủ định",
          "pattern": "连 + A + 也 / 都 + 不 / 没 + V",
          "meaning_vi": "Ngay cả A còn không..., huống chi những cái khác.",
          "formulas": [
            {
              "label": "negative_emphasis",
              "pattern": "连 + A + 也/都 + 不/没 + V"
            }
          ],
          "examples": [
            {
              "id": "c8674d77-7e1f-44f8-9e45-e0a03accdc05",
              "zh": "来北京快半年了，她连长城也没去过。",
              "pinyin": "lái Běijīng kuài bànnián le， tā lián Chángchéng yě méi qù guò。",
              "vi": "Đến Bắc Kinh gần nửa năm rồi, cô ấy ngay cả Vạn Lý Trường Thành cũng chưa từng đi.",
              "en": "",
              "highlight": [
                "连长城也没去过"
              ],
              "grammar_refs": [
                "grammar_q2_l25_02"
              ],
              "vocab_refs": [],
              "source_origin": "textbook",
              "check_needed": false
            },
            {
              "id": "1096379b-a91d-48aa-bc98-42ebe110f965",
              "zh": "你怎么连这么简单的问题也不会回答？",
              "pinyin": "nǐ zěnme lián zhème jiǎndān de wèntí yě bú huì huídá？",
              "vi": "Sao bạn ngay cả câu hỏi đơn giản thế này cũng không biết trả lời?",
              "en": "",
              "highlight": [
                "连这么简单的问题也不会回答"
              ],
              "grammar_refs": [
                "grammar_q2_l25_02"
              ],
              "vocab_refs": [],
              "source_origin": "textbook",
              "check_needed": false
            }
          ],
          "notes_vi": []
        },
        {
          "id": "fcfef93c-e55f-46bb-9a38-17ca999a1197",
          "type": "grammar_structure",
          "order": 3,
          "title": "Dùng trong câu khẳng định",
          "pattern": "连 + A + 都 + V / Adj",
          "meaning_vi": "Ngay cả A cũng..., nhấn mạnh mức độ cao hoặc phạm vi rộng.",
          "formulas": [
            {
              "label": "affirmative_emphasis",
              "pattern": "连 + A + 都 + V/Adj"
            }
          ],
          "examples": [
            {
              "id": "89cf2ddf-bb30-48d6-8d3d-9566092b6154",
              "zh": "连校长都参加了我们的联欢晚会。",
              "pinyin": "lián xiàozhǎng dōu cānjiā le wǒmen de liánhuān wǎnhuì。",
              "vi": "Ngay cả hiệu trưởng cũng tham gia buổi liên hoan của chúng tôi.",
              "en": "",
              "highlight": [
                "连校长都"
              ],
              "grammar_refs": [
                "grammar_q2_l25_02"
              ],
              "vocab_refs": [],
              "source_origin": "textbook",
              "check_needed": false
            },
            {
              "id": "519958ea-f183-4f7d-af9d-45c6e79d137c",
              "zh": "这么简单的问题连孩子都会回答。",
              "pinyin": "zhème jiǎndān de wèntí lián hái zi dū huì huídá。",
              "vi": "Câu hỏi đơn giản thế này ngay cả trẻ con cũng biết trả lời.",
              "en": "",
              "highlight": [
                "连孩子都会回答"
              ],
              "grammar_refs": [
                "grammar_q2_l25_02"
              ],
              "vocab_refs": [],
              "source_origin": "textbook",
              "check_needed": false
            }
          ],
          "notes_vi": [
            "Trong câu khẳng định, 连……都…… thường tự nhiên và ổn định hơn 连……也……."
          ]
        }
      ],
      "legacy_ids": [
        "grammar_q2_l25_02"
      ]
    },
