    {
      "id": "grammar_q2_l25_01",
      "type": "grammar_point",
      "order": 1,
      "title": "反问句",
      "title_vi": "Câu hỏi tu từ",
      "level": "HSK3+",
      "tags": [
        "语法"
      ],
      "source_origin": "textbook/generated_mixed",
      "check_needed": false,
      "blocks": [
        {
          "id": "b7c5d870-2db8-4e2e-950f-f0e6e522ac16",
          "type": "grammar_overview",
          "order": 1,
          "title": "Bản chất",
          "content_vi": "Câu có hình thức câu hỏi nhưng mục đích không phải hỏi thông tin; dùng để nhấn mạnh khẳng định, phủ định, trách nhẹ hoặc phản bác.",
          "examples": [
            {
              "id": "5e614bf9-2578-4d49-87dc-107e6f3605d4",
              "zh": "你怎么能不去呢？",
              "pinyin": "nǐ zěnme néng bù qù ne？",
              "vi": "Sao bạn có thể không đi được chứ? → Bạn đương nhiên phải đi.",
              "en": "",
              "highlight": [
                "怎么能不去呢"
              ],
              "grammar_refs": [
                "grammar_q2_l25_01"
              ],
              "vocab_refs": [],
              "source_origin": "generated",
              "check_needed": false
            }
          ]
        },
        {
          "id": "a85d60ae-5a59-4bad-a730-4e11cd8fd4ed",
          "type": "grammar_structure",
          "order": 2,
          "title": "没 + V + 吗？",
          "pattern": "没 + 动词 / 词组 + 吗？",
          "meaning_vi": "Dùng để hỏi ngược, thường mang sắc thái “rõ vậy mà bạn không biết / không thấy sao?”",
          "formulas": [
            {
              "label": "rhetorical_negative_question",
              "pattern": "没 + V + 吗？"
            }
          ],
          "examples": [
            {
              "id": "7ccdc8f9-59f3-4c7b-bd28-247acb68c535",
              "zh": "这件事你没听说过吗？",
              "pinyin": "zhè jiàn shì nǐ méi tīng shuō guò ma？",
              "vi": "Việc này bạn chưa từng nghe nói sao? → Bạn đáng lẽ phải nghe nói rồi.",
              "en": "",
              "highlight": [
                "没听说过吗"
              ],
              "grammar_refs": [
                "grammar_q2_l25_01"
              ],
              "vocab_refs": [],
              "source_origin": "textbook",
              "check_needed": false
            },
            {
              "id": "d84397d0-7b22-492a-a594-cb58d4dd46e0",
              "zh": "你没看见吗？他就在这儿。",
              "pinyin": "nǐ méi kàn jiàn ma？ tā jiù zài zhèr。",
              "vi": "Bạn không nhìn thấy sao? Anh ấy ở ngay đây mà.",
              "en": "",
              "highlight": [
                "没看见吗"
              ],
              "grammar_refs": [
                "grammar_q2_l25_01"
              ],
              "vocab_refs": [],
              "source_origin": "textbook",
              "check_needed": false
            }
          ],
          "notes_vi": [
            "Thường có sắc thái trách nhẹ, ngạc nhiên hoặc nhấn mạnh điều người nói cho là hiển nhiên."
          ]
        },
        {
          "id": "ca8c13db-9de3-46b8-a156-5be7570386a5",
          "type": "grammar_structure",
          "order": 3,
          "title": "Dùng đại từ nghi vấn để hỏi tu từ",
          "pattern": "怎么 / 谁 / 哪儿 + ...？",
          "meaning_vi": "Đại từ nghi vấn không hỏi thật, mà dùng để phản bác hoặc nhấn mạnh thái độ.",
          "formulas": [
            {
              "label": "rhetorical_pronoun",
              "pattern": "疑问代词 + ...？"
            }
          ],
          "examples": [
            {
              "id": "3c9a4bcc-7b95-4fbf-a27e-833a24841a8b",
              "zh": "你不告诉我，我怎么知道呢？",
              "pinyin": "nǐ bù gàosu wǒ， wǒ zěnme zhīdao ne？",
              "vi": "Bạn không nói cho tôi, làm sao tôi biết được? → Tôi không thể biết.",
              "en": "",
              "highlight": [
                "怎么知道呢"
              ],
              "grammar_refs": [
                "grammar_q2_l25_01"
              ],
              "vocab_refs": [],
              "source_origin": "textbook",
              "check_needed": false
            },
            {
              "id": "dd839fde-a24a-4a33-bc3a-4e0db7c01197",
              "zh": "谁说我不去？",
              "pinyin": "shuí shuō wǒ bù qù？",
              "vi": "Ai nói tôi không đi? → Tôi đương nhiên đi.",
              "en": "",
              "highlight": [
                "谁说"
              ],
              "grammar_refs": [
                "grammar_q2_l25_01"
              ],
              "vocab_refs": [],
              "source_origin": "textbook",
              "check_needed": false
            },
            {
              "id": "6d81a490-7d47-451c-b5d2-ffe940b59486",
              "zh": "他哪儿去过美国？",
              "pinyin": "tā nǎr qù guò měi guó？",
              "vi": "Anh ấy đi Mỹ bao giờ chứ? → Anh ấy chưa từng đi Mỹ.",
              "en": "",
              "highlight": [
                "哪儿"
              ],
              "grammar_refs": [
                "grammar_q2_l25_01"
              ],
              "vocab_refs": [],
              "source_origin": "textbook",
              "check_needed": false
            }
          ],
          "notes_vi": []
        }
      ],
      "legacy_ids": [
        "grammar_q2_l25_01"
      ]
    },
    {
