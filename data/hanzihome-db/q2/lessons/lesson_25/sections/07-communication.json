{
  "id": "4b3f514b-98a2-4e74-84c5-c83ff12ee313",
  "type": "communication",
  "order": 7,
  "title": "交际会话",
  "title_vi": "Hội thoại giao tiếp",
  "source_origin": "textbook",
  "check_needed": false,
  "items": [
    {
      "id": "d47481cc-fd2a-4991-ac01-d4168b47f7e0",
      "type": "communication_dialogue",
      "order": 1,
      "title": "敬酒",
      "title_vi": "Mời rượu",
      "lines": [
        {
          "speaker": "A",
          "zh": "来，我敬您一杯。",
          "vi": "Nào, tôi xin kính anh/chị một ly."
        },
        {
          "speaker": "B",
          "zh": "谢谢！",
          "vi": "Cảm ơn!"
        },
        {
          "speaker": "A",
          "zh": "祝您健康快乐！干杯！",
          "vi": "Chúc anh/chị mạnh khỏe vui vẻ! Cạn ly!"
        },
        {
          "speaker": "B",
          "zh": "干杯！",
          "vi": "Cạn ly!"
        }
      ]
    },
    {
      "id": "f6a2ba94-9d60-4677-bb69-9eb1952cf3af",
      "type": "communication_dialogue",
      "order": 2,
      "title": "责备",
      "title_vi": "Trách móc / trách nhẹ",
      "lines": [
        {
          "speaker": "A",
          "zh": "你怎么能这样说话？",
          "vi": "Sao bạn có thể nói như vậy?"
        },
        {
          "speaker": "B",
          "zh": "对不起，我说错了。",
          "vi": "Xin lỗi, tôi nói sai rồi."
        }
      ]
    },
    {
      "id": "a757f656-6504-495f-a058-770e53f9691f",
      "type": "communication_dialogue",
      "order": 3,
      "title": "责备",
      "title_vi": "Trách móc / trách nhẹ",
      "lines": [
        {
          "speaker": "A",
          "zh": "这件事儿你为什么不告诉我？我们不是好朋友吗？",
          "vi": "Chuyện này sao bạn không nói với tôi? Chúng ta không phải bạn tốt sao?"
        },
        {
          "speaker": "B",
          "zh": "我不想让你知道。",
          "vi": "Tôi không muốn để bạn biết."
        },
        {
          "speaker": "A",
          "zh": "你不相信我吗？",
          "vi": "Bạn không tin tôi sao?"
        },
        {
          "speaker": "B",
          "zh": "不是。",
          "vi": "Không phải vậy."
        }
      ]
    }
  ]
}
