    {
      "id": "grammar_q2_l01_01",
      "type": "grammar_point",
      "order": 1,
      "title": "语气助词“了”（1）",
      "title_vi": "Trợ từ ngữ khí 了",
      "level": "HSK2+",
      "tags": [
        "语法"
      ],
      "source_origin": "textbook/generated_mixed",
      "check_needed": false,
      "blocks": [
        {
          "id": "b7c5d870-2db8-4e2e-950f-f0e6e522ac16",
          "type": "grammar_overview",
          "order": 1,
          "title": "Bản chất",
          "content_vi": "了 đặt cuối câu thường báo một tình huống mới, một sự thay đổi, hoặc xác nhận rằng trạng thái hiện tại đã khác trước. Đây không phải “thì quá khứ” kiểu tiếng Anh; trọng tâm là “bây giờ đã thành như vậy rồi”.",
          "examples": [
            {
              "id": "c6fbeb40-156e-450c-a390-d58626cae49e",
              "zh": "田芳去哪儿了？",
              "vi": "Điền Phương đi đâu rồi?",
              "source_ref": "9faf6980-effe-42f1-a01e-7f1740da2edb",
              "source_origin": "textbook",
              "check_needed": false
            },
            {
              "id": "d5b13929-16ec-4967-ac8a-868d80ec0b1e",
              "zh": "我回来了。",
              "vi": "Con về rồi.",
              "source_ref": "887014e5-f6b0-4777-9f95-85a69532ca36",
              "source_origin": "textbook",
              "check_needed": false
            }
          ],
          "check_needed": false
        },
        {
          "id": "b3534a40-3bab-464a-97dd-67889b8bcb7b",
          "type": "grammar_structure",
          "order": 2,
          "title": "Cấu trúc chính",
          "pattern": "句子 / 谓语 + 了",
          "meaning_vi": "Biểu thị sự việc đã thành hiện thực, tình huống đã thay đổi, hoặc người nói vừa cập nhật thông tin mới.",
          "examples": [
            {
              "id": "50b5e564-92c8-4900-b66a-00f5bfca9437",
              "zh": "她四点多就去同学家了。",
              "vi": "Hơn bốn giờ cô ấy đã đến nhà bạn học rồi.",
              "source_ref": "146f8fa1-ae74-468d-910e-19cab53e3cf3",
              "source_origin": "textbook",
              "check_needed": false
            },
            {
              "id": "32ce3ad6-8de3-45db-b360-0c00996f1eef",
              "zh": "电话又响了。",
              "vi": "Điện thoại lại reo rồi.",
              "source_ref": "e8680b0f-6dcc-4fc7-abbd-084aba5d3b87",
              "source_origin": "textbook",
              "check_needed": false
            }
          ],
          "check_needed": false
        },
        {
          "id": "0ea62f46-0157-49d6-aadc-75dbed1d507b",
          "type": "grammar_usage_notes",
          "order": 3,
          "title": "Dạng nghi vấn / phủ định",
          "notes_vi": [
            "Nghi vấn thường dùng: V + 了 + 没有？ hoặc V + 了 + 吗？",
            "Phủ định hành động đã xảy ra dùng 没 / 没有 + V, thường không thêm 了 sau động từ."
          ],
          "examples": [
            {
              "id": "65da2f6a-6a1a-4d3d-8cf6-cc56c3fb01a8",
              "zh": "报名了没有？",
              "vi": "Đăng ký chưa?",
              "source_ref": "e3695c3e-b28b-4953-b424-71dcf1fad1b2",
              "source_origin": "textbook",
              "check_needed": false
            },
            {
              "id": "aee201a5-655e-471c-b56c-819ca00b8eeb",
              "zh": "田芳还没有回来。",
              "vi": "Điền Phương vẫn chưa về.",
              "source_origin": "generated",
              "check_needed": false
            }
          ],
          "check_needed": false
        }
      ],
      "legacy_ids": [
        "grammar_q2_l01_01"
      ]
    },
    {
      "id": "grammar_q2_l01_02",
      "type": "grammar_point",
      "order": 2,
      "title": "“再”和“又”",
      "title_vi": "Phân biệt 再 và 又",
      "level": "HSK2+",
      "tags": [
        "词语用法"
      ],
      "source_origin": "textbook/generated_mixed",
      "check_needed": false,
      "blocks": [
        {
          "id": "470b1ca1-e0a1-449f-b55e-a8aa481a4dd4",
          "type": "grammar_overview",
          "order": 1,
          "title": "Bản chất",
          "content_vi": "再 và 又 đều có nghĩa “lại”, nhưng khác trục thời gian. 再 thường chỉ hành động sẽ lặp lại sau; 又 thường chỉ hành động đã lặp lại hoặc đã xảy ra thêm một lần nữa.",
          "examples": [
            {
              "id": "771ce2b4-8b49-4b48-be3a-e887eb2024df",
              "zh": "你过一会儿再打吧。",
              "vi": "Lát nữa cậu gọi lại nhé.",
              "source_ref": "9d76be1a-c606-44bb-a490-a9bd82982e3b",
              "source_origin": "textbook",
              "check_needed": false
            },
            {
              "id": "773f0eeb-9162-44a6-b2c7-d20f86c5bf5f",
              "zh": "张东又来电话了。",
              "vi": "Trương Đông lại gọi điện đến rồi.",
              "source_ref": "e8680b0f-6dcc-4fc7-abbd-084aba5d3b87",
              "source_origin": "textbook",
              "check_needed": false
            }
          ],
          "check_needed": false
        },
        {
          "id": "2366c7ed-c003-4f30-8320-9ae5ed41c89b",
          "type": "grammar_compare",
          "order": 2,
          "title": "So sánh nhanh",
          "items": [
            {
              "aspect": "Trục thời gian",
              "left": {
                "label": "再",
                "value": "Việc chưa xảy ra, sẽ lặp lại sau."
              },
              "right": {
                "label": "又",
                "value": "Việc đã xảy ra, lại xảy ra thêm lần nữa."
              }
            },
            {
              "aspect": "Ví dụ trong bài",
              "left": {
                "label": "再",
                "value": "你过一会儿再打吧。"
              },
              "right": {
                "label": "又",
                "value": "电话又响了。"
              }
            }
          ],
          "check_needed": false
        },
        {
          "id": "542fe1e6-4a42-40f9-91ed-5729e7da7d04",
          "type": "grammar_common_mistakes",
          "order": 3,
          "title": "Lỗi dễ sai",
          "items": [
            {
              "id": "bd185d4d-4edc-454d-840f-edf0bdaa6b46",
              "wrong": "昨天我再给他打电话了。",
              "correct": "昨天我又给他打电话了。",
              "explanation_vi": "昨天 là quá khứ, hành động đã lặp lại nên dùng 又."
            },
            {
              "id": "8aaf6c8a-bfe1-45ca-bdb7-979146629d02",
              "wrong": "明天我又给你打电话。",
              "correct": "明天我再给你打电话。",
              "explanation_vi": "明天 là tương lai, hành động sẽ lặp lại sau nên dùng 再."
            }
          ],
          "check_needed": false
        }
      ],
