{
  "id": "a6c0d522-99be-4f36-881c-b9b2c6beeb85",
  "type": "text",
  "order": 1,
  "title": "课文",
  "title_vi": "Bài khóa",
  "source_origin": "textbook",
  "check_needed": false,
  "blocks": [
    {
      "id": "e155d5ea-f89d-45f0-ab8d-094ce9e719f0",
      "type": "text_dialogue",
      "order": 1,
      "title": "田芳去哪儿了",
      "title_vi": "Điền Phương đi đâu rồi?",
      "source_origin": "textbook",
      "check_needed": false,
      "lines": [
        {
          "id": "f8046d8e-353e-4b63-a072-7498c8f1d9ff",
          "order": 1,
          "speaker": "张东",
          "zh": "喂，是田芳吗？",
          "vi": "Alo, Điền Phương đấy à?",
          "grammar_refs": [
            "f8ec59f3-898a-47b2-b536-44dfd8183393"
          ],
          "source_origin": "textbook",
          "check_needed": false
        },
        {
          "id": "30929615-34c8-4e5b-b0a2-5ad3358ad755",
          "order": 2,
          "speaker": "田芳妈",
          "zh": "田芳不在。是张东吧？",
          "vi": "Điền Phương không có nhà. Là Trương Đông phải không?",
          "source_origin": "textbook",
          "check_needed": false
        },
        {
          "id": "9faf6980-effe-42f1-a01e-7f1740da2edb",
          "order": 3,
          "speaker": "张东",
          "zh": "阿姨，您好！田芳去哪儿了？",
          "vi": "Cháu chào cô ạ! Điền Phương đi đâu rồi ạ?",
          "grammar_refs": [
            "f8ec59f3-898a-47b2-b536-44dfd8183393"
          ],
          "source_origin": "textbook",
          "check_needed": false
        },
        {
          "id": "146f8fa1-ae74-468d-910e-19cab53e3cf3",
          "order": 4,
          "speaker": "田芳妈",
          "zh": "她四点多就去同学家了。她的一个中学同学要出国，她去看看她。",
          "vi": "Nó hơn bốn giờ đã đến nhà bạn học rồi. Một bạn cấp hai của nó sắp ra nước ngoài, nó đến thăm bạn ấy.",
          "grammar_refs": [
            "f8ec59f3-898a-47b2-b536-44dfd8183393"
          ],
          "source_origin": "textbook",
          "check_needed": false
        },
        {
          "id": "44d4c32e-309d-4802-b7cf-e41ee8052535",
          "order": 5,
          "speaker": "张东",
          "zh": "她什么时候能回来？",
          "vi": "Khi nào bạn ấy có thể về ạ?",
          "source_origin": "textbook",
          "check_needed": false
        },
        {
          "id": "6f4b4423-8315-40e6-88fa-2fa2038271af",
          "order": 6,
          "speaker": "田芳妈",
          "zh": "她没说，你打她的手机吧。",
          "vi": "Nó không nói. Cháu gọi di động cho nó đi.",
          "source_origin": "textbook",
          "check_needed": false
        },
        {
          "id": "6de58c5b-164f-4b2f-8d7e-84f1c7c1a66c",
          "order": 7,
          "speaker": "张东",
          "zh": "我打了，可是她关机了。",
          "vi": "Cháu gọi rồi, nhưng bạn ấy tắt máy rồi ạ.",
          "grammar_refs": [
            "f8ec59f3-898a-47b2-b536-44dfd8183393"
          ],
          "source_origin": "textbook",
          "check_needed": false
        },
        {
          "id": "9d76be1a-c606-44bb-a490-a9bd82982e3b",
          "order": 8,
          "speaker": "田芳妈",
          "zh": "是吗？你过一会儿再打吧。",
          "vi": "Thế à? Lát nữa cháu gọi lại nhé.",
          "grammar_refs": [
            "57b14753-688a-41b6-9e0d-b61dbbf574d7"
          ],
          "source_origin": "textbook",
          "check_needed": false
        },
        {
          "id": "6e148072-17aa-4ebd-88a1-c59b2fc0ba17",
          "order": 9,
          "speaker": "张东",
          "zh": "阿姨，田芳回来了没有？",
          "vi": "Cô ơi, Điền Phương về chưa ạ?",
          "grammar_refs": [
            "f8ec59f3-898a-47b2-b536-44dfd8183393"
          ],
          "source_origin": "textbook",
          "check_needed": false
        },
        {
          "id": "a8845639-9fca-4398-853d-a08fb63482a8",
          "order": 10,
          "speaker": "田芳妈",
          "zh": "还没有呢。",
          "vi": "Vẫn chưa về đâu.",
          "source_origin": "textbook",
          "check_needed": false
        }
      ],
      "paragraphs": [],
      "comprehension_questions": []
    },
    {
      "id": "0156dd39-d5b4-41f5-866d-d336dd29bbc2",
      "type": "text_dialogue",
      "order": 2,
      "title": "他又来电话了",
      "title_vi": "Cậu ấy lại gọi điện đến rồi",
      "source_origin": "textbook",
      "check_needed": false,
      "lines": [
        {
          "id": "887014e5-f6b0-4777-9f95-85a69532ca36",
          "order": 1,
          "speaker": "田芳",
          "zh": "妈，我回来了。",
          "vi": "Mẹ, con về rồi.",
          "grammar_refs": [
            "f8ec59f3-898a-47b2-b536-44dfd8183393"
          ],
          "source_origin": "textbook",
          "check_needed": false
        },
        {
          "id": "65232ef9-30a1-4305-b8b7-12a8ac5aeb91",
          "order": 2,
          "speaker": "田芳妈",
          "zh": "饿了吧？快吃饭吧！啊，对了，张东给你打电话了没有？",
          "vi": "Đói rồi phải không? Mau ăn cơm đi! À đúng rồi, Trương Đông gọi điện cho con chưa?",
          "grammar_refs": [
            "f8ec59f3-898a-47b2-b536-44dfd8183393"
          ],
          "source_origin": "textbook",
          "check_needed": false
        },
        {
          "id": "2c1213ac-f81d-414f-8b55-5abe77fe83fc",
          "order": 3,
          "speaker": "田芳",
          "zh": "没有啊。",
          "vi": "Chưa ạ.",
          "source_origin": "textbook",
          "check_needed": false
        },
        {
          "id": "d797c234-0a16-42e3-bc45-29782e65cb1b",
          "order": 4,
          "speaker": "田芳妈",
          "zh": "他来电话找你，说打你的手机，你关机了。",
          "vi": "Cậu ấy gọi điện tìm con, nói là gọi di động cho con nhưng con tắt máy rồi.",
          "grammar_refs": [
            "f8ec59f3-898a-47b2-b536-44dfd8183393"
          ],
          "source_origin": "textbook",
          "check_needed": false
        },
        {
          "id": "c99f042b-fa9a-478c-aba1-5da333a677e1",
          "order": 5,
          "speaker": "田芳",
          "zh": "啊！对了，我忘开机了。",
          "vi": "À! Đúng rồi, con quên mở máy.",
          "grammar_refs": [
            "f8ec59f3-898a-47b2-b536-44dfd8183393"
          ],
          "source_origin": "textbook",
          "check_needed": false
        },
        {
          "id": "e8680b0f-6dcc-4fc7-abbd-084aba5d3b87",
          "order": 6,
          "speaker": "田芳妈",
          "zh": "快！电话又响了，你去接吧。",
          "vi": "Nhanh lên! Điện thoại lại reo rồi, con đi nghe đi.",
          "grammar_refs": [
            "f8ec59f3-898a-47b2-b536-44dfd8183393",
            "57b14753-688a-41b6-9e0d-b61dbbf574d7"
          ],
          "source_origin": "textbook",
          "check_needed": false
        },
        {
          "id": "cc8da348-3e89-4f64-a680-de239f505497",
          "order": 7,
          "speaker": "田芳",
          "zh": "喂，张东，下午你给我打电话了吧？",
          "vi": "Alo, Trương Đông, chiều nay cậu gọi điện cho mình phải không?",
          "grammar_refs": [
            "f8ec59f3-898a-47b2-b536-44dfd8183393"
          ],
          "source_origin": "textbook",
          "check_needed": false
        },
        {
          "id": "2adb7cf6-26c1-4029-809e-67342fb0227f",
          "order": 8,
          "speaker": "张东",
          "zh": "打了，你怎么关机了？",
          "vi": "Gọi rồi. Sao cậu lại tắt máy?",
          "grammar_refs": [
            "f8ec59f3-898a-47b2-b536-44dfd8183393"
          ],
          "source_origin": "textbook",
          "check_needed": false
        },
        {
          "id": "f42aa089-875d-48c4-9213-a083ec251fe7",
          "order": 9,
          "speaker": "田芳",
          "zh": "对不起，我忘开机了。下午你做什么了？",
          "vi": "Xin lỗi, mình quên mở máy. Chiều nay cậu làm gì vậy?",
          "grammar_refs": [
            "f8ec59f3-898a-47b2-b536-44dfd8183393"
          ],
          "source_origin": "textbook",
          "check_needed": false
        },
        {
          "id": "f7419a05-c714-4cff-ae26-210852d56303",
          "order": 10,
          "speaker": "张东",
          "zh": "我去踢足球了。今天我们跟留学生代表队比赛了。",
          "vi": "Mình đi đá bóng. Hôm nay bọn mình thi đấu với đội đại diện lưu học sinh.",
          "grammar_refs": [
            "f8ec59f3-898a-47b2-b536-44dfd8183393"
          ],
          "source_origin": "textbook",
          "check_needed": false
        },
        {
          "id": "22e52ff8-58e5-4bfd-8912-95faed7e26d1",
          "order": 11,
          "speaker": "田芳",
          "zh": "你们队又输了吧？",
          "vi": "Đội các cậu lại thua rồi hả?",
          "grammar_refs": [
            "57b14753-688a-41b6-9e0d-b61dbbf574d7"
          ],
          "source_origin": "textbook",
          "check_needed": false
        },
        {
          "id": "7ae9e54c-f536-4783-b05d-0d7e8ac4fb77",
          "order": 12,
          "speaker": "张东",
          "zh": "没有。这次我们赢了。",
          "vi": "Không. Lần này bọn mình thắng rồi.",
          "grammar_refs": [
            "f8ec59f3-898a-47b2-b536-44dfd8183393"
          ],
          "source_origin": "textbook",
          "check_needed": false
        },
        {
          "id": "491f58c7-7ead-4d8c-876d-7e3113dcff35",
          "order": 13,
          "speaker": "田芳",
          "zh": "几比几？",
          "vi": "Mấy - mấy?",
          "source_origin": "textbook",
          "check_needed": false
        },
        {
          "id": "b4e15ca3-0527-433b-9b2f-a6027ebfe8e3",
          "order": 14,
          "speaker": "张东",
          "zh": "二比一。",
          "vi": "Hai - một.",
          "source_origin": "textbook",
          "check_needed": false
        },
        {
          "id": "ded8d12b-4a00-4a64-b5b2-66cab3f2d1c6",
          "order": 15,
          "speaker": "田芳",
          "zh": "祝贺你们！哎，你有什么事儿吗？",
          "vi": "Chúc mừng các cậu! À, cậu có việc gì không?",
          "source_origin": "textbook",
          "check_needed": false
        },
        {
          "id": "e3695c3e-b28b-4953-b424-71dcf1fad1b2",
          "order": 16,
          "speaker": "张东",
          "zh": "我想问问你，你不是要上托福班吗？报名了没有？",
          "vi": "Mình muốn hỏi cậu, chẳng phải cậu định học lớp TOEFL sao? Đăng ký chưa?",
          "grammar_refs": [
            "f8ec59f3-898a-47b2-b536-44dfd8183393"
          ],
          "source_origin": "textbook",
          "check_needed": false
        },
        {
          "id": "94807735-96c4-4f7b-a7a3-0b2830d4e7c1",
          "order": 17,
          "speaker": "田芳",
          "zh": "已经报了。你是不是也想考托福？",
          "vi": "Mình đăng ký rồi. Có phải cậu cũng muốn thi TOEFL không?",
          "grammar_refs": [
            "f8ec59f3-898a-47b2-b536-44dfd8183393"
          ],
          "source_origin": "textbook",
          "check_needed": false
        },
        {
          "id": "d562e0f1-cf06-4951-bc59-0df0b5f6b59d",
          "order": 18,
          "speaker": "张东",
          "zh": "是。我想明天去报名，你陪我一起去，好吗？",
          "vi": "Đúng. Mình muốn ngày mai đi đăng ký, cậu đi cùng mình nhé?",
          "source_origin": "textbook",
          "check_needed": false
        },
        {
          "id": "f38d479e-fda5-4afe-94ca-7829cdb7059f",
          "order": 19,
          "speaker": "田芳",
          "zh": "好的。",
          "vi": "Được.",
          "source_origin": "textbook",
          "check_needed": false
        }
      ],
      "paragraphs": [],
      "comprehension_questions": []
    }
  ]
}
