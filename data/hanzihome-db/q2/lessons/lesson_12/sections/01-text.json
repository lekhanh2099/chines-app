  "blocks": [
    {
      "id": "e155d5ea-f89d-45f0-ab8d-094ce9e719f0",
      "type": "text_dialogue",
      "order": 1,
      "title": "我的护照你找到了没有",
      "title_vi": "Hộ chiếu của tôi bạn tìm thấy chưa?",
      "source_origin": "textbook",
      "check_needed": false,
      "lines": [
        {
          "id": "f8046d8e-353e-4b63-a072-7498c8f1d9ff",
          "order": 1,
          "speaker": "关建平",
          "zh": "我的护照你找到了没有？",
          "pinyin": "Wǒ de hùzhào nǐ zhǎodào le méiyǒu?",
          "vi": "Hộ chiếu của anh, em tìm thấy chưa?",
          "audio_key": "",
          "vocab_refs": [
            "68c05a12-9d8e-45d9-a413-786bcf2f780a"
          ],
          "grammar_refs": [
            "f8ec59f3-898a-47b2-b536-44dfd8183393",
            "57b14753-688a-41b6-9e0d-b61dbbf574d7"
          ],
          "source_origin": "textbook",
          "check_needed": false
        },
        {
          "id": "30929615-34c8-4e5b-b0a2-5ad3358ad755",
          "order": 2,
          "speaker": "夏雨",
          "zh": "没有，我找了半天也没找着。你是不是放在办公室了？",
          "pinyin": "Méiyǒu, wǒ zhǎo le bàntiān yě méi zhǎozháo. Nǐ shì bu shì fàng zài bàngōngshì le?",
          "vi": "Chưa, em tìm cả buổi cũng không tìm thấy. Có phải anh để ở văn phòng không?",
          "audio_key": "",
          "vocab_refs": [
            "54613016-834a-4fc3-9912-2357a6d27058",
            "vocab-12-zhao-result",
            "d9991c79-3454-4247-bf18-f14f43b4a24a"
          ],
          "grammar_refs": [
            "57b14753-688a-41b6-9e0d-b61dbbf574d7"
          ],
          "source_origin": "textbook",
          "check_needed": false
        },
        {
          "id": "9faf6980-effe-42f1-a01e-7f1740da2edb",
          "order": 3,
          "speaker": "关建平",
          "zh": "护照我从来不在办公室里放。",
          "pinyin": "Hùzhào wǒ cónglái bú zài bàngōngshì lǐ fàng.",
          "vi": "Hộ chiếu thì anh trước giờ không bao giờ để ở văn phòng.",
          "audio_key": "",
          "vocab_refs": [
            "68c05a12-9d8e-45d9-a413-786bcf2f780a",
            "97948db8-350f-468f-a584-08ac6ee8ea70",
            "d9991c79-3454-4247-bf18-f14f43b4a24a"
          ],
          "grammar_refs": [
            "f8ec59f3-898a-47b2-b536-44dfd8183393",
            "57b14753-688a-41b6-9e0d-b61dbbf574d7"
          ],
          "source_origin": "textbook",
          "check_needed": false
        },
        {
          "id": "146f8fa1-ae74-468d-910e-19cab53e3cf3",
          "order": 4,
          "speaker": "夏雨",
          "zh": "昨天你办完签证放在什么地方了？",
          "pinyin": "Zuótiān nǐ bàn wán qiānzhèng fàng zài shénme dìfang le?",
          "vi": "Hôm qua sau khi làm xong visa, anh để ở đâu?",
          "audio_key": "",
          "vocab_refs": [
            "8c18cf3c-e9dc-42e1-8faf-eb26799cabab",
            "d9991c79-3454-4247-bf18-f14f43b4a24a"
          ],
          "grammar_refs": [
            "57b14753-688a-41b6-9e0d-b61dbbf574d7"
          ],
          "source_origin": "textbook",
          "check_needed": false
        },
        {
          "id": "44d4c32e-309d-4802-b7cf-e41ee8052535",
          "order": 5,
          "speaker": "关建平",
          "zh": "放在我的手提包儿里了。",
          "pinyin": "Fàng zài wǒ de shǒutíbāor lǐ le.",
          "vi": "Anh để trong túi xách tay của anh rồi.",
          "audio_key": "",
          "vocab_refs": [
            "1fbd69b7-603a-44ea-8d57-10cd4def9ced",
            "d9991c79-3454-4247-bf18-f14f43b4a24a"
          ],
          "grammar_refs": [
            "57b14753-688a-41b6-9e0d-b61dbbf574d7"
          ],
          "source_origin": "textbook",
          "check_needed": false
        },
        {
          "id": "6f4b4423-8315-40e6-88fa-2fa2038271af",
          "order": 6,
          "speaker": "夏雨",
          "zh": "你的包儿呢？",
          "pinyin": "Nǐ de bāor ne?",
          "vi": "Túi của anh đâu?",
          "audio_key": "",
          "vocab_refs": [
            "vocab-12-bao-er"
          ],
          "grammar_refs": [],
          "source_origin": "textbook",
          "check_needed": false
        },
        {
          "id": "6de58c5b-164f-4b2f-8d7e-84f1c7c1a66c",
          "order": 7,
          "speaker": "关建平",
          "zh": "我一回到家不是就交给你了吗？",
          "pinyin": "Wǒ yì huí dào jiā bú shì jiù jiāo gěi nǐ le ma?",
          "vi": "Chẳng phải vừa về đến nhà là anh đưa cho em rồi sao?",
          "audio_key": "",
          "vocab_refs": [
            "vocab-12-jiao-hand-in"
          ],
          "grammar_refs": [],
          "source_origin": "textbook",
          "check_needed": false
        },
        {
          "id": "9d76be1a-c606-44bb-a490-a9bd82982e3b",
          "order": 8,
          "speaker": "夏雨",
          "zh": "对。我再好好儿找找。啊，找到了！",
          "pinyin": "Duì. Wǒ zài hǎohāor zhǎozhao. A, zhǎodào le!",
          "vi": "Đúng rồi. Để em tìm kỹ lại xem. À, tìm thấy rồi!",
          "audio_key": "",
          "vocab_refs": [
            "e93080a4-2857-4582-a75a-94276764a235"
          ],
          "grammar_refs": [
            "57b14753-688a-41b6-9e0d-b61dbbf574d7"
          ],
          "source_origin": "textbook",
          "check_needed": false
        },
        {
          "id": "6e148072-17aa-4ebd-88a1-c59b2fc0ba17",
          "order": 9,
          "speaker": "关建平",
          "zh": "是在包儿里找到的吗？",
          "pinyin": "Shì zài bāor lǐ zhǎodào de ma?",
          "vi": "Có phải tìm thấy trong túi không?",
          "audio_key": "",
          "vocab_refs": [
            "vocab-12-bao-er"
          ],
          "grammar_refs": [
            "57b14753-688a-41b6-9e0d-b61dbbf574d7"
          ],
          "source_origin": "textbook",
          "check_needed": false
        },
        {
          "id": "a8845639-9fca-4398-853d-a08fb63482a8",
          "order": 10,
          "speaker": "夏雨",
          "zh": "不是，在你的大衣口袋里找到的。",
          "pinyin": "Bú shì, zài nǐ de dàyī kǒudài lǐ zhǎodào de.",
          "vi": "Không phải, tìm thấy trong túi áo khoác của anh.",
          "audio_key": "",
          "vocab_refs": [
            "3dc505f1-bc0e-4a96-b448-17fed89fdc60",
            "188412d4-4c23-4d60-b7b2-21f3490199e7"
          ],
          "grammar_refs": [
            "57b14753-688a-41b6-9e0d-b61dbbf574d7"
          ],
          "source_origin": "textbook",
          "check_needed": false
        },
        {
          "id": "eb3a72ec-54fc-469d-929b-b614c65e00f1",
          "order": 11,
          "speaker": "关建平",
          "zh": "啊，我忘了。是我昨天晚上放到口袋里的。",
          "pinyin": "A, wǒ wàng le. Shì wǒ zuótiān wǎnshang fàng dào kǒudài lǐ de.",
          "vi": "À, anh quên mất. Là tối hôm qua anh bỏ vào túi áo.",
          "audio_key": "",
          "vocab_refs": [
            "188412d4-4c23-4d60-b7b2-21f3490199e7",
            "d9991c79-3454-4247-bf18-f14f43b4a24a"
          ],
          "grammar_refs": [
            "57b14753-688a-41b6-9e0d-b61dbbf574d7"
          ],
          "source_origin": "textbook",
          "check_needed": false
        },
        {
          "id": "5d22fae9-a022-41b5-a551-b9b68c51b516",
          "order": 12,
          "speaker": "夏雨",
          "zh": "你最近总是丢三落四的。",
          "pinyin": "Nǐ zuìjìn zǒngshì diūsān-làsì de.",
          "vi": "Dạo này anh lúc nào cũng hay quên trước quên sau.",
          "audio_key": "",
          "vocab_refs": [
            "358d5baa-5ba1-4cb5-984a-44770a1724d6"
          ],
          "grammar_refs": [],
          "source_origin": "textbook",
          "check_needed": false
        }
      ],
      "paragraphs": [],
      "comprehension_questions": []
    },
    {
      "id": "0156dd39-d5b4-41f5-866d-d336dd29bbc2",
      "type": "text_dialogue",
      "order": 2,
      "title": "我是球迷",
      "title_vi": "Tôi là fan bóng đá",
      "source_origin": "textbook",
      "check_needed": false,
      "lines": [
        {
          "id": "887014e5-f6b0-4777-9f95-85a69532ca36",
          "order": 1,
          "speaker": "A",
          "zh": "你喜欢足球吗？",
          "pinyin": "Nǐ xǐhuan zúqiú ma?",
          "vi": "Bạn thích bóng đá không?",
          "audio_key": "",
          "vocab_refs": [],
          "grammar_refs": [],
          "source_origin": "textbook",
          "check_needed": false
        },
        {
          "id": "65232ef9-30a1-4305-b8b7-12a8ac5aeb91",
          "order": 2,
          "speaker": "B",
          "zh": "一般。你呢？",
          "pinyin": "Yìbān. Nǐ ne?",
          "vi": "Bình thường thôi. Còn bạn?",
          "audio_key": "",
          "vocab_refs": [],
          "grammar_refs": [],
          "source_origin": "textbook",
          "check_needed": false
        },
        {
          "id": "2c1213ac-f81d-414f-8b55-5abe77fe83fc",
          "order": 3,
          "speaker": "A",
          "zh": "你还不知道啊，我可是个球迷。",
          "pinyin": "Nǐ hái bù zhīdào a, wǒ kě shì ge qiúmí.",
          "vi": "Bạn còn chưa biết à, tôi là một fan bóng đá chính hiệu đấy.",
          "audio_key": "",
          "vocab_refs": [
            "26999e7c-e64c-4401-9d09-bcfd351db7b5",
            "vocab-12-qiumi"
          ],
          "grammar_refs": [],
          "source_origin": "textbook",
          "check_needed": false
        },
        {
          "id": "d797c234-0a16-42e3-bc45-29782e65cb1b",
          "order": 4,
          "speaker": "B",
          "zh": "迷到什么程度？",
          "pinyin": "Mí dào shénme chéngdù?",
          "vi": "Mê đến mức nào?",
          "audio_key": "",
          "vocab_refs": [
            "91fa9f81-e5ef-4c4a-b29c-c4b6daa02196"
          ],
          "grammar_refs": [],
          "source_origin": "textbook",
          "check_needed": false
        },
        {
          "id": "c99f042b-fa9a-478c-aba1-5da333a677e1",
          "order": 5,
          "speaker": "A",
          "zh": "为了看球，饭我可以不吃，觉我可以不睡，工作我可以不干。",
          "pinyin": "Wèile kàn qiú, fàn wǒ kěyǐ bù chī, jiào wǒ kěyǐ bú shuì, gōngzuò wǒ kěyǐ bú gàn.",
          "vi": "Để xem bóng đá, cơm tôi có thể không ăn, ngủ tôi có thể không ngủ, việc tôi cũng có thể không làm.",
          "audio_key": "",
          "vocab_refs": [
            "d2a7ce6a-a83e-42aa-8d6e-9f24d1253da9"
          ],
          "grammar_refs": [
            "f8ec59f3-898a-47b2-b536-44dfd8183393"
          ],
          "source_origin": "textbook",
          "check_needed": false
        },
        {
          "id": "e8680b0f-6dcc-4fc7-abbd-084aba5d3b87",
          "order": 6,
          "speaker": "B",
          "zh": "我看球迷一个个都有点儿不正常。",
          "pinyin": "Wǒ kàn qiúmí yí ge ge dōu yǒudiǎnr bú zhèngcháng.",
          "vi": "Tôi thấy fan bóng đá ai nấy đều hơi không bình thường.",
          "audio_key": "",
          "vocab_refs": [
            "vocab-12-qiumi",
            "20f66e08-4820-43f5-a18a-50f61591e7cd"
          ],
          "grammar_refs": [
            "f8ec59f3-898a-47b2-b536-44dfd8183393"
          ],
          "source_origin": "textbook",
          "check_needed": false
        },
        {
          "id": "cc8da348-3e89-4f64-a680-de239f505497",
          "order": 7,
          "speaker": "A",
          "zh": "我也承认，有时候达到了发狂的程度。欧锦赛（欧洲足球锦标赛）期间，我像生了病一样。白天想睡觉，一到晚上就特别有精神。",
          "pinyin": "Wǒ yě chéngrèn, yǒu shíhou dádào le fākuáng de chéngdù. Ōu Jǐnsài (Ōuzhōu Zúqiú Jǐnbiāosài) qījiān, wǒ xiàng shēng le bìng yíyàng. Báitiān xiǎng shuìjiào, yí dào wǎnshang jiù tèbié yǒu jīngshen.",
          "vi": "Tôi cũng thừa nhận, có lúc mê đến mức phát cuồng. Trong thời gian Euro / Giải vô địch bóng đá châu Âu, tôi giống như bị bệnh vậy. Ban ngày thì buồn ngủ, cứ đến tối là đặc biệt tỉnh táo/có tinh thần.",
          "audio_key": "",
          "vocab_refs": [
            "fefd5441-7b6c-47e3-b823-9e149b947bf7",
            "863bbf3f-83e7-4021-b98e-be632043d94c",
            "91fa9f81-e5ef-4c4a-b29c-c4b6daa02196",
            "7eccd5e8-dac0-4f36-be2e-abcc0a2bdfcd",
            "1354b1a3-93cc-4505-8d7f-c5550a1d6ae9",
            "22e66ee9-565e-4670-b2ac-4d5a9b500b38",
            "b14487b6-5579-4f1c-9ad7-16fd40991577",
            "0da97406-c3ac-4fcb-a51c-398a59c3fbae",
            "7a89dc80-d79d-4c2f-988c-d0f54e240d19",
            "proper-lesson12-ouzhou"
          ],
          "grammar_refs": [],
          "source_origin": "textbook",
          "check_needed": false
        },
        {
          "id": "2adb7cf6-26c1-4029-809e-67342fb0227f",
          "order": 8,
          "speaker": "B",
          "zh": "你白天不工作吗？",
          "pinyin": "Nǐ báitiān bù gōngzuò ma?",
          "vi": "Ban ngày bạn không làm việc à?",
          "audio_key": "",
          "vocab_refs": [
            "0da97406-c3ac-4fcb-a51c-398a59c3fbae"
          ],
          "grammar_refs": [],
          "source_origin": "textbook",
          "check_needed": false
        },
        {
          "id": "f42aa089-875d-48c4-9213-a083ec251fe7",
          "order": 9,
          "speaker": "A",
          "zh": "这个商店是我自己开的，我在门上贴了一张通知——“暂停营业”。",
          "pinyin": "Zhège shāngdiàn shì wǒ zìjǐ kāi de, wǒ zài mén shang tiē le yì zhāng tōngzhī — “zàntíng yíngyè”.",
          "vi": "Cửa hàng này là tôi tự mở, tôi dán một tờ thông báo trên cửa: “Tạm ngừng kinh doanh”.",
          "audio_key": "",
          "vocab_refs": [
            "ba7ff0f9-b633-4516-ab3d-22b96046a1cf",
            "1190511f-5970-4304-8f84-d7201b287aeb",
            "d42d3d90-443d-45da-bed7-987b50034e92",
            "cfb712c9-c4ca-4314-b6b2-696b40ace25e"
          ],
          "grammar_refs": [],
          "source_origin": "textbook",
          "check_needed": false
        },
        {
          "id": "f7419a05-c714-4cff-ae26-210852d56303",
          "order": 10,
          "speaker": "B",
          "zh": "你还真是个球迷。",
          "pinyin": "Nǐ hái zhēn shì ge qiúmí.",
          "vi": "Bạn đúng thật là fan bóng đá đấy.",
          "audio_key": "",
          "vocab_refs": [
            "vocab-12-qiumi"
          ],
          "grammar_refs": [],
          "source_origin": "textbook",
          "check_needed": false
        },
        {
          "id": "22e52ff8-58e5-4bfd-8912-95faed7e26d1",
          "order": 11,
          "speaker": "A",
          "zh": "我还不算最迷的。我有一个朋友，在一家外国公司工作，为了能去现场亲眼看世界杯，他向老板请假，老板不准，他就辞职不干了。",
          "pinyin": "Wǒ hái bú suàn zuì mí de. Wǒ yǒu yí ge péngyou, zài yì jiā wàiguó gōngsī gōngzuò, wèile néng qù xiànchǎng qīnyǎn kàn Shìjiè Bēi, tā xiàng lǎobǎn qǐngjià, lǎobǎn bù zhǔn, tā jiù cízhí bú gàn le.",
          "vi": "Tôi vẫn chưa phải là người mê nhất đâu. Tôi có một người bạn làm ở một công ty nước ngoài. Để có thể đến tận nơi tận mắt xem World Cup, anh ấy xin nghỉ với sếp; sếp không cho, thế là anh ấy nghỉ việc luôn.",
          "audio_key": "",
          "vocab_refs": [
            "092a8c16-3739-4685-a4c0-39365071bd48",
            "d2a7ce6a-a83e-42aa-8d6e-9f24d1253da9",
            "d5b362a7-c8f6-4f25-b2b5-0f1749c8afbb",
            "67d5f931-79d4-4182-8e48-3c718cfcb016",
            "proper-lesson12-shijiebei",
            "05e1ac20-79be-406d-9c90-4b0c847182bc",
            "6059829f-ae21-43cf-ac0c-05e19639ec43"
          ],
          "grammar_refs": [],
          "source_origin": "textbook",
          "check_needed": false
        },
        {
          "id": "7ae9e54c-f536-4783-b05d-0d7e8ac4fb77",
          "order": 12,
          "speaker": "B",
          "zh": "最后去成了吗？",
          "pinyin": "Zuìhòu qù chéng le ma?",
          "vi": "Cuối cùng có đi được không?",
          "audio_key": "",
          "vocab_refs": [
            "d36b89c4-d29e-486a-b7d9-aeb589592aa6",
            "71f9308f-7b38-435e-bfa8-c7c974599035"
          ],
          "grammar_refs": [
            "57b14753-688a-41b6-9e0d-b61dbbf574d7"
          ],
          "source_origin": "textbook",
          "check_needed": false
        },
        {
          "id": "491f58c7-7ead-4d8c-876d-7e3113dcff35",
          "order": 13,
          "speaker": "A",
          "zh": "去成了。我真佩服他。能去现场看世界杯，太棒了！",
          "pinyin": "Qù chéng le. Wǒ zhēn pèifu tā. Néng qù xiànchǎng kàn Shìjiè Bēi, tài bàng le!",
          "vi": "Đi được rồi. Tôi thật sự khâm phục anh ấy. Có thể đến tận nơi xem World Cup, quá tuyệt!",
          "audio_key": "",
