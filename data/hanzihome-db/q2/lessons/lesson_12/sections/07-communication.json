{
  "id": "4b3f514b-98a2-4e74-84c5-c83ff12ee313",
  "type": "communication",
  "order": 7,
  "title": "交际会话",
  "title_vi": "Hội thoại giao tiếp",
  "source_origin": "textbook",
  "check_needed": false,
  "items": [
    {
      "id": "d47481cc-fd2a-4991-ac01-d4168b47f7e0",
      "type": "communication_dialogue",
      "variant": "role_play",
      "order": 1,
      "title": "换零钱",
      "title_vi": "Đổi tiền lẻ",
      "instruction": {
        "zh": "练习交际会话。",
        "vi": "Luyện hội thoại giao tiếp theo tình huống.",
        "pinyin": "Liànxí jiāojì huìhuà."
      },
      "lines": [
        {
          "id": "a09a4f76-822c-46a1-86dd-2748df1c8d9f",
          "order": 1,
          "speaker": "张东",
          "zh": "麻烦您给我换成零钱。",
          "pinyin": "Máfan nín gěi wǒ huàn chéng língqián.",
          "vi": "Phiền anh/chị đổi giúp tôi thành tiền lẻ.",
          "audio_key": "",
          "vocab_refs": [],
          "grammar_refs": [],
          "source_origin": "textbook",
          "check_needed": false
        },
        {
          "id": "3200b4b3-e806-4b8b-930c-b74f89fbd3a9",
          "order": 2,
          "speaker": "店员",
          "zh": "换成多少一张的？",
          "pinyin": "Huàn chéng duōshao yì zhāng de?",
          "vi": "Đổi thành tờ mệnh giá bao nhiêu?",
          "audio_key": "",
          "vocab_refs": [],
          "grammar_refs": [],
          "source_origin": "textbook",
          "check_needed": false
        },
        {
          "id": "91cb8846-db9b-4914-83a3-884c294740ba",
          "order": 3,
          "speaker": "张东",
          "zh": "换成十块一张的就行。",
          "pinyin": "Huàn chéng shí kuài yì zhāng de jiù xíng.",
          "vi": "Đổi thành tờ mười đồng là được.",
          "audio_key": "",
          "vocab_refs": [],
          "grammar_refs": [],
          "source_origin": "textbook",
          "check_needed": false
        },
        {
          "id": "2664fbe6-eb6b-4b3e-9823-10550a9fab28",
          "order": 4,
          "speaker": "店员",
          "zh": "给您。请数数。",
          "pinyin": "Gěi nín. Qǐng shǔshu.",
          "vi": "Của anh/chị đây. Xin đếm lại.",
          "audio_key": "",
          "vocab_refs": [],
          "grammar_refs": [],
          "source_origin": "textbook",
          "check_needed": false
        },
        {
          "id": "f0076b39-f7e8-41ce-ad41-bd287b53d857",
          "order": 5,
          "speaker": "张东",
          "zh": "对。谢谢您了！",
          "pinyin": "Duì. Xièxie nín le!",
          "vi": "Đúng rồi. Cảm ơn anh/chị!",
          "audio_key": "",
          "vocab_refs": [],
          "grammar_refs": [],
          "source_origin": "textbook",
          "check_needed": false
        }
      ],
      "source_origin": "textbook",
      "check_needed": false
    },
    {
      "id": "f6a2ba94-9d60-4677-bb69-9eb1952cf3af",
      "type": "communication_dialogue",
      "variant": "role_play",
      "order": 2,
      "title": "取印章",
      "title_vi": "Lấy con dấu đã khắc",
      "instruction": {
        "zh": "练习交际会话。",
        "vi": "Luyện hội thoại giao tiếp theo tình huống.",
        "pinyin": "Liànxí jiāojì huìhuà."
      },
      "lines": [
        {
          "id": "9b5ff6c6-b874-4ad9-bfce-d09d080739b0",
          "order": 1,
          "speaker": "山本",
          "zh": "请问，我的印章刻好了没有？",
          "pinyin": "Qǐngwèn, wǒ de yìnzhāng kè hǎo le méiyǒu?",
          "vi": "Xin hỏi, con dấu của tôi khắc xong chưa?",
          "audio_key": "",
          "vocab_refs": [],
          "grammar_refs": [],
          "source_origin": "textbook",
          "check_needed": false
        },
        {
          "id": "eee2f3d7-cf3f-42d2-aeb7-f47aba338afa",
          "order": 2,
          "speaker": "营业员",
          "zh": "刻好了，你看看吧。",
          "pinyin": "Kè hǎo le, nǐ kànkan ba.",
          "vi": "Khắc xong rồi, anh/chị xem thử đi.",
          "audio_key": "",
          "vocab_refs": [],
          "grammar_refs": [],
          "source_origin": "textbook",
          "check_needed": false
        },
        {
          "id": "b9d8d9df-e1bd-4da4-a8d1-15299656533e",
          "order": 3,
          "speaker": "山本",
          "zh": "这就是篆字吗？",
          "pinyin": "Zhè jiù shì zhuànzì ma?",
          "vi": "Đây chính là chữ triện à?",
          "audio_key": "",
          "vocab_refs": [],
          "grammar_refs": [],
          "source_origin": "textbook",
          "check_needed": false
        },
        {
          "id": "edbae2bb-eb37-4cd4-95a3-31cabb7bfb3c",
          "order": 4,
          "speaker": "营业员",
          "zh": "对。你看，“山本幸子”。",
          "pinyin": "Duì. Nǐ kàn, “Shānběn Xìngzǐ”.",
          "vi": "Đúng. Anh/chị xem, “山本幸子”.",
          "audio_key": "",
          "vocab_refs": [],
          "grammar_refs": [],
          "source_origin": "textbook",
          "check_needed": false
        },
        {
          "id": "773e407c-44c1-4042-90be-aace489cb02d",
          "order": 5,
          "speaker": "山本",
          "zh": "啊，太好了！",
          "pinyin": "A, tài hǎo le!",
          "vi": "À, tốt quá!",
          "audio_key": "",
          "vocab_refs": [],
          "grammar_refs": [],
          "source_origin": "textbook",
          "check_needed": false
        }
      ],
      "source_origin": "textbook",
      "check_needed": false
    }
  ]
}
