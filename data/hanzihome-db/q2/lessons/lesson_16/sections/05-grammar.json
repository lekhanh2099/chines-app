          "order": 1,
          "title": "Bản chất",
          "content_vi": "Hai mẫu đều nói về sự thay đổi mức độ. 越来越…… nhìn sự thay đổi theo thời gian: ngày càng…. 越……越…… nhìn quan hệ điều kiện/mức độ: càng A càng B.",
          "examples": [],
          "source_origin": "textbook/generated_mixed",
          "check_needed": false
        },
        {
          "id": "a6012e0f-4ca0-438c-bcf0-1043d8150bda",
          "type": "grammar_structure",
          "order": 2,
          "title": "越来越……",
          "pattern": "主语 + 越来越 + 形容词 / 心理动词 / 能愿结构",
          "meaning_vi": "Ngày càng…, càng ngày càng…",
          "examples": [
            {
              "id": "771ce2b4-8b49-4b48-be3a-e887eb2024df",
              "zh": "等车的人越来越多了。",
              "vi": "Người đợi xe ngày càng đông rồi.",
              "pinyin": "Děng chē de rén yuè lái yuè duō le.",
              "grammar_refs": [
                "grammar_q2_l16_02"
              ],
              "source_origin": "textbook",
              "check_needed": false
            },
            {
