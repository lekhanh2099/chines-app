      ],
      "source_origin": "textbook/generated_mixed",
      "check_needed": false,
      "blocks": [
        {
          "id": "b7c5d870-2db8-4e2e-950f-f0e6e522ac16",
          "type": "grammar_overview",
          "order": 1,
          "title": "Bản chất",
          "content_vi": "Dùng để nói ở một nơi nào đó có / xuất hiện / biến mất một người hoặc sự vật. Trọng tâm là nơi chốn và sự tồn tại/xuất hiện/biến mất, không phải một chủ thể xác định làm hành động.",
          "examples": [],
          "source_origin": "textbook/generated_mixed",
          "check_needed": false
        },
        {
          "id": "b3534a40-3bab-464a-97dd-67889b8bcb7b",
          "type": "grammar_structure",
          "order": 2,
          "title": "Cấu trúc chính",
          "pattern": "处所词 + 动词 + 助词/补语 + 名词",
          "meaning_vi": "Từ chỉ nơi chốn + động từ + trợ từ/bổ ngữ + danh từ thường là thông tin mới, chưa xác định.",
          "formulas": [
            {
              "label": "Tồn tại",
              "pattern": "处所 + V着 + 数量名词"
            },
            {
              "label": "Xuất hiện",
              "pattern": "处所/方向 + V过来/上来/下来 + 数量名词"
            },
            {
              "label": "Biến mất/rời đi",
              "pattern": "处所 + V走/搬走/走了 + 数量名词"
            }
          ],
          "examples": [
            {
              "id": "c6fbeb40-156e-450c-a390-d58626cae49e",
              "zh": "门前种着一棵树。",
              "vi": "Trước cửa có trồng một cái cây.",
              "pinyin": "Mén qián zhòngzhe yì kē shù.",
              "grammar_refs": [
                "grammar_q2_l16_01"
              ],
              "source_origin": "textbook",
              "check_needed": false
            },
            {
              "id": "d5b13929-16ec-4967-ac8a-868d80ec0b1e",
              "zh": "树上开着很多花儿。",
              "vi": "Trên cây nở rất nhiều hoa.",
              "pinyin": "Shù shang kāizhe hěn duō huār.",
              "grammar_refs": [
                "grammar_q2_l16_01"
              ],
              "source_origin": "textbook",
              "check_needed": false
            },
            {
              "id": "50b5e564-92c8-4900-b66a-00f5bfca9437",
              "zh": "楼下上来一个人。",
              "vi": "Dưới lầu có một người đi lên.",
              "pinyin": "Lóu xià shànglai yí ge rén.",
              "grammar_refs": [
                "grammar_q2_l16_01"
              ],
              "source_origin": "textbook",
              "check_needed": false
            },
            {
              "id": "32ce3ad6-8de3-45db-b360-0c00996f1eef",
              "zh": "前面开过来一辆出租车。",
              "vi": "Phía trước có một chiếc taxi chạy tới.",
              "pinyin": "Qiánmiàn kāi guòlai yí liàng chūzūchē.",
              "grammar_refs": [
                "grammar_q2_l16_01"
              ],
              "source_origin": "textbook",
              "check_needed": false
            },
            {
              "id": "65da2f6a-6a1a-4d3d-8cf6-cc56c3fb01a8",
              "zh": "我们班走了两个学生。",
              "vi": "Lớp chúng tôi có hai học sinh rời đi.",
              "pinyin": "Wǒmen bān zǒu le liǎng ge xuésheng.",
              "grammar_refs": [
                "grammar_q2_l16_01"
              ],
              "source_origin": "textbook",
              "check_needed": false
            }
          ],
          "notes_vi": [
            "Danh từ cuối câu thường là thông tin mới như 一个人、一辆车、两个学生、很多花儿.",
            "Nếu danh từ là người/vật xác định như 王老师, thường nên dùng câu thường, không dùng kiểu tồn hiện."
          ],
          "source_origin": "textbook/generated_mixed",
          "check_needed": false
        },
        {
          "id": "887640f9-1173-43fc-ad6b-663c06a0b9b3",
          "type": "grammar_common_mistakes",
          "order": 3,
          "title": "Lỗi dễ sai",
          "items": [
            {
              "id": "e6c981d9-5f80-4a61-bcdd-d0604aa46be6",
              "wrong": "楼上下来了王老师。",
              "correct": "王老师从楼上下来了。 / 楼上下来了一个人。",
              "explanation_vi": "存现句 thường giới thiệu người/vật chưa xác định. 王老师 là người xác định nên dùng câu thường tự nhiên hơn."
            }
          ],
          "source_origin": "textbook/generated_mixed",
          "check_needed": false
        }
      ],
      "legacy_ids": [
        "grammar_q2_l16_01"
      ]
    },
