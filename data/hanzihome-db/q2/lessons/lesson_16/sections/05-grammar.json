          "notes_vi": [
            "Khi cùng chủ ngữ: 主语 + 越 + V/Adj + 越 + V/Adj. Khi khác chủ ngữ: 主语1 + 越..., 主语2 + 越..."
          ],
          "source_origin": "textbook/generated_mixed",
