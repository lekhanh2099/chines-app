      "blocks": [
        {
          "id": "b7c5d870-2db8-4e2e-950f-f0e6e522ac16",
          "type": "grammar_overview",
          "order": 1,
          "title": "Bản chất",
          "content_vi": "谁、什么、哪儿、怎么 không chỉ dùng để hỏi. Khi đi với 都/也 hoặc lặp lại theo mẫu điều kiện, chúng chỉ nghĩa bất kỳ ai/cái gì/nơi nào/cách nào.",
          "examples": [
            {
              "id": "2e38466f-cc5f-451a-9612-b188f7cd2dcf",
              "zh": "什么都可以。",
              "pinyin": "Shénme dōu kěyǐ.",
              "vi": "Món gì cũng được.",
              "en": "",
              "highlight": [],
              "grammar_refs": [
                "grammar_q2_l23_01"
              ],
              "vocab_refs": [],
              "source_ref": "",
              "note_vi": "",
              "audio_key": "",
              "source_origin": "textbook_generated_mixed",
              "check_needed": false
            },
            {
              "id": "64dc50f6-13c5-4723-9aed-94e0d978cb90",
              "zh": "谁都可以报名。",
              "pinyin": "Shéi dōu kěyǐ bàomíng.",
              "vi": "Ai cũng có thể đăng ký.",
              "en": "",
              "highlight": [],
              "grammar_refs": [
                "grammar_q2_l23_01"
              ],
              "vocab_refs": [],
              "source_ref": "",
              "note_vi": "",
              "audio_key": "",
              "source_origin": "textbook_generated_mixed",
              "check_needed": false
            },
            {
              "id": "b7a3d982-8f73-4ed4-b3d6-828fba6e2949",
              "zh": "哪儿好玩儿就去哪儿。",
              "pinyin": "Nǎr hǎowánr jiù qù nǎr.",
              "vi": "Chỗ nào vui thì đi chỗ đó.",
              "en": "",
              "highlight": [],
              "grammar_refs": [
