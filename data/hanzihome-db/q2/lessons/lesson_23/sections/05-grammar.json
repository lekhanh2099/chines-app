          "type": "grammar_structure",
          "order": 2,
          "title": "Cấu trúc",
          "pattern": "先 + A，再 + B，然后 + C，最后 + D",
          "meaning_vi": "Trước tiên làm A, rồi B, sau đó C, cuối cùng D.",
          "formulas": [
