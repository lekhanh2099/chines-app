        {
          "id": "a85d60ae-5a59-4bad-a730-4e11cd8fd4ed",
          "type": "grammar_structure",
          "order": 2,
          "title": "疑问代词 + 都/也 + 肯定/否定",
          "pattern": "谁/什么/哪儿/怎么 + 都/也 + V/Adj/不/没……",
          "meaning_vi": "Ai cũng / cái gì cũng / nơi nào cũng / thế nào cũng; hoặc không ai / không gì / không nơi nào.",
          "formulas": [
            {
              "label": "khẳng định",
              "pattern": "疑问代词 + 都/也 + 肯定"
            },
            {
              "label": "phủ định",
              "pattern": "疑问代词 + 都/也 + 不/没"
            }
          ],
          "examples": [
            {
              "id": "7aa9ef46-6f3d-4ea1-b0f6-1ba89dd9b81b",
              "zh": "什么都没吃。",
              "pinyin": "Shénme dōu méi chī.",
              "vi": "Chưa ăn gì cả.",
              "en": "",
              "highlight": [],
              "grammar_refs": [
