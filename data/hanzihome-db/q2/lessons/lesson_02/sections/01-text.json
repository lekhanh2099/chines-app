{
  "id": "a6c0d522-99be-4f36-881c-b9b2c6beeb85",
  "type": "text",
  "order": 1,
  "title": "课文",
  "title_vi": "Bài khóa",
  "source_origin": "textbook",
  "check_needed": false,
  "blocks": [
    {
      "id": "e155d5ea-f89d-45f0-ab8d-094ce9e719f0",
      "type": "text_dialogue",
      "order": 1,
      "title": "你怎么了",
      "title_vi": "Bạn bị sao vậy?",
      "source_origin": "textbook",
      "check_needed": false,
      "lines": [
        {
          "id": "f8046d8e-353e-4b63-a072-7498c8f1d9ff",
          "order": 1,
          "speaker": "大夫",
          "zh": "你怎么了？",
          "vi": "Anh/chị bị sao vậy?",
          "pinyin": "Nǐ zěnme le?",
          "grammar_refs": [
            "63d654f5-4561-4d48-a144-bacbf9671dfc"
          ]
        },
        {
          "id": "30929615-34c8-4e5b-b0a2-5ad3358ad755",
          "order": 2,
          "speaker": "病人",
          "zh": "肚子疼得厉害，在家吃了两片药，还不行。",
          "vi": "Bụng đau dữ lắm, ở nhà uống hai viên thuốc rồi mà vẫn không khỏi.",
          "pinyin": "Dùzi téng de lìhai, zài jiā chī le liǎng piàn yào, hái bù xíng.",
          "vocab_refs": [
            "1fbd69b7-603a-44ea-8d57-10cd4def9ced",
            "3dc505f1-bc0e-4a96-b448-17fed89fdc60",
            "5ea44727-d97c-467b-b1b8-babd195df50d"
          ],
          "grammar_refs": [
            "grammar_q2_l02_01"
          ]
        },
        {
          "id": "9faf6980-effe-42f1-a01e-7f1740da2edb",
          "order": 3,
          "speaker": "大夫",
          "zh": "拉肚子了吗？",
          "vi": "Có bị tiêu chảy không?",
          "pinyin": "Lā dùzi le ma?",
          "vocab_refs": [
            "54613016-834a-4fc3-9912-2357a6d27058"
          ],
          "grammar_refs": [
            "grammar_q2_l02_01"
          ]
        },
        {
          "id": "146f8fa1-ae74-468d-910e-19cab53e3cf3",
          "order": 4,
          "speaker": "病人",
          "zh": "拉了。",
          "vi": "Có.",
          "pinyin": "Lā le.",
          "vocab_refs": [
            "0da97406-c3ac-4fcb-a51c-398a59c3fbae"
          ],
          "grammar_refs": [
            "grammar_q2_l02_01"
          ]
        },
        {
          "id": "44d4c32e-309d-4802-b7cf-e41ee8052535",
          "order": 5,
          "speaker": "大夫",
          "zh": "昨天吃什么了？",
          "vi": "Hôm qua đã ăn gì?",
          "pinyin": "Zuótiān chī shénme le?",
          "grammar_refs": [
            "grammar_q2_l02_01"
          ]
        },
        {
          "id": "6f4b4423-8315-40e6-88fa-2fa2038271af",
          "order": 6,
          "speaker": "病人",
          "zh": "就吃了一些鱼和牛肉。",
          "vi": "Chỉ ăn một ít cá và thịt bò thôi.",
          "pinyin": "Jiù chī le yìxiē yú hé niúròu.",
          "vocab_refs": [
            "54b36889-82be-485b-8342-fb8aab572065",
            "1354b1a3-93cc-4505-8d7f-c5550a1d6ae9"
          ],
          "grammar_refs": [
            "grammar_q2_l02_01",
            "7e2ee128-4fbd-4a93-898c-5f5fd99b371b"
          ]
        },
        {
          "id": "6de58c5b-164f-4b2f-8d7e-84f1c7c1a66c",
          "order": 7,
          "speaker": "大夫",
          "zh": "喝什么了？",
          "vi": "Đã uống gì?",
          "pinyin": "Hē shénme le?",
          "grammar_refs": [
            "grammar_q2_l02_01"
          ]
        },
        {
          "id": "9d76be1a-c606-44bb-a490-a9bd82982e3b",
          "order": 8,
          "speaker": "病人",
          "zh": "喝了一瓶啤酒。",
          "vi": "Uống một chai bia.",
          "pinyin": "Hē le yì píng píjiǔ.",
          "grammar_refs": [
            "grammar_q2_l02_01"
          ]
        },
        {
          "id": "6e148072-17aa-4ebd-88a1-c59b2fc0ba17",
          "order": 9,
          "speaker": "大夫",
          "zh": "发烧吗？",
          "vi": "Có sốt không?",
          "pinyin": "Fāshāo ma?",
          "vocab_refs": [
            "2185ee67-885d-4ffb-83e2-e97be4070796"
          ]
        },
        {
          "id": "a8845639-9fca-4398-853d-a08fb63482a8",
          "order": 10,
          "speaker": "病人",
          "zh": "不发烧。",
          "vi": "Không sốt.",
          "pinyin": "Bù fāshāo.",
          "vocab_refs": [
            "2185ee67-885d-4ffb-83e2-e97be4070796"
          ]
        },
        {
          "id": "eb3a72ec-54fc-469d-929b-b614c65e00f1",
          "order": 11,
          "speaker": "大夫",
          "zh": "你先去化验一下儿大便，然后我再给你检查检查。",
          "vi": "Anh/chị đi xét nghiệm đại tiện trước một chút, sau đó tôi sẽ kiểm tra lại cho anh/chị.",
          "pinyin": "Nǐ xiān qù huàyàn yíxiàr dàbiàn, ránhòu wǒ zài gěi nǐ jiǎnchá jiǎnchá.",
          "vocab_refs": [
            "f0684cb3-4577-4e6c-9f22-7d97c89692b3",
            "d5b362a7-c8f6-4f25-b2b5-0f1749c8afbb",
            "7eccd5e8-dac0-4f36-be2e-abcc0a2bdfcd"
          ],
          "grammar_refs": [
            "5c6d8f8c-e237-49a9-90ed-774267549aa6",
            "00283e6f-e5c3-4028-a2c6-6296e5ecb407",
            "32221e32-5abd-40ef-abc1-2fa1076bc342"
          ]
        },
        {
          "id": "5d22fae9-a022-41b5-a551-b9b68c51b516",
          "order": 12,
          "speaker": "病人",
          "zh": "好吧。",
          "vi": "Được ạ.",
          "pinyin": "Hǎo ba."
        },
        {
          "id": "a568d979-0ebe-412d-9200-f663609af6c5",
          "order": 13,
          "speaker": "大夫",
          "zh": "化验结果出来了吗？",
          "vi": "Kết quả xét nghiệm đã có chưa?",
          "pinyin": "Huàyàn jiéguǒ chūlai le ma?",
          "vocab_refs": [
            "8a5b1d09-23a6-4182-96e6-9bf4d761a1e1",
            "be7a835d-ff8f-4a86-9fd8-27c5f1093f0c"
          ],
          "grammar_refs": [
            "grammar_q2_l02_01"
          ]
        },
        {
          "id": "352eb6a5-7ba0-4d98-80b5-4781602b9aea",
          "order": 14,
          "speaker": "病人",
          "zh": "出来了。",
          "vi": "Có rồi.",
          "pinyin": "Chūlai le.",
          "vocab_refs": [
            "be7a835d-ff8f-4a86-9fd8-27c5f1093f0c"
          ],
          "grammar_refs": [
            "grammar_q2_l02_01"
          ]
        },
        {
          "id": "fba2b141-cab4-4f5e-8224-ecf84e4848a5",
          "order": 15,
          "speaker": "病人",
          "zh": "大夫，我是不是得了肠炎？",
          "vi": "Bác sĩ, có phải tôi bị viêm ruột không?",
          "pinyin": "Dàifu, wǒ shì bú shì dé le chángyán?",
          "vocab_refs": [
            "7a89dc80-d79d-4c2f-988c-d0f54e240d19",
            "ff3e1818-66a9-4532-880b-02c9cacb0e5b"
          ],
          "grammar_refs": [
            "grammar_q2_l02_01"
          ]
        },
        {
          "id": "aa764237-7eb1-41b2-a294-69d008848cef",
          "order": 16,
          "speaker": "大夫",
          "zh": "我看了化验结果。不是肠炎，只是消化不好。先给你开一些药，再给你打一针。",
          "vi": "Tôi xem kết quả xét nghiệm rồi. Không phải viêm ruột, chỉ là tiêu hóa không tốt. Trước tiên tôi kê cho anh/chị một ít thuốc, rồi tiêm cho anh/chị một mũi.",
          "pinyin": "Wǒ kàn le huàyàn jiéguǒ. Bú shì chángyán, zhǐ shì xiāohuà bù hǎo. Xiān gěi nǐ kāi yìxiē yào, zài gěi nǐ dǎ yì zhēn.",
          "vocab_refs": [
            "8a5b1d09-23a6-4182-96e6-9bf4d761a1e1",
            "ff3e1818-66a9-4532-880b-02c9cacb0e5b",
            "0125bdae-fe4e-48fb-8264-145e95c75933",
            "689eb64b-5d4f-469f-9afa-74017d399614",
            "d45d5488-9293-41ae-9deb-1e5b51cee446"
          ],
          "grammar_refs": [
            "grammar_q2_l02_01",
            "5c6d8f8c-e237-49a9-90ed-774267549aa6"
          ]
        },
        {
          "id": "0f8281fb-2805-45f3-acba-147f5cbed2c9",
          "order": 17,
          "speaker": "病人",
          "zh": "这药怎么吃？",
          "vi": "Thuốc này uống thế nào?",
          "pinyin": "Zhè yào zěnme chī?"
        },
        {
          "id": "d09c0385-2b8e-40b2-98c0-968d24dd2d58",
          "order": 18,
          "speaker": "护士",
          "zh": "一天三次，一次两片，饭后吃。",
          "vi": "Một ngày ba lần, mỗi lần hai viên, uống sau bữa ăn.",
          "pinyin": "Yì tiān sān cì, yí cì liǎng piàn, fàn hòu chī.",
          "vocab_refs": [
            "5ea44727-d97c-467b-b1b8-babd195df50d",
            "c99a633b-27a2-429b-a139-44113a84c189"
          ]
        }
      ],
      "paragraphs": [],
      "comprehension_questions": []
    },
    {
      "id": "0156dd39-d5b4-41f5-866d-d336dd29bbc2",
      "type": "text_dialogue",
      "order": 2,
      "title": "玛丽哭了",
      "title_vi": "Mary khóc rồi",
      "source_origin": "textbook",
      "check_needed": false,
      "lines": [
        {
          "id": "887014e5-f6b0-4777-9f95-85a69532ca36",
          "order": 1,
          "speaker": "罗兰",
          "zh": "玛丽，你怎么哭了？病了吗？",
          "vi": "Mary, sao cậu khóc vậy? Bị ốm à?",
          "pinyin": "Mǎlì, nǐ zěnme kū le? Bìng le ma?",
          "vocab_refs": [
            "173409e7-a2ad-4e05-a409-6d8b3dc2203d",
            "68c05a12-9d8e-45d9-a413-786bcf2f780a"
          ],
          "grammar_refs": [
            "grammar_q2_l02_01",
            "63d654f5-4561-4d48-a144-bacbf9671dfc"
          ]
        },
        {
          "id": "65232ef9-30a1-4305-b8b7-12a8ac5aeb91",
          "order": 2,
          "speaker": "玛丽",
          "zh": "不是。想家了。因为感到寂寞，所以心情不好，很难过。",
          "vi": "Không phải. Tớ nhớ nhà. Vì cảm thấy cô đơn nên tâm trạng không tốt, rất buồn.",
          "pinyin": "Bú shì. Xiǎng jiā le. Yīnwèi gǎndào jìmò, suǒyǐ xīnqíng bù hǎo, hěn nánguò.",
          "vocab_refs": [
            "79358c6f-3427-4c28-98f3-7ef98c7033c3",
            "dc0f8e06-a359-4907-a8d8-fc9b02260590",
            "c43cedbf-7024-4ec1-922f-e75119114baf"
          ],
          "grammar_refs": [
            "grammar_q2_l02_02"
          ]
        },
        {
          "id": "2c1213ac-f81d-414f-8b55-5abe77fe83fc",
          "order": 3,
          "speaker": "罗兰",
          "zh": "别难过了。",
          "vi": "Đừng buồn nữa.",
          "pinyin": "Bié nánguò le.",
          "vocab_refs": [
            "d9991c79-3454-4247-bf18-f14f43b4a24a"
          ],
          "grammar_refs": [
            "d3a1ecc2-8c1f-4b77-8f62-a76d0b71b893"
          ]
        },
        {
          "id": "d797c234-0a16-42e3-bc45-29782e65cb1b",
          "order": 4,
          "speaker": "玛丽",
          "zh": "你不想家吗？",
          "vi": "Cậu không nhớ nhà à?",
          "pinyin": "Nǐ bù xiǎng jiā ma?"
        },
        {
          "id": "c99f042b-fa9a-478c-aba1-5da333a677e1",
          "order": 5,
          "speaker": "罗兰",
          "zh": "我也常想家，但是不感到寂寞。",
          "vi": "Tớ cũng thường nhớ nhà, nhưng không cảm thấy cô đơn.",
          "pinyin": "Wǒ yě cháng xiǎng jiā, dànshì bù gǎndào jìmò.",
          "vocab_refs": [
            "79358c6f-3427-4c28-98f3-7ef98c7033c3"
          ]
        },
        {
          "id": "e8680b0f-6dcc-4fc7-abbd-084aba5d3b87",
          "order": 6,
          "speaker": "玛丽",
          "zh": "我有姐姐，还有弟弟。在家时，我们常常一起玩儿，所以感到寂寞时总想他们。",
          "vi": "Tớ có chị gái, còn có em trai. Khi ở nhà, bọn tớ thường chơi cùng nhau, nên mỗi khi cảm thấy cô đơn thì luôn nhớ họ.",
          "pinyin": "Wǒ yǒu jiějie, hái yǒu dìdi. Zài jiā shí, wǒmen chángcháng yìqǐ wánr, suǒyǐ gǎndào jìmò shí zǒng xiǎng tāmen.",
          "vocab_refs": [
            "dc0f8e06-a359-4907-a8d8-fc9b02260590"
          ],
          "grammar_refs": [
            "grammar_q2_l02_02"
          ]
        },
        {
          "id": "cc8da348-3e89-4f64-a680-de239f505497",
          "order": 7,
          "speaker": "罗兰",
          "zh": "今天晚上礼堂有舞会，我们一起去跳跳舞吧。玩儿玩儿就好了。",
          "vi": "Tối nay ở lễ đường có vũ hội, chúng ta cùng đi nhảy một chút nhé. Chơi một chút là sẽ đỡ thôi.",
          "pinyin": "Jīntiān wǎnshang lǐtáng yǒu wǔhuì, wǒmen yìqǐ qù tiàotiao wǔ ba. Wánr wánr jiù hǎo le.",
          "vocab_refs": [
            "55cd807c-eec7-412d-99db-f4e6508b170f",
            "085e60d5-dd1c-4585-ac6b-0f1db0ded936",
            "ba7ff0f9-b633-4516-ab3d-22b96046a1cf"
          ],
          "grammar_refs": [
            "d85c63bd-7607-4517-874a-7a596fc80b7d",
            "32221e32-5abd-40ef-abc1-2fa1076bc342"
          ]
        },
        {
          "id": "2adb7cf6-26c1-4029-809e-67342fb0227f",
          "order": 8,
          "speaker": "玛丽",
          "zh": "什么时候去？",
          "vi": "Khi nào đi?",
          "pinyin": "Shénme shíhou qù?"
        },
        {
          "id": "f42aa089-875d-48c4-9213-a083ec251fe7",
          "order": 9,
          "speaker": "罗兰",
          "zh": "吃了晚饭就去吧。你在宿舍等我，我来叫你。",
          "vi": "Ăn tối xong thì đi nhé. Cậu đợi tớ ở ký túc xá, tớ sẽ đến gọi cậu.",
          "pinyin": "Chī le wǎnfàn jiù qù ba. Nǐ zài sùshè děng wǒ, wǒ lái jiào nǐ.",
          "grammar_refs": [
            "grammar_q2_l02_01"
          ]
        },
        {
          "id": "f7419a05-c714-4cff-ae26-210852d56303",
          "order": 10,
          "speaker": "玛丽",
          "zh": "好吧。",
          "vi": "Được.",
          "pinyin": "Hǎo ba."
        }
      ],
      "paragraphs": [],
      "comprehension_questions": []
    }
  ]
}
