      "blocks": [
        {
          "id": "50dcd503-1832-4112-a0be-e09408954b90",
          "type": "grammar_overview",
          "order": 1,
          "title": "Bản chất",
          "content_vi": "Dùng 得 để nói hành động xảy ra đến mức nào, ra sao, giống thế nào. Bài này có dạng bổ ngữ dài và dạng so sánh với 像……一样.",
          "examples": [
            {
              "id": "47d597ee-f98d-4604-907d-6e6946054ef4",
              "zh": "孩子的妈妈感动得不知道说什么好。",
              "pinyin": "Háizi de māma gǎndòng de bù zhīdào shuō shénme hǎo.",
              "vi": "Mẹ của đứa bé cảm động đến mức không biết nói gì.",
              "highlight": [
                "感动得不知道说什么好"
              ],
              "grammar_refs": [
                "fa804fff-372b-4874-8571-f54e613d7e07"
              ],
              "vocab_refs": [],
              "source_origin": "textbook",
              "check_needed": false
            },
            {
              "id": "9a65ce46-32b1-443f-8743-753c90b62d0f",
              "zh": "你的字写得很漂亮。",
              "pinyin": "Nǐ de zì xiě de hěn piàoliang.",
              "vi": "Chữ của bạn viết rất đẹp.",
