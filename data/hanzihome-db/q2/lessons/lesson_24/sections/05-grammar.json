          "id": "3de2e20b-7535-4f1b-8355-4209acba1551",
          "type": "grammar_structure",
          "order": 2,
          "title": "Cấu trúc chính",
          "pattern": "V + 得 + trạng thái / mức độ / kết quả miêu tả",
          "meaning_vi": "Miêu tả trạng thái đạt được sau hành động hoặc đánh giá hành động làm ra sao.",
          "formulas": [
            {
              "label": "cơ bản",
              "pattern": "V + 得 + Adj/phrase"
