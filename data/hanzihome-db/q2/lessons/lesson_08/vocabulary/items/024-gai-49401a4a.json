      "rule_vi": "Phân biệt:",
      "natural_examples": [],
      "unnatural_examples": [],
      "wrong_examples": [],
      "correct_examples": [],
      "explanation_vi": "该走了 = đến lúc đi rồi. 要走了 = sắp đi rồi / muốn đi rồi tùy ngữ cảnh. 必须走 = bắt buộc phải đi. Câu 该换电池了 không cần chủ ngữ vì tiếng Trung rất hay dùng câu vô chủ trong tình huống rõ ràng.",
      "severity": "warning",
      "notes": []
    }
