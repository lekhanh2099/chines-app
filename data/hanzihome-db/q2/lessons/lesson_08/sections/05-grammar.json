  "items": [
    {
      "id": "grammar_q2_l08_01",
      "type": "grammar_point",
      "order": 1,
      "title": "变化的表达法：语气助词“了”（2）",
      "title_vi": "Trợ từ ngữ khí 了 biểu thị biến hóa",
      "level": "HSK3",
      "tags": [
        "语法"
      ],
      "blocks": [
        {
          "id": "b7c5d870-2db8-4e2e-950f-f0e6e522ac16",
          "type": "grammar_overview",
          "order": 1,
          "title": "Bản chất",
          "content_vi": "了 đặt cuối câu biểu thị tình hình đã thay đổi hoặc một trạng thái mới xuất hiện. Bài này không phải trọng tâm “V了” hoàn thành, mà là “Câu + 了” báo biến hóa: 天冷了、表停了、不工作了。",
          "examples": [
            {
              "id": "grammar_08_le_ex_001",
              "zh": "冬天快要到了。",
              "pinyin": "Dōngtiān kuàiyào dào le.",
              "vi": "Mùa đông sắp đến rồi.",
              "source_origin": "pdf_textbook_checked",
              "check_needed": false
            },
            {
              "id": "grammar_08_le_ex_002",
              "zh": "我的表停了。",
              "pinyin": "Wǒ de biǎo tíng le.",
              "vi": "Đồng hồ của tôi dừng rồi.",
              "source_origin": "pdf_textbook_checked",
              "check_needed": false
            },
            {
              "id": "grammar_08_le_ex_003",
              "zh": "她未婚夫不愿意让她工作了。",
              "pinyin": "Tā wèihūnfū bú yuànyì ràng tā gōngzuò le.",
              "vi": "Vị hôn phu của chị ấy không muốn để chị ấy đi làm nữa.",
              "source_origin": "pdf_textbook_checked",
              "check_needed": false
            }
          ],
          "source_origin": "pdf_textbook_checked",
          "check_needed": false
        }
      ],
      "source_origin": "pdf_textbook_checked",
      "check_needed": false,
      "legacy_ids": [
        "grammar_q2_l08_01"
      ]
    },
    {
      "id": "grammar_q2_l08_02",
      "type": "grammar_point",
      "order": 2,
      "title": "动作即将发生的表达法",
      "title_vi": "Diễn tả sắp xảy ra",
      "level": "HSK3",
      "tags": [
        "语法"
      ],
      "blocks": [
        {
          "id": "0ef2b790-3209-4b5c-a519-ca5a424e4d49",
          "type": "grammar_structure",
          "order": 1,
          "title": "Cấu trúc",
          "pattern": "要 / 就要 / 快要 / 快 + 动词 + 了",
          "meaning_vi": "Biểu thị một sự việc sắp xảy ra. Có thời gian cụ thể thì thường dùng 就要……了, không dùng 快要……了 trong kiểu câu như “下个月姐姐就要结婚了”.",
          "examples": [
            {
              "id": "grammar_08_imminent_ex_001",
              "zh": "快走吧，要上课了。",
              "pinyin": "Kuài zǒu ba, yào shàng kè le.",
              "vi": "Đi nhanh đi, sắp vào lớp rồi.",
              "source_origin": "pdf_textbook_checked",
              "check_needed": false
            },
            {
              "id": "grammar_08_imminent_ex_002",
              "zh": "我姐姐下个月就要结婚了。",
              "pinyin": "Wǒ jiějie xià ge yuè jiùyào jiéhūn le.",
              "vi": "Chị gái tôi tháng sau sắp kết hôn rồi.",
              "source_origin": "pdf_textbook_checked",
              "check_needed": false
            },
            {
              "id": "grammar_08_imminent_ex_003",
              "zh": "要下雨了。",
              "pinyin": "Yào xià yǔ le.",
              "vi": "Sắp mưa rồi.",
              "source_origin": "pdf_textbook_checked",
              "check_needed": false
            }
          ],
          "source_origin": "pdf_textbook_checked",
          "check_needed": false
        }
      ],
      "source_origin": "pdf_textbook_checked",
      "check_needed": false,
      "legacy_ids": [
        "grammar_q2_l08_02"
      ]
    },
    {
      "id": "grammar_q2_l08_03",
      "type": "grammar_point",
      "order": 3,
      "title": "状语与结构助词“地”",
      "title_vi": "Trạng ngữ với 地",
      "level": "HSK3",
      "tags": [
        "语法"
      ],
      "blocks": [
        {
          "id": "3de2e20b-7535-4f1b-8355-4209acba1551",
          "type": "grammar_structure",
          "order": 1,
          "title": "Cấu trúc",
          "pattern": "形容词 / 词组 + 地 + 动词",
          "meaning_vi": "地 đọc nhẹ de, đứng sau tính từ/cụm từ để biến phần trước thành trạng ngữ, bổ nghĩa cho động từ phía sau: 高兴地说, 努力地学习.",
          "examples": [
            {
              "id": "grammar_08_de_ex_001",
              "zh": "她在信上高兴地说，我姐姐下个月就要结婚了。",
              "pinyin": "Tā zài xìn shang gāoxìng de shuō, wǒ jiějie xià ge yuè jiùyào jiéhūn le.",
              "vi": "Trong thư, mẹ vui mừng nói rằng chị gái tôi tháng sau sắp kết hôn.",
              "source_origin": "pdf_textbook_checked",
              "check_needed": false
            },
            {
              "id": "grammar_08_de_ex_002",
              "zh": "同学们都在努力地学习。",
              "pinyin": "Tóngxuémen dōu zài nǔlì de xuéxí.",
              "vi": "Các bạn học đều đang học tập chăm chỉ.",
              "source_origin": "pdf_textbook_checked",
              "check_needed": false
            }
          ],
          "source_origin": "pdf_textbook_checked",
          "check_needed": false
        }
      ],
      "source_origin": "pdf_textbook_checked",
      "check_needed": false,
      "legacy_ids": [
        "grammar_q2_l08_03"
      ]
    },
    {
      "id": "grammar_q2_l08_04",
      "type": "grammar_point",
      "order": 4,
      "title": "无主语句",
      "title_vi": "Câu vô chủ",
      "level": "HSK3",
      "tags": [
        "语法"
      ],
      "blocks": [
        {
          "id": "6b109e8c-3e57-466f-89ea-5e3dd68f03d9",
          "type": "grammar_overview",
          "order": 1,
          "title": "Bản chất",
          "content_vi": "Một số câu tiếng Trung không cần chủ ngữ khi trọng tâm là hiện tượng tự nhiên, lời chúc, mệnh lệnh hoặc tình huống hiển nhiên trong ngữ cảnh.",
          "examples": [
            {
              "id": "grammar_08_subjectless_ex_001",
              "zh": "刮风了。",
              "pinyin": "Guā fēng le.",
              "vi": "Gió nổi rồi.",
              "source_origin": "pdf_textbook_checked",
              "check_needed": false
            },
            {
              "id": "grammar_08_subjectless_ex_002",
              "zh": "快走吧。",
              "pinyin": "Kuài zǒu ba.",
              "vi": "Đi nhanh đi.",
              "source_origin": "pdf_textbook_checked",
              "check_needed": false
            },
            {
              "id": "grammar_08_subjectless_ex_003",
              "zh": "祝你生日快乐！",
              "pinyin": "Zhù nǐ shēngrì kuàilè!",
              "vi": "Chúc bạn sinh nhật vui vẻ!",
              "source_origin": "pdf_textbook_checked",
              "check_needed": false
            }
          ],
          "source_origin": "pdf_textbook_checked",
          "check_needed": false
        }
      ],
      "source_origin": "pdf_textbook_checked",
