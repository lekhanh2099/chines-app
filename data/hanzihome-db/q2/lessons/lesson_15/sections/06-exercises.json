      "title": "八、交际会话",
      "title_vi": "Hội thoại giao tiếp",
      "instruction": {
        "zh": "打听。",
        "vi": "Luyện hội thoại hỏi thăm/tìm người."
      },
      "dialogue": {
        "id": "9d10590c-3dd7-4287-b930-4f4dbe1e9afb",
        "title": "打听",
        "lines": [
          {
            "id": "f52796f9-5f63-4af1-8948-89d7c85ee6fd",
            "order": 1,
            "speaker": "A",
            "zh": "请问，您看没看见一个姑娘（gūniang, girl）从这儿过去？",
            "pinyin": "Qǐngwèn, nín kàn méi kànjiàn yí ge gūniang cóng zhèr guòqu?",
            "vi": "Xin hỏi, ông/bà có thấy một cô gái đi qua đây không?",
            "source_origin": "textbook",
            "check_needed": false
          },
          {
            "id": "b26d9060-a396-49b7-9afe-4d814fbc6004",
            "order": 2,
            "speaker": "B",
            "zh": "什么姑娘？长得什么样？",
            "pinyin": "Shénme gūniang? Zhǎng de shénme yàng?",
            "vi": "Cô gái nào? Trông như thế nào?",
            "source_origin": "textbook",
            "check_needed": false
          },
          {
            "id": "f5645182-4b46-494e-961f-3b5ec9164b36",
            "order": 3,
            "speaker": "A",
            "zh": "身高一米六左右，留着长发，穿着一件白色的上衣，戴着一副眼镜儿。",
            "pinyin": "Shēngāo yì mǐ liù zuǒyòu, liúzhe cháng fà, chuānzhe yí jiàn báisè de shàngyī, dàizhe yì fù yǎnjìngr.",
            "vi": "Cao khoảng một mét sáu, để tóc dài, mặc một chiếc áo màu trắng, đeo một cặp kính.",
            "source_origin": "textbook",
            "check_needed": false
          },
          {
            "id": "f5ee5452-4013-42e0-add2-74cd9655d1aa",
            "order": 4,
            "speaker": "B",
            "zh": "看见了。",
            "pinyin": "Kànjiàn le.",
            "vi": "Tôi thấy rồi.",
            "source_origin": "textbook",
            "check_needed": false
          },
          {
            "id": "7fe8fa5b-98fb-495c-b81a-8950b514a5ee",
            "order": 5,
            "speaker": "A",
            "zh": "她往哪儿走了？",
            "pinyin": "Tā wǎng nǎr zǒu le?",
            "vi": "Cô ấy đi về phía nào rồi?",
            "source_origin": "textbook",
            "check_needed": false
          },
          {
            "id": "590f5123-b1cf-4406-ad15-905410435801",
            "order": 6,
            "speaker": "B",
            "zh": "从这儿下山去了。",
            "pinyin": "Cóng zhèr xià shān qù le.",
            "vi": "Từ đây đi xuống núi rồi.",
            "source_origin": "textbook",
            "check_needed": false
          },
          {
            "id": "18980709-047d-4a36-b93d-9e35cbb641a0",
            "order": 7,
            "speaker": "A",
            "zh": "大概走多长时间了？",
            "pinyin": "Dàgài zǒu duō cháng shíjiān le?",
            "vi": "Cô ấy đi được khoảng bao lâu rồi?",
            "source_origin": "textbook",
            "check_needed": false
          },
          {
            "id": "4092035f-006c-4e87-a049-4557714dc3bc",
            "order": 8,
            "speaker": "B",
            "zh": "二十多分钟了。",
            "pinyin": "Èrshí duō fēnzhōng le.",
            "vi": "Hơn hai mươi phút rồi.",
            "source_origin": "textbook",
            "check_needed": false
          },
          {
            "id": "e28f7cdd-1541-4e28-8531-ad465a229e1f",
            "order": 9,
            "speaker": "A",
            "zh": "只她一个人吗？",
            "pinyin": "Zhǐ tā yí ge rén ma?",
            "vi": "Chỉ một mình cô ấy thôi à?",
            "source_origin": "textbook",
            "check_needed": false
          },
          {
            "id": "ebbe8ddf-1bb4-47ac-bc09-b176e5b25724",
            "order": 10,
            "speaker": "B",
            "zh": "对。",
            "pinyin": "Duì.",
            "vi": "Đúng vậy.",
            "source_origin": "textbook",
            "check_needed": false
          },
          {
            "id": "caeadce5-0d47-4beb-9312-b40f0f134bbd",
            "order": 11,
            "speaker": "A",
            "zh": "就是她。我们也快点儿下去吧。谢谢您了！",
            "pinyin": "Jiù shì tā. Wǒmen yě kuài diǎnr xiàqu ba. Xièxie nín le!",
            "vi": "Chính là cô ấy. Chúng ta cũng mau xuống thôi. Cảm ơn ông/bà ạ!",
            "source_origin": "textbook",
            "check_needed": false
          },
          {
            "id": "482269cb-aa0c-4857-b94c-82cae9ab8cb6",
            "order": 12,
            "speaker": "B",
            "zh": "不客气！",
            "pinyin": "Bú kèqi!",
            "vi": "Không có gì!",
            "source_origin": "textbook",
            "check_needed": false
          }
        ]
      },
