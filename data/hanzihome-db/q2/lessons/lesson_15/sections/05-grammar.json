        {
          "id": "41481a1e-2130-4b8f-8881-e0a4e9c6c721",
          "type": "grammar_usage_notes",
          "order": 7,
          "title": "V1 + 着 + V2",
          "notes_vi": [
            "Động từ 1 + 着 đứng trước động từ thứ hai để nói trạng thái/cách thức khi thực hiện hành động thứ hai.",
            "Dịch tự nhiên là “vừa/cứ V1 mà V2”, hoặc “V2 trong tư thế/cách thức V1”."
          ],
          "examples": [
            {
              "id": "23e9a923-70b2-4db3-b9d3-cb914af29d8b",
              "zh": "她正在前边站着讲话呢。",
              "pinyin": "Tā zhèngzài qiánbian zhànzhe jiǎnghuà ne.",
              "vi": "Cô ấy đang đứng ở phía trước nói chuyện/phát biểu.",
              "en": "",
              "highlight": [
                "站着",
                "讲话"
              ],
              "grammar_refs": [
                "grammar_q2_l15_01"
              ],
              "vocab_refs": [],
              "source_ref": "",
              "note_vi": "",
              "audio_key": "",
              "source_origin": "textbook",
              "check_needed": false
            },
            {
              "id": "51ac1b3e-121f-416e-a8aa-9777695ba932",
              "zh": "她笑着对我说：“欢迎！欢迎！”",
              "pinyin": "Tā xiàozhe duì wǒ shuō: “Huānyíng! Huānyíng!”",
              "vi": "Cô ấy cười nói với tôi: “Hoan nghênh! Hoan nghênh!”",
              "en": "",
              "highlight": [
                "笑着",
                "说"
              ],
              "grammar_refs": [
                "grammar_q2_l15_01"
              ],
              "vocab_refs": [],
              "source_ref": "",
              "note_vi": "",
              "audio_key": "",
              "source_origin": "textbook",
              "check_needed": false
            },
            {
              "id": "7e491252-3972-46aa-9835-0fdf312c8291",
              "zh": "那里离这儿不远，我们走着去吧。",
              "pinyin": "Nàli lí zhèr bù yuǎn, wǒmen zǒuzhe qù ba.",
              "vi": "Chỗ đó cách đây không xa, chúng ta đi bộ đến nhé.",
              "en": "",
              "highlight": [
