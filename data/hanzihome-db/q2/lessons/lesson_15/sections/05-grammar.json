              "check_needed": false
            }
          ]
        },
        {
          "id": "9037a868-929d-412a-8833-7f79c74218d5",
          "type": "grammar_compare",
          "order": 9,
          "title": "在 + V vs V + 着",
          "items": [
            {
              "aspect": "Trọng tâm",
              "left": {
                "label": "在 + V",
                "value": "Nhấn mạnh hành động đang diễn ra."
              },
              "right": {
                "label": "V + 着",
                "value": "Nhấn mạnh trạng thái đang duy trì."
              }
            },
            {
              "aspect": "Ví dụ",
              "left": {
                "label": "在 + V",
                "value": "他在开门。 = Anh ấy đang mở cửa."
              },
              "right": {
                "label": "V + 着",
                "value": "门开着。 = Cửa đang mở."
              }
            },
            {
              "aspect": "Dịch tự nhiên",
              "left": {
                "label": "在 + V",
                "value": "đang thực hiện động tác"
              },
              "right": {
                "label": "V + 着",
                "value": "đang ở trạng thái sau hành động"
              }
            }
          ]
        },
        {
          "id": "887640f9-1173-43fc-ad6b-663c06a0b9b3",
          "type": "grammar_common_mistakes",
          "order": 10,
          "title": "Lỗi sai phổ biến",
          "items": [
            {
              "id": "fcca9d55-0c2d-4c43-a7dc-53d87054f2ad",
              "wrong": "门正在开着。",
              "correct": "门开着呢。",
              "explanation_vi": "Nếu muốn nói cửa ở trạng thái mở, dùng 开着 là đủ; 正在开着 thường không tự nhiên nếu không có ngữ cảnh đặc biệt."
            },
            {
              "id": "43ad1993-846b-4c58-95cb-71d086060b17",
              "wrong": "她穿着衣服了。",
              "correct": "她穿着衣服呢。 / 她穿了一件衣服。",
              "explanation_vi": "着 nhấn trạng thái duy trì, 了 nhấn hoàn thành/thay đổi; không ghép máy móc."
            },
            {
              "id": "e9feed73-8319-4195-9b00-03aab9bbda3e",
              "wrong": "他着看书。",
              "correct": "他看着书。 / 他躺着看书。",
              "explanation_vi": "着 đứng sau động từ, không đứng trước động từ."
            }
          ]
        }
      ],
