        {
          "id": "d20f2f52-d6ab-478a-b684-6adcb0004a12",
          "type": "grammar_negative_form",
          "order": 5,
          "title": "Phủ định của V + 着",
          "pattern": "没 / 没有 + 动词 + 着",
          "wrong_pattern": "不 + 动词 + 着",
          "meaning_vi": "Diễn tả trạng thái đó không tồn tại hoặc hành động đó không đang được duy trì. Sách lưu ý dạng này trong giao tiếp dùng khá ít.",
          "correct_examples": [
            {
              "id": "09650f94-7037-4990-b0bc-ee54ef9c2c65",
              "zh": "老师没在前面坐着，他站着呢。",
              "pinyin": "Lǎoshī méi zài qiánmiàn zuòzhe, tā zhànzhe ne.",
              "vi": "Thầy giáo không ngồi ở phía trước, thầy đang đứng đấy.",
              "highlight": [
                "没",
                "坐着",
                "站着"
              ],
              "explanation_vi": ""
            },
            {
              "id": "849abc24-1544-49ed-a803-168d380e8c55",
              "zh": "教室的门没开着。",
              "pinyin": "Jiàoshì de mén méi kāizhe.",
              "vi": "Cửa phòng học không mở.",
              "highlight": [
                "没开着"
              ],
              "explanation_vi": ""
            },
            {
              "id": "15d3bce2-1fc6-4191-a2ec-fb718ff68afc",
              "zh": "书上没写着名字，不知道是谁的书。",
              "pinyin": "Shū shàng méi xiězhe míngzi, bù zhīdào shì shéi de shū.",
              "vi": "Trên sách không viết tên, không biết là sách của ai.",
              "highlight": [
                "没写着"
              ],
              "explanation_vi": ""
            }
          ],
          "wrong_examples": []
        },
        {
          "id": "0ea62f46-0157-49d6-aadc-75dbed1d507b",
          "type": "grammar_question_form",
