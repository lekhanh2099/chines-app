  "items": [
    {
      "id": "grammar_q2_l15_01",
      "type": "grammar_point",
      "order": 1,
      "title": "动作的进行或状态的持续：动词 + 着",
      "title_vi": "Sự tiếp diễn của hành động hoặc sự duy trì của trạng thái: Động từ + 着",
      "level": "HSK3+",
      "tags": [
        "语法",
        "aspect_particle",
        "zhe"
      ],
      "source_origin": "textbook/generated_mixed",
      "check_needed": false,
      "blocks": [
        {
          "id": "b7c5d870-2db8-4e2e-950f-f0e6e522ac16",
          "type": "grammar_overview",
          "order": 1,
          "title": "Bản chất",
          "content_vi": "着 đứng sau động từ để miêu tả hành động/trạng thái đang được duy trì. Nó không chỉ tương đương “đang làm”, mà thường nhấn mạnh trạng thái sau hành động vẫn còn tồn tại, ví dụ 门开着 = cửa đang ở trạng thái mở.",
          "examples": [
            {
              "id": "56ae127b-47c7-4830-86f9-4e04978c42ea",
              "zh": "会议厅的门开着呢。",
              "pinyin": "Huìyìtīng de mén kāizhe ne.",
              "vi": "Cửa phòng hội nghị đang mở đấy.",
              "en": "",
              "highlight": [
                "开着"
              ],
              "grammar_refs": [
                "grammar_q2_l15_01"
              ],
              "vocab_refs": [],
              "source_ref": "fad45bf0-e51a-4400-8b0b-fc3c23e07e11",
              "note_vi": "",
              "audio_key": "",
              "source_origin": "textbook",
              "check_needed": false
            }
          ]
        },
        {
          "id": "a85d60ae-5a59-4bad-a730-4e11cd8fd4ed",
          "type": "grammar_structure",
          "order": 2,
          "title": "Cấu trúc chính",
          "pattern": "主语 / 处所 + 动词 + 着 + 宾语 / 其他成分",
          "meaning_vi": "Diễn tả hành động hoặc trạng thái đang tiếp tục.",
          "formulas": [
            {
              "label": "core",
              "pattern": "S / Location + V + 着 + O"
            }
          ],
          "examples": [
            {
              "id": "53f5d202-6084-4b9e-90a3-b08115cafe18",
              "zh": "同学们走着，说着，笑着，可热闹啦。",
              "pinyin": "Tóngxuémen zǒuzhe, shuōzhe, xiàozhe, kě rènao la.",
              "vi": "Các bạn học sinh vừa đi, vừa nói, vừa cười, thật náo nhiệt.",
              "en": "",
              "highlight": [
                "走着",
                "说着",
                "笑着"
              ],
              "grammar_refs": [
                "grammar_q2_l15_01"
              ],
              "vocab_refs": [],
              "source_ref": "",
              "note_vi": "",
              "audio_key": "",
              "source_origin": "textbook",
              "check_needed": false
            }
          ]
        },
        {
          "id": "ca8c13db-9de3-46b8-a156-5be7570386a5",
          "type": "grammar_structure",
          "order": 3,
          "title": "着 biểu thị hành động đang tiến hành và kéo dài",
          "pattern": "正在 / 正 / 在 + 动词 + 着 + 宾语",
          "meaning_vi": "Nhấn mạnh hành động đang diễn ra tại thời điểm nói và vẫn còn tiếp tục.",
          "examples": [
            {
              "id": "c206ab27-3455-4c37-b24a-bf6e188b9dc4",
              "zh": "他正往墙上贴着红双喜字。",
              "pinyin": "Tā zhèng wǎng qiáng shàng tiēzhe hóng shuāngxǐ zì.",
              "vi": "Anh ấy đang dán chữ song hỷ đỏ lên tường.",
              "en": "",
              "highlight": [
                "正",
                "贴着"
              ],
              "grammar_refs": [
                "grammar_q2_l15_01"
              ],
              "vocab_refs": [],
              "source_ref": "",
              "note_vi": "",
              "audio_key": "",
              "source_origin": "textbook",
              "check_needed": false
            },
            {
              "id": "fba57f64-b370-45a9-9619-45f26cda8b40",
              "zh": "她正在里面穿着衣服呢，请等一会儿。",
              "pinyin": "Tā zhèngzài lǐmiàn chuānzhe yīfu ne, qǐng děng yíhuìr.",
              "vi": "Cô ấy đang mặc quần áo ở bên trong, xin đợi một lát.",
              "en": "",
              "highlight": [
                "正在",
                "穿着"
              ],
              "grammar_refs": [
                "grammar_q2_l15_01"
              ],
              "vocab_refs": [],
              "source_ref": "",
