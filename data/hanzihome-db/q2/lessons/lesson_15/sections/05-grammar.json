            }
          ]
        },
        {
          "id": "1e038f79-51c7-4aaa-a73f-72dd8556483e",
          "type": "grammar_usage_notes",
          "order": 8,
          "title": "着 thường đi với 正在 / 正 / 在 / 呢",
          "notes_vi": [
            "正在 / 正 / 在 nhấn vào hành động đang diễn ra; 着 nhấn vào trạng thái/cách thức được duy trì.",
            "Khi đi chung, câu thường tự nhiên trong ngữ cảnh miêu tả."
          ],
          "examples": [
            {
              "id": "875aac8a-b396-440c-b8b1-9d5b9a3ec2ae",
              "zh": "里边正上着课呢。",
              "pinyin": "Lǐbian zhèng shàngzhe kè ne.",
              "vi": "Bên trong đang học đấy.",
              "en": "",
              "highlight": [
                "正",
                "上着",
                "呢"
              ],
              "grammar_refs": [
                "grammar_q2_l15_01"
              ],
              "vocab_refs": [],
              "source_ref": "",
              "note_vi": "",
              "audio_key": "",
              "source_origin": "textbook",
              "check_needed": false
            },
            {
              "id": "647d0cdd-7284-4e57-9a91-fa913eb36a02",
              "zh": "她来时，我正在躺着看书呢。",
              "pinyin": "Tā lái shí, wǒ zhèngzài tǎngzhe kàn shū ne.",
              "vi": "Khi cô ấy đến, tôi đang nằm đọc sách.",
              "en": "",
              "highlight": [
                "正在",
                "躺着",
                "呢"
              ],
              "grammar_refs": [
                "grammar_q2_l15_01"
              ],
              "vocab_refs": [],
