          "order": 4,
          "speaker": "秘书",
          "zh": "什么时候要？",
          "vi": "Khi nào cần ạ?",
          "grammar_refs": [],
          "source_origin": "textbook",
          "check_needed": false
        },
        {
          "id": "bbe94aa4-4664-4aae-bb1f-58726d1ab505",
          "order": 5,
          "speaker": "经理",
          "zh": "下午能翻译完吗？",
          "vi": "Chiều có thể dịch xong không?",
          "grammar_refs": [
            "result_complement_wan"
          ],
          "source_origin": "textbook",
          "check_needed": false
        },
        {
          "id": "6034c3ce-cdb1-4b1c-8f57-8ae57c5d6feb",
          "order": 6,
          "speaker": "秘书",
          "zh": "能。",
          "vi": "Có thể ạ.",
          "grammar_refs": [],
          "source_origin": "textbook",
          "check_needed": false
        },
        {
          "id": "ac132aae-10a0-4c37-89fc-2bd40e855cef",
          "order": 7,
          "speaker": "经理",
          "zh": "下午交给我吧。",
