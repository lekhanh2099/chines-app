          "type": "grammar_overview",
          "order": 1,
          "title": "Bản chất",
          "content_vi": "Khi một cụm chủ-vị làm định ngữ bổ nghĩa cho danh từ phía sau, thường phải thêm 的 sau cụm chủ-vị.",
          "examples": [],
          "source_origin": "textbook_generated_mixed",
          "check_needed": false
        },
        {
          "id": "3de2e20b-7535-4f1b-8355-4209acba1551",
          "type": "grammar_structure",
          "order": 2,
          "title": "Cấu trúc",
          "pattern": "主语 + 谓语 + 的 + 中心语",
          "meaning_vi": "Danh từ phía sau được bổ nghĩa bởi cả một cụm phía trước.",
          "examples": [
            {
              "id": "3620f823-6377-41e3-9821-e498d2c8ac94",
              "zh": "田芳借给你的那本书你看完了没有？",
              "vi": "Quyển sách Điền Phương cho bạn mượn, bạn đọc xong chưa?",
              "source_origin": "textbook",
              "check_needed": false
            },
            {
              "id": "02ac12b2-14cb-5c95-8a96-7816044d6f34",
              "zh": "我们现在学的词大概有一千多个。",
              "vi": "Những từ mà chúng ta hiện đang học có khoảng hơn một nghìn từ.",
              "source_origin": "textbook",
              "check_needed": false
            },
            {
              "id": "5400e4dc-2d6e-50ef-a02c-7c1d6f76bee9",
              "zh": "你要的那本书我给你买到了。",
              "vi": "Quyển sách bạn cần, tôi đã mua được cho bạn rồi.",
              "source_origin": "textbook",
              "check_needed": false
            }
          ],
          "notes_vi": [
            "Khi dịch Việt, thường đảo thành “danh từ mà ...”, không dịch máy móc theo thứ tự tiếng Trung."
          ],
          "source_origin": "textbook_generated_mixed",
          "check_needed": false
        }
