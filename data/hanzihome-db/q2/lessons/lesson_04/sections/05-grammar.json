          "type": "grammar_structure",
          "order": 2,
          "title": "Ví dụ chính",
          "pattern": "V + 上 / 成 / 到",
          "meaning_vi": "Nêu kết quả cụ thể sau hành động.",
          "examples": [
            {
              "id": "148dd5b4-2deb-4724-b898-7d508f8a6e77",
              "zh": "请合上书。",
              "vi": "Xin hãy khép sách lại.",
              "source_origin": "generated",
              "check_needed": false
            },
            {
              "id": "34fb6f43-cac8-4ca9-9004-ccfbcfc6d263",
              "zh": "我把“得”写成“的”了。",
              "vi": "Tôi viết chữ “得” thành chữ “的” rồi.",
