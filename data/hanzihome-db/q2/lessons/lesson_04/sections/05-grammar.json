            },
            {
              "id": "e32b9b44-0167-4608-818f-ad358140a4ff",
              "zh": "我找到词典了。",
              "vi": "Tôi tìm thấy từ điển rồi.",
              "source_origin": "generated",
              "check_needed": false
            }
          ],
          "notes_vi": [],
          "source_origin": "textbook_generated_mixed",
          "check_needed": false
        }
