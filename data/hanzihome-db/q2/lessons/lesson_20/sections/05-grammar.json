          "type": "grammar_structure",
          "order": 1,
          "title": "Cấu trúc",
          "pattern": "V + 得 / 不 + 下",
          "meaning_vi": "Chứa được / không chứa được, đủ chỗ / không đủ chỗ.",
          "examples": [
            {
              "id": "abb3af48-9bf2-410c-899c-ffd83c7d12ee",
              "zh": "这个剧场不大，估计坐不下一千人。",
              "vi": "Rạp hát này không lớn, ước chừng không chứa nổi một nghìn người.",
              "highlight": [
                "坐不下"
              ],
              "source_origin": "textbook",
              "check_needed": false
            },
            {
              "id": "2a29aedf-6b97-40ed-8a7d-a80bc62a8a4a",
              "zh": "这个包儿太小，装不下我的大衣。",
              "vi": "Cái túi này nhỏ quá, không nhét vừa áo khoác của tôi.",
              "highlight": [
                "装不下"
              ],
              "source_origin": "generated",
              "check_needed": false
            }
          ]
        }
      ]
    }
  ]
