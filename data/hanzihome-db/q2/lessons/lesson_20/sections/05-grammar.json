          "type": "grammar_structure",
          "order": 1,
          "title": "Cấu trúc",
          "pattern": "V + 得 / 不 + 懂 / 见 / 完 / 到 / 清楚",
          "meaning_vi": "Hành động có đạt kết quả hiểu, thấy, xong, đạt được, rõ hay không.",
          "examples": [
            {
              "id": "771ce2b4-8b49-4b48-be3a-e887eb2024df",
              "zh": "节目单上全是中文，没有英文，我看不懂。",
              "vi": "Trên tờ chương trình toàn là tiếng Trung, không có tiếng Anh, tôi xem không hiểu.",
              "highlight": [
                "看不懂"
              ],
              "source_origin": "textbook",
              "check_needed": false
            },
            {
              "id": "773f0eeb-9162-44a6-b2c7-d20f86c5bf5f",
              "zh": "坐得太远看不清楚。",
              "vi": "Ngồi xa quá thì nhìn không rõ.",
              "highlight": [
                "看不清楚"
              ],
              "source_origin": "textbook",
              "check_needed": false
            }
          ]
        }
      ]
    },
    {
      "id": "grammar_q2_l20_03",
      "type": "grammar_point",
      "order": 3,
      "title": "动词 + 得 / 不 + 了",
      "title_vi": "V + 得/不 + 了 (liǎo)",
      "level": "HSK3+",
      "tags": [
        "可能补语",
        "了"
      ],
      "source_origin": "textbook/generated_mixed",
      "check_needed": false,
      "blocks": [
        {
          "id": "3de2e20b-7535-4f1b-8355-4209acba1551",
          "type": "grammar_structure",
          "order": 1,
          "title": "Cấu trúc",
          "pattern": "V + 得 / 不 + 了",
          "meaning_vi": "Làm được / không làm được; làm nổi / không làm nổi; xảy ra được / không xảy ra được.",
          "examples": [
            {
              "id": "34e0cef7-0e8a-4e66-91ff-c118178ee232",
              "zh": "她说晚上有事，去不了。",
              "vi": "Cô ấy nói buổi tối có việc, đi không được.",
              "highlight": [
                "去不了"
              ],
              "source_origin": "textbook",
              "check_needed": false
            },
            {
              "id": "7c24a5fc-d281-4017-a211-63bd1c1f89e3",
              "zh": "这么多饺子，我吃不了。",
              "vi": "Nhiều sủi cảo thế này, tôi ăn không nổi.",
              "highlight": [
                "吃不了"
              ],
              "source_origin": "generated",
              "check_needed": false
            }
          ],
          "notes_vi": [
            "了 trong 去不了 đọc là liǎo, không phải trợ từ le."
          ]
        }
      ]
    },
