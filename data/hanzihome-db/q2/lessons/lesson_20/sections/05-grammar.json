      "type": "grammar_point",
      "order": 1,
      "title": "可能补语（一）",
      "title_vi": "Bổ ngữ khả năng (1)",
      "level": "HSK3+",
      "tags": [
        "可能补语",
        "得不补语"
      ],
      "source_origin": "textbook/generated_mixed",
      "check_needed": false,
      "blocks": [
        {
          "id": "b7c5d870-2db8-4e2e-950f-f0e6e522ac16",
          "type": "grammar_overview",
          "order": 1,
          "title": "Bản chất",
          "content_vi": "Nói hành động có đạt được kết quả hay không trong điều kiện cụ thể, không chỉ nói năng lực chung.",
          "examples": [
            {
              "id": "c6fbeb40-156e-450c-a390-d58626cae49e",
              "zh": "我看得懂，但是听不懂。",
              "vi": "Tôi xem thì hiểu, nhưng nghe thì không hiểu.",
              "highlight": [
                "看得懂",
                "听不懂"
              ],
              "source_origin": "textbook",
              "check_needed": false
            }
          ]
        },
        {
          "id": "b3534a40-3bab-464a-97dd-67889b8bcb7b",
          "type": "grammar_structure",
          "order": 2,
          "title": "Cấu trúc chính",
          "pattern": "动词 + 得 / 不 + 结果补语 / 趋向补语",
          "meaning_vi": "Làm được / không làm được; đạt / không đạt kết quả.",
          "formulas": [
            {
              "label": "肯定",
              "pattern": "V + 得 + 补语"
            },
            {
              "label": "否定",
              "pattern": "V + 不 + 补语"
            },
            {
              "label": "正反问",
              "pattern": "V + 得 + 补语 + V + 不 + 补语？"
            }
          ],
          "examples": [
            {
              "id": "d5b13929-16ec-4967-ac8a-868d80ec0b1e",
              "zh": "票好买，肯定买得到。",
              "vi": "Vé dễ mua, chắc chắn mua được.",
              "highlight": [
                "买得到"
              ],
              "source_origin": "textbook",
              "check_needed": false
            },
            {
              "id": "50b5e564-92c8-4900-b66a-00f5bfca9437",
              "zh": "我担心买不到票。",
              "vi": "Tôi lo không mua được vé.",
              "highlight": [
                "买不到"
              ],
              "source_origin": "textbook",
              "check_needed": false
            },
            {
              "id": "32ce3ad6-8de3-45db-b360-0c00996f1eef",
              "zh": "公共汽车上不去，我们只好打的。",
              "vi": "Xe buýt lên không được, chúng tôi đành phải đi taxi.",
              "highlight": [
                "上不去"
              ],
              "source_origin": "textbook",
              "check_needed": false
            }
          ],
          "notes_vi": [
            "Tân ngữ không chen giữa động từ và 得/不 + 补语.",
            "Không dùng 把字句 với 可能补语 trong phạm vi bài này."
          ]
        }
      ]
    },
    {
