    {
      "id": "1ac62b88-14d2-473e-be1e-6a588e95e535",
      "type": "communication_dialogue",
      "variant": "role_play",
      "order": 10,
      "title": "十、交际会话",
      "title_vi": "Hội thoại giao tiếp",
      "instruction": {
        "zh": "表达敬佩。",
        "vi": "Bày tỏ sự khâm phục/kính phục."
      },
      "difficulty": "normal",
      "skill_focus": [
        "speaking",
        "communication"
      ],
      "topic": "表达敬佩",
      "lines": [
        {
          "id": "ea107970-5a0a-411b-83e5-c04005684dd3",
          "order": 1,
          "speaker": "A",
          "zh": "我问你一个问题。",
          "vi": "Tôi hỏi bạn một câu nhé.",
          "pinyin": "Wǒ wèn nǐ yí ge wèntí.",
          "source_origin": "textbook",
          "check_needed": false
        },
        {
          "id": "2c50b05c-4654-433d-bd7a-2e30f9f113b2",
          "order": 2,
          "speaker": "B",
          "zh": "什么问题？问吧。",
          "vi": "Câu gì? Hỏi đi.",
          "pinyin": "Shénme wèntí? Wèn ba.",
          "source_origin": "textbook",
          "check_needed": false
        },
        {
          "id": "9c7a89a4-1971-4a66-80b5-d4a6a75ec3c5",
          "order": 3,
          "speaker": "A",
          "zh": "要是一边放着真理，一边放着金钱，要你只选一样的话，你选什么？",
          "vi": "Nếu một bên là chân lý, một bên là tiền bạc, bắt bạn chỉ chọn một thứ thì bạn chọn gì?",
          "pinyin": "Yàoshi yìbiān fàngzhe zhēnlǐ, yìbiān fàngzhe jīnqián, yào nǐ zhǐ xuǎn yí yàng dehuà, nǐ xuǎn shénme?",
          "source_origin": "textbook",
          "check_needed": false
        },
        {
          "id": "b8bdd500-1f63-47b5-8282-0e8f4c544191",
          "order": 4,
          "speaker": "B",
          "zh": "我选金钱。",
          "vi": "Tôi chọn tiền.",
          "pinyin": "Wǒ xuǎn jīnqián.",
          "source_origin": "textbook",
          "check_needed": false
        },
        {
          "id": "12e0ad7b-c944-4a96-b740-052a8e2ef21d",
          "order": 5,
          "speaker": "A",
          "zh": "为什么？",
          "vi": "Vì sao?",
          "pinyin": "Wèishénme?",
          "source_origin": "textbook",
          "check_needed": false
        },
        {
          "id": "69d038ab-59c0-40db-818e-62ec2331f6d7",
          "order": 6,
          "speaker": "B",
          "zh": "因为我已经有很多真理了，现在最缺的就是金钱。",
          "vi": "Vì tôi đã có rất nhiều chân lý rồi, hiện tại thiếu nhất là tiền.",
          "pinyin": "Yīnwèi wǒ yǐjīng yǒu hěn duō zhēnlǐ le, xiànzài zuì quē de jiù shì jīnqián.",
          "source_origin": "textbook",
          "check_needed": false
        },
        {
          "id": "749a1bc0-e1d3-44a0-81ce-8c9d74f11541",
          "order": 7,
          "speaker": "A",
          "zh": "你又开玩笑。可是人家彭艺云小姐就选择了真理。我觉得彭小姐真了不起。在她身上有种东西最重要也最叫人敬佩。",
          "vi": "Bạn lại đùa rồi. Nhưng cô Bành Nghệ Vân chọn chân lý. Tôi thấy cô Bành thật đáng nể. Ở cô ấy có một thứ quan trọng nhất và khiến người ta khâm phục nhất.",
          "pinyin": "Nǐ yòu kāi wánxiào. Kěshì rénjia Péng Yìyún xiǎojiě jiù xuǎnzé le zhēnlǐ. Wǒ juéde Péng xiǎojiě zhēn liǎobuqǐ. Zài tā shēn shang yǒu zhǒng dōngxi zuì zhòngyào yě zuì jiào rén jìngpèi.",
          "source_origin": "textbook",
          "check_needed": false
        },
        {
          "id": "7836fd57-6338-471d-b783-b91fae527f13",
          "order": 8,
          "speaker": "B",
          "zh": "什么东西？",
          "vi": "Thứ gì?",
          "pinyin": "Shénme dōngxi?",
          "source_origin": "textbook",
          "check_needed": false
        },
        {
          "id": "09087044-3471-4c3a-926a-bd4e4a0c8d03",
          "order": 9,
          "speaker": "A",
          "zh": "一是坚持真理的态度。为了科学，不违心地赞成别人的观点，即使得不到奖学金她也不在乎。",
          "vi": "Thứ nhất là thái độ kiên trì chân lý. Vì khoa học, cô ấy không trái lòng tán thành quan điểm của người khác; dù không lấy được học bổng cũng không để tâm.",
          "pinyin": "Yī shì jiānchí zhēnlǐ de tàidu. Wèile kēxué, bù wéixīn de zànchéng biéren de guāndiǎn, jíshǐ dé bu dào jiǎngxuéjīn tā yě bù zàihu.",
          "source_origin": "textbook",
          "check_needed": false
        },
        {
          "id": "d0172089-58a4-44c2-aacb-53de3debc63a",
          "order": 10,
          "speaker": "B",
          "zh": "一个追求真理的人不会把金钱看成人生最重要的东西，尽管她也特别需要钱。但是如果需要她在真理和金钱之间选择一样的话，她会毫不犹豫地选择前者。我想，这就是一个科学家的品格。",
          "vi": "Người theo đuổi chân lý sẽ không xem tiền là thứ quan trọng nhất đời người, dù cô ấy cũng rất cần tiền. Nhưng nếu cần cô ấy chọn giữa chân lý và tiền, cô ấy sẽ không do dự chọn cái trước. Tôi nghĩ đó chính là phẩm chất của một nhà khoa học.",
          "pinyin": "Yí ge zhuīqiú zhēnlǐ de rén bú huì bǎ jīnqián kànchéng rénshēng zuì zhòngyào de dōngxi, jǐnguǎn tā yě tèbié xūyào qián. Dànshì rúguǒ xūyào tā zài zhēnlǐ hé jīnqián zhījiān xuǎnzé yí yàng dehuà, tā huì háo bù yóuyù de xuǎnzé qiánzhě. Wǒ xiǎng, zhè jiù shì yí ge kēxuéjiā de pǐngé.",
          "source_origin": "textbook",
          "check_needed": false
        },
        {
          "id": "2bb52de0-12a1-4d3b-b3aa-e4c98abc23f2",
          "order": 11,
          "speaker": "A",
          "zh": "二是她的自信和良好的心理素质。",
          "vi": "Thứ hai là sự tự tin và tố chất tâm lý tốt của cô ấy.",
          "pinyin": "Èr shì tā de zìxìn hé liánghǎo de xīnlǐ sùzhì.",
          "source_origin": "textbook",
          "check_needed": false
        },
        {
          "id": "bf60d655-3fe4-4a78-a3ac-b30c1249cf30",
          "order": 12,
          "speaker": "B",
          "zh": "自信是成功的首要条件，良好的心理素质对一个心理学家来说简直太重要了。",
          "vi": "Tự tin là điều kiện hàng đầu của thành công; tố chất tâm lý tốt đối với một nhà tâm lý học thật sự quá quan trọng.",
          "pinyin": "Zìxìn shì chénggōng de shǒuyào tiáojiàn, liánghǎo de xīnlǐ sùzhì duì yí ge xīnlǐxuéjiā lái shuō jiǎnzhí tài zhòngyào le.",
          "source_origin": "textbook",
          "check_needed": false
        },
        {
          "id": "88430d98-6a09-4658-bf12-2a42dd2f69e9",
          "order": 13,
          "speaker": "A",
          "zh": "可以肯定，彭小姐将会成为一个优秀的心理学家。",
          "vi": "Có thể khẳng định cô Bành sẽ trở thành một nhà tâm lý học ưu tú.",
          "pinyin": "Kěyǐ kěndìng, Péng xiǎojiě jiāng huì chéngwéi yí ge yōuxiù de xīnlǐxuéjiā.",
          "source_origin": "textbook",
          "check_needed": false
        },
        {
          "id": "30ab8d68-abb2-4b4f-bc5c-c36da0a0cb8c",
          "order": 14,
          "speaker": "B",
          "zh": "名师出高徒嘛！",
          "vi": "Danh sư xuất cao đồ mà!",
          "pinyin": "Míng shī chū gāo tú ma!",
          "source_origin": "textbook",
          "check_needed": false
        },
        {
          "id": "e1bda459-be16-4d63-9c37-d3da9c68f598",
          "order": 15,
          "speaker": "A",
          "zh": "我也很敬佩阿加尔教授，佩服他的大度、胸怀开阔。有这样的教授指导真是幸运。",
          "vi": "Tôi cũng rất kính phục giáo sư Archer, khâm phục sự độ lượng và tấm lòng rộng mở của ông ấy. Có giáo sư như vậy hướng dẫn thật may mắn.",
          "pinyin": "Wǒ yě hěn jìngpèi Ājiā'ěr jiàoshòu, pèifu tā de dàdù, xiōnghuái kāikuò. Yǒu zhèyàng de jiàoshòu zhǐdǎo zhēn shì xìngyùn.",
          "source_origin": "textbook",
          "check_needed": false
        }
      ],
