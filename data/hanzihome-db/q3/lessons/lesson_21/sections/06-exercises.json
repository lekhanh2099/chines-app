            {
              "id": "1f523168-1c6e-4db9-abc5-198d4ccace2b",
              "text": "先天下之忧而忧，后天下之乐而乐。",
              "pinyin": "Xiān tiānxià zhī yōu ér yōu, hòu tiānxià zhī lè ér lè.",
              "vi": "Lo trước cái lo của thiên hạ, vui sau cái vui của thiên hạ."
            }
          ]
        }
