            {
              "id": "7ccdc8f9-59f3-4c7b-bd28-247acb68c535",
              "zh": "这个地方的确很漂亮。",
              "pinyin": "Zhè ge dìfang díquè hěn piàoliang.",
              "vi": "Nơi này đúng là rất đẹp.",
              "en": "",
              "highlight": [
                "的确"
              ],
              "grammar_refs": [
                "f8ec59f3-898a-47b2-b536-44dfd8183393"
              ],
              "vocab_refs": [],
              "source_ref": "",
              "note_vi": "",
