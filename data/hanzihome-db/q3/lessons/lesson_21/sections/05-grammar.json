              "source_origin": "textbook_pdf_checked",
              "check_needed": false
            },
            {
              "id": "d84397d0-7b22-492a-a594-cb58d4dd46e0",
              "zh": "他的的确确是个好心人。",
              "pinyin": "Tā dídiquèquè shì ge hǎoxīnrén.",
              "vi": "Anh ấy thật sự là một người tốt.",
              "en": "",
              "highlight": [
                "的确"
              ],
              "grammar_refs": [
                "f8ec59f3-898a-47b2-b536-44dfd8183393"
              ],
              "vocab_refs": [],
              "source_ref": "",
              "note_vi": "",
              "audio_key": "",
              "source_origin": "textbook_pdf_checked",
              "check_needed": false
            },
            {
              "id": "grammar_deque_pdf_ex_001",
              "zh": "这次来中国留学的经历的确很难忘。",
              "pinyin": "Zhè cì lái Zhōngguó liúxué de jīnglì díquè hěn nánwàng.",
              "vi": "Trải nghiệm đến Trung Quốc du học lần này quả thật rất khó quên.",
              "en": "",
              "highlight": [
                "的确"
              ],
              "grammar_refs": [
                "f8ec59f3-898a-47b2-b536-44dfd8183393"
              ],
              "vocab_refs": [],
              "source_ref": "",
              "note_vi": "",
              "audio_key": "",
              "source_origin": "textbook_pdf_checked",
              "check_needed": false
            },
            {
              "id": "grammar_deque_pdf_ex_002",
              "zh": "我的确/实在不知道他的情况。",
              "pinyin": "Wǒ díquè / shízài bù zhīdào tā de qíngkuàng.",
              "vi": "Tôi thật sự không biết tình hình của anh ấy.",
              "en": "",
              "highlight": [
                "的确",
                "实在"
              ],
              "grammar_refs": [
                "f8ec59f3-898a-47b2-b536-44dfd8183393"
              ],
              "vocab_refs": [],
              "source_ref": "",
              "note_vi": "PDF dùng câu này để so sánh 的确 và 实在: cả hai đều có thể làm trạng ngữ.",
              "audio_key": "",
              "source_origin": "textbook_pdf_checked",
              "check_needed": false
            },
            {
              "id": "grammar_deque_pdf_ex_003",
              "zh": "手机微信的确/实在太方便了。",
              "pinyin": "Shǒujī Wēixìn díquè / shízài tài fāngbiàn le.",
              "vi": "WeChat trên điện thoại thật sự quá tiện.",
              "en": "",
              "highlight": [
                "的确",
                "实在"
              ],
              "grammar_refs": [
                "f8ec59f3-898a-47b2-b536-44dfd8183393"
              ],
              "vocab_refs": [],
              "source_ref": "",
              "note_vi": "",
              "audio_key": "",
              "source_origin": "textbook_pdf_checked",
              "check_needed": false
            },
            {
              "id": "grammar_deque_pdf_ex_004",
              "zh": "实在/*的确抱歉，我把这件事忘了。",
              "pinyin": "Shízài / *díquè bàoqiàn, wǒ bǎ zhè jiàn shì wàng le.",
              "vi": "Thành thật xin lỗi, tôi quên mất việc này.",
              "en": "",
              "highlight": [
                "实在",
                "的确"
              ],
              "grammar_refs": [
                "f8ec59f3-898a-47b2-b536-44dfd8183393"
              ],
              "vocab_refs": [],
              "source_ref": "",
              "note_vi": "抱歉 ở đây là lời xin lỗi mang sắc thái chủ quan; dùng 实在 tự nhiên hơn 的确.",
              "audio_key": "",
              "source_origin": "textbook_pdf_checked",
              "check_needed": false
            },
            {
              "id": "grammar_deque_pdf_ex_005",
              "zh": "这的的确确/*实实在在是两千年前的文物。",
              "pinyin": "Zhè dídiquèquè / *shíshízàizài shì liǎng qiān nián qián de wénwù.",
              "vi": "Đây đích thực là văn vật của hai nghìn năm trước.",
              "en": "",
              "highlight": [
                "的的确确"
              ],
              "grammar_refs": [
                "f8ec59f3-898a-47b2-b536-44dfd8183393"
              ],
              "vocab_refs": [],
              "source_ref": "",
              "note_vi": "PDF nhấn mạnh dạng lặp tự nhiên là 的的确确.",
              "audio_key": "",
              "source_origin": "textbook_pdf_checked",
              "check_needed": false
            },
            {
              "id": "grammar_deque_pdf_ex_006",
              "zh": "他的确/*实在是这么答应我的。",
              "pinyin": "Tā díquè / *shízài shì zhème dāying wǒ de.",
              "vi": "Anh ấy đúng là đã hứa với tôi như vậy.",
              "en": "",
              "highlight": [
                "的确",
                "实在"
              ],
              "grammar_refs": [
                "f8ec59f3-898a-47b2-b536-44dfd8183393"
              ],
              "vocab_refs": [],
              "source_ref": "",
              "note_vi": "Khi xác nhận sự thật khách quan, 的确 tự nhiên hơn 实在.",
              "audio_key": "",
              "source_origin": "textbook_pdf_checked",
              "check_needed": false
            }
          ],
          "notes_vi": [
            "PDF so sánh 的确 với 实在: 的确 thiên về xác nhận khách quan; 实在 thường thiên về cảm nhận chủ quan hoặc mức độ.",
            "Dạng lặp của 的确 là 的的确确."
          ],
          "source_origin": "textbook_pdf_checked",
          "check_needed": false
        }
      ]
    },
