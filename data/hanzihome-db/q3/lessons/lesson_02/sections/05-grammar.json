      "blocks": [
        {
          "id": "470b1ca1-e0a1-449f-b55e-a8aa481a4dd4",
          "type": "grammar_overview",
          "order": 1,
          "title": "Bản chất",
          "content_vi": "Trong bài này nghĩa là lần lượt / riêng rẽ; dùng khi nhiều người/vật làm việc riêng hoặc đến từ các nơi khác nhau.",
          "examples": [
            {
              "id": "148dd5b4-2deb-4724-b898-7d508f8a6e77",
              "zh": "我们班的同学分别来自亚洲、非洲、美洲、大洋洲等。",
              "pinyin": "",
              "vi": "Các bạn trong lớp chúng tôi lần lượt đến từ châu Á, châu Phi, châu Mỹ, châu Đại Dương, v.v.",
              "en": "",
              "highlight": [],
              "grammar_refs": [],
              "vocab_refs": [],
              "source_origin": "textbook/generated_mixed",
              "check_needed": false
            },
            {
              "id": "34fb6f43-cac8-4ca9-9004-ccfbcfc6d263",
              "zh": "他们分别介绍了自己的情况。",
              "pinyin": "",
              "vi": "Họ lần lượt giới thiệu tình hình của mình.",
              "en": "",
