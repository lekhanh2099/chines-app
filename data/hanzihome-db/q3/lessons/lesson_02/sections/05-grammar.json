          "title": "Bản chất",
          "content_vi": "Dựa vào / nhờ vào ai hoặc cái gì để sống, làm việc, đạt mục đích hoặc giải quyết vấn đề.",
          "examples": [
            {
              "id": "2e38466f-cc5f-451a-9612-b188f7cd2dcf",
              "zh": "在家靠父母，出门靠朋友。",
              "pinyin": "",
              "vi": "Ở nhà dựa vào cha mẹ, ra ngoài dựa vào bạn bè.",
              "en": "",
              "highlight": [],
              "grammar_refs": [],
              "vocab_refs": [],
              "source_origin": "textbook/generated_mixed",
              "check_needed": false
            },
