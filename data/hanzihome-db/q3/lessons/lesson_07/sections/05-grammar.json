          "title": "Cấu trúc chính",
          "pattern": "任何 + 名词 (+ 都/也/不/没有...)",
          "meaning_vi": "Bất kỳ người/việc/nơi/lý do nào.",
          "examples": [
            {
              "id": "771ce2b4-8b49-4b48-be3a-e887eb2024df",
              "zh": "我也会吹竽，而且吹得不比他们中的任何一位差。",
              "vi": "Tôi cũng biết thổi竽, hơn nữa thổi không kém bất kỳ ai trong số họ.",
              "source_origin": "textbook/generated_mixed",
              "check_needed": false,
              "pinyin": "Wǒ yě huì chuī yú, érqiě chuī de bù bǐ tāmen zhōng de rènhé yí wèi chà."
            },
            {
              "id": "773f0eeb-9162-44a6-b2c7-d20f86c5bf5f",
              "zh": "任何人都不能进去。",
              "vi": "Bất kỳ ai cũng không được vào.",
              "source_origin": "textbook/generated_mixed",
              "check_needed": false,
              "pinyin": "Rènhé rén dōu bù néng jìnqu."
            }
          ],
          "notes_vi": [],
          "source_origin": "textbook/generated_mixed",
          "check_needed": false
        }
      ]
    },
