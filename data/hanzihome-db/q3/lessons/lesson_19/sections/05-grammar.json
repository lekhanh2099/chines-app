      "blocks": [
        {
          "id": "grammar_003_overview",
          "type": "grammar_overview",
          "order": 1,
          "title": "Bản chất",
          "content_vi": "Với động lượng từ, mẫu này biểu thị hành động lặp đi lặp lại nhiều lần; với danh lượng từ, biểu thị số lượng nhiều nối tiếp.",
          "examples": [
            {
              "id": "g003_ex001",
              "zh": "我一次又一次地受到被拒绝的打击。",
              "pinyin": "Wǒ yí cì yòu yí cì de shòudào bèi jùjué de dǎjī.",
              "vi": "Tôi hết lần này đến lần khác chịu cú sốc bị từ chối.",
              "highlight": [
                "一次又一次"
              ],
              "grammar_refs": [],
              "vocab_refs": [],
