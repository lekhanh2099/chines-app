    {
      "id": "grammar_q3_l19_02",
      "type": "grammar_point",
      "order": 2,
      "title": "不得不",
      "title_vi": "Buộc phải / không thể không",
      "level": "HSK3+",
      "tags": [
        "词语用法"
      ],
      "source_origin": "textbook_pdf_checked",
      "check_needed": false,
      "blocks": [
        {
          "id": "grammar_002_overview",
          "type": "grammar_overview",
          "order": 1,
          "title": "Bản chất",
          "content_vi": "Diễn tả làm việc gì không phải do tự nguyện mà vì không còn cách nào khác; mạnh hơn 只好.",
          "examples": [
            {
              "id": "g002_ex001",
              "zh": "为了生活，我又不得不再三去求职。",
              "pinyin": "Wèile shēnghuó, wǒ yòu bùdébù zàisān qù qiúzhí.",
              "vi": "Vì cuộc sống, tôi lại buộc phải nhiều lần đi xin việc.",
              "highlight": [
                "不得不"
              ],
              "grammar_refs": [],
              "vocab_refs": [],
              "source_ref": "",
              "audio_key": "",
              "source_origin": "textbook_pdf_checked",
              "check_needed": false
            },
            {
              "id": "g002_ex002",
              "zh": "因为母亲生病住院，我不得不回国。",
              "pinyin": "Yīnwèi mǔqīn shēngbìng zhùyuàn, wǒ bùdébù huíguó.",
              "vi": "Vì mẹ bị bệnh nhập viện, tôi buộc phải về nước.",
              "highlight": [
                "不得不"
              ],
              "grammar_refs": [],
              "vocab_refs": [],
              "source_ref": "",
              "audio_key": "",
              "source_origin": "textbook_pdf_checked",
              "check_needed": false
            }
          ],
          "source_origin": "textbook_pdf_checked",
          "check_needed": false
        },
        {
          "id": "grammar_002_structure",
          "type": "grammar_structure",
          "order": 2,
          "title": "Cấu trúc",
          "pattern": "不得不 + 动词 / 动词短语",
          "meaning_vi": "Diễn tả làm việc gì không phải do tự nguyện mà vì không còn cách nào khác; mạnh hơn 只好.",
          "examples": [],
          "source_origin": "textbook_pdf_checked",
          "check_needed": false
        },
        {
          "id": "grammar_002_notes",
          "type": "grammar_usage_notes",
          "order": 3,
          "title": "Lưu ý",
          "notes_vi": [
            "Không dùng 不得不 trực tiếp trước phủ định kiểu 不得不不去; nếu cần phủ định, thường dùng 只好不去."
          ],
          "examples": [],
          "source_origin": "textbook_pdf_checked",
          "check_needed": false
        }
      ],
      "legacy_ids": [
        "grammar_q3_l19_02"
      ]
