    {
      "id": "grammar_q3_l19_01",
      "type": "grammar_point",
      "order": 1,
      "title": "受 / 受到",
      "title_vi": "Động từ 受 / 受到: nhận, chịu, gặp phải",
      "level": "HSK3+",
      "tags": [
        "词语用法"
      ],
      "source_origin": "textbook_pdf_checked",
      "check_needed": false,
      "blocks": [
        {
          "id": "grammar_001_overview",
          "type": "grammar_overview",
          "order": 1,
          "title": "Bản chất",
          "content_vi": "Khi là nghĩa tốt: nhận được; khi là nghĩa xấu: chịu/gặp phải tác động.",
          "examples": [
            {
              "id": "g001_ex001",
              "zh": "我在找工作时受到歧视。",
              "pinyin": "Wǒ zài zhǎo gōngzuò shí shòudào qíshì.",
              "vi": "Tôi bị kỳ thị khi tìm việc.",
              "highlight": [
                "受到"
              ],
              "grammar_refs": [],
              "vocab_refs": [],
              "source_ref": "",
              "audio_key": "",
              "source_origin": "textbook_pdf_checked",
              "check_needed": false
            },
            {
              "id": "g001_ex002",
              "zh": "他从小就受到了很好的教育。",
              "pinyin": "Tā cóng xiǎo jiù shòudào le hěn hǎo de jiàoyù.",
              "vi": "Anh ấy từ nhỏ đã được giáo dục rất tốt.",
              "highlight": [
                "受到了"
              ],
              "grammar_refs": [],
              "vocab_refs": [],
              "source_ref": "",
              "audio_key": "",
              "source_origin": "textbook_pdf_checked",
              "check_needed": false
            }
          ],
          "source_origin": "textbook_pdf_checked",
          "check_needed": false
        },
        {
          "id": "grammar_001_structure",
          "type": "grammar_structure",
          "order": 2,
          "title": "Cấu trúc",
          "pattern": "受 / 受到 + 名词 / 动词性短语",
          "meaning_vi": "Khi là nghĩa tốt: nhận được; khi là nghĩa xấu: chịu/gặp phải tác động.",
          "examples": [],
          "source_origin": "textbook_pdf_checked",
          "check_needed": false
        },
        {
          "id": "grammar_001_notes",
          "type": "grammar_usage_notes",
          "order": 3,
          "title": "Lưu ý",
          "notes_vi": [
            "受 / 受到 không phải lúc nào cũng tiêu cực; phải xem tân ngữ phía sau."
          ],
          "examples": [],
          "source_origin": "textbook_pdf_checked",
          "check_needed": false
