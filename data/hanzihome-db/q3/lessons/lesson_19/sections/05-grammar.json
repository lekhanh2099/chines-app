    {
      "id": "grammar_q3_l19_03",
      "type": "grammar_point",
      "order": 3,
      "title": "一次又一次",
      "title_vi": "Hết lần này đến lần khác",
      "level": "HSK3+",
      "tags": [
        "词语用法"
