{
  "id": "b045e537-7383-494b-8d61-b0286977ed80",
  "type": "grammar",
  "order": 5,
  "title": "词语用法",
  "title_vi": "Cách dùng từ / Ngữ pháp",
  "source_origin": "textbook",
  "check_needed": false,
  "items": [
    {
      "id": "grammar_q3_l23_01",
      "type": "grammar_point",
      "order": 1,
      "title": "有关",
      "title_vi": "có liên quan; liên quan đến",
      "level": "HSK3+",
      "tags": [
        "词语用法"
      ],
      "source_origin": "textbook",
      "check_needed": false,
      "blocks": [
        {
          "id": "b7c5d870-2db8-4e2e-950f-f0e6e522ac16",
          "type": "grammar_overview",
          "order": 1,
          "title": "Bản chất",
          "content_vi": "有关 biểu thị sự liên quan. Trong bài dùng được như động từ hoặc giới từ.",
          "examples": []
        },
        {
          "id": "a85d60ae-5a59-4bad-a730-4e11cd8fd4ed",
          "type": "grammar_structure",
          "order": 2,
          "title": "有关 làm động từ",
          "pattern": "A 跟/和/与/同 B 有关",
          "meaning_vi": "A có liên quan đến B.",
          "examples": [
            {
              "id": "2e38466f-cc5f-451a-9612-b188f7cd2dcf",
              "zh": "这件事跟他无关。",
              "pinyin": "Zhè jiàn shì gēn tā wúguān.",
              "vi": "Việc này không liên quan đến anh ấy.",
              "en": "",
              "highlight": [
                "有关"
              ],
              "grammar_refs": [],
              "vocab_refs": [],
              "source_ref": "",
              "note_vi": "",
              "audio_key": "",
              "source_origin": "textbook",
              "check_needed": false
            },
            {
              "id": "64dc50f6-13c5-4723-9aed-94e0d978cb90",
              "zh": "发生环境污染问题与他们厂不重视环境保护有关。",
              "pinyin": "Fāshēng huánjìng wūrǎn wèntí yǔ tāmen chǎng bù zhòngshì huánjìng bǎohù yǒuguān.",
              "vi": "Việc xảy ra vấn đề ô nhiễm môi trường có liên quan đến chuyện nhà máy của họ không coi trọng bảo vệ môi trường.",
              "en": "",
              "highlight": [
                "有关"
              ],
              "grammar_refs": [],
              "vocab_refs": [],
              "source_ref": "",
              "note_vi": "",
              "audio_key": "",
              "source_origin": "textbook",
              "check_needed": false
            }
          ],
          "notes_vi": [
            "Trái nghĩa thường gặp: 无关."
          ]
        },
        {
          "id": "ca8c13db-9de3-46b8-a156-5be7570386a5",
          "type": "grammar_structure",
          "order": 3,
          "title": "有关 làm giới từ",
          "pattern": "有关 + danh từ/cụm danh từ",
          "meaning_vi": "về / liên quan đến một chủ đề hoặc phương diện nào đó.",
          "examples": [
            {
              "id": "b7a3d982-8f73-4ed4-b3d6-828fba6e2949",
              "zh": "他在网上查了一些有关中国经济的资料。",
              "pinyin": "Tā zài wǎngshàng chá le yìxiē yǒuguān Zhōngguó jīngjì de zīliào.",
              "vi": "Anh ấy tra trên mạng một số tài liệu liên quan đến kinh tế Trung Quốc.",
              "en": "",
              "highlight": [
                "有关"
              ],
              "grammar_refs": [],
              "vocab_refs": [],
              "source_ref": "",
              "note_vi": "",
              "audio_key": "",
              "source_origin": "textbook",
              "check_needed": false
            },
            {
              "id": "7aa9ef46-6f3d-4ea1-b0f6-1ba89dd9b81b",
              "zh": "张教授要开办一个有关国际关系的讲座。",
              "pinyin": "Zhāng jiàoshòu yào kāibàn yí ge yǒuguān guójì guānxi de jiǎngzuò.",
              "vi": "Giáo sư Trương muốn mở một buổi tọa đàm liên quan đến quan hệ quốc tế.",
              "en": "",
              "highlight": [
                "有关"
              ],
              "grammar_refs": [],
              "vocab_refs": [],
              "source_ref": "",
              "note_vi": "",
              "audio_key": "",
              "source_origin": "textbook",
              "check_needed": false
            }
          ],
          "notes_vi": [
            "Gần nghĩa với 关于, nhưng 有关 thường đi sát danh từ làm định ngữ."
          ]
        }
      ],
      "legacy_ids": [
        "grammar_q3_l23_01"
      ]
    },
    {
      "id": "grammar_q3_l23_02",
      "type": "grammar_point",
      "order": 2,
      "title": "不是……，而是……",
      "title_vi": "không phải…, mà là…",
      "level": "HSK3+",
      "tags": [
        "词语用法",
        "并列关系"
      ],
      "source_origin": "textbook",
      "check_needed": false,
      "blocks": [
        {
          "id": "470b1ca1-e0a1-449f-b55e-a8aa481a4dd4",
          "type": "grammar_overview",
          "order": 1,
          "title": "Bản chất",
          "content_vi": "Dùng để phủ định một cách hiểu sai ở vế trước, rồi khẳng định cách hiểu đúng ở vế sau.",
          "examples": []
        },
        {
          "id": "0ef2b790-3209-4b5c-a519-ca5a424e4d49",
          "type": "grammar_structure",
          "order": 2,
          "title": "Cấu trúc chính",
          "pattern": "不是 A，而是 B",
          "meaning_vi": "Không phải A, mà là B.",
          "examples": [
            {
              "id": "148dd5b4-2deb-4724-b898-7d508f8a6e77",
              "zh": "新时代网校不是只学电脑，而是通过电脑，在多媒体的环境下，学习各种现代科学文化知识。",
              "pinyin": "Xīn Shídài Wǎngxiào bú shì zhǐ xué diànnǎo, ér shì tōngguò diànnǎo, zài duōméitǐ de huánjìng xià, xuéxí gè zhǒng xiàndài kēxué wénhuà zhīshi.",
              "vi": "Trường học trực tuyến Thời Đại Mới không phải chỉ học máy tính, mà là thông qua máy tính, trong môi trường đa phương tiện để học các loại kiến thức khoa học văn hóa hiện đại.",
              "en": "",
              "highlight": [
                "不是",
                "而是"
              ],
              "grammar_refs": [],
              "vocab_refs": [],
              "source_ref": "p003",
              "note_vi": "",
              "audio_key": "",
              "source_origin": "textbook",
              "check_needed": false
            },
            {
              "id": "34fb6f43-cac8-4ca9-9004-ccfbcfc6d263",
              "zh": "不是我不愿意去，而是没有时间。",
              "pinyin": "Bú shì wǒ bú yuànyì qù, ér shì méiyǒu shíjiān.",
              "vi": "Không phải tôi không muốn đi, mà là không có thời gian.",
              "en": "",
              "highlight": [
                "不是",
                "而是"
              ],
              "grammar_refs": [],
              "vocab_refs": [],
              "source_ref": "",
              "note_vi": "",
              "audio_key": "",
              "source_origin": "textbook",
              "check_needed": false
            }
          ],
          "notes_vi": [
            "不是 A: bác bỏ A.",
            "而是 B: khẳng định B mới đúng."
          ]
        }
      ],
      "legacy_ids": [
        "grammar_q3_l23_02"
      ]
    },
    {
      "id": "grammar_q3_l23_03",
      "type": "grammar_point",
      "order": 3,
      "title": "通过",
      "title_vi": "đi qua; thông qua",
      "level": "HSK3+",
      "tags": [
        "词语用法"
      ],
      "source_origin": "textbook",
      "check_needed": false,
      "blocks": [
        {
          "id": "50dcd503-1832-4112-a0be-e09408954b90",
          "type": "grammar_overview",
          "order": 1,
          "title": "Bản chất",
          "content_vi": "通过 có thể làm động từ nghĩa là đi qua, hoặc giới từ nghĩa là thông qua phương tiện/cách thức/người trung gian để đạt mục đích.",
          "examples": []
        },
        {
          "id": "6b417a86-ee99-4c94-b342-c9bff5f564c5",
          "type": "grammar_structure",
          "order": 2,
          "title": "通过 làm động từ",
          "pattern": "通过 + địa điểm/chỗ nào đó",
          "meaning_vi": "Đi qua, thông qua một nơi.",
          "examples": [
            {
              "id": "3620f823-6377-41e3-9821-e498d2c8ac94",
              "zh": "从这儿到那儿去，必须通过这座桥。",
              "pinyin": "Cóng zhèr dào nàr qù, bìxū tōngguò zhè zuò qiáo.",
              "vi": "Từ đây đến đó, nhất định phải đi qua cây cầu này.",
              "en": "",
              "highlight": [
                "通过"
              ],
              "grammar_refs": [],
              "vocab_refs": [],
              "source_ref": "",
              "note_vi": "",
              "audio_key": "",
              "source_origin": "textbook",
              "check_needed": false
            },
            {
              "id": "67dbf307-9e3e-454a-9d27-30b827684ec9",
              "zh": "前面的路太窄了，汽车无法通过。",
              "pinyin": "Qiánmiàn de lù tài zhǎi le, qìchē wúfǎ tōngguò.",
              "vi": "Con đường phía trước quá hẹp, xe ô tô không thể đi qua.",
              "en": "",
              "highlight": [
                "通过"
              ],
              "grammar_refs": [],
              "vocab_refs": [],
              "source_ref": "",
              "note_vi": "",
              "audio_key": "",
              "source_origin": "textbook",
              "check_needed": false
            }
          ],
          "notes_vi": []
        },
        {
          "id": "d0e5a393-126f-4376-9fcb-f6cf84482c86",
          "type": "grammar_structure",
          "order": 3,
          "title": "通过 làm giới từ",
          "pattern": "通过 + phương tiện/cách thức/người trung gian + VP",
          "meaning_vi": "Thông qua một phương tiện, cách thức hoặc người trung gian để làm gì.",
          "examples": [
            {
              "id": "d3ca42bf-fbbd-4347-98a8-7a697fe218c2",
              "zh": "通过近一年的学习，我已经能用汉语跟中国人谈话了。",
              "pinyin": "Tōngguò jìn yì nián de xuéxí, wǒ yǐjīng néng yòng Hànyǔ gēn Zhōngguó rén tánhuà le.",
              "vi": "Thông qua gần một năm học tập, tôi đã có thể dùng tiếng Hán nói chuyện với người Trung Quốc rồi.",
              "en": "",
              "highlight": [
                "通过"
              ],
              "grammar_refs": [],
              "vocab_refs": [],
              "source_ref": "",
              "note_vi": "",
              "audio_key": "",
              "source_origin": "textbook",
              "check_needed": false
            },
            {
              "id": "8a5a1327-5977-406d-b2eb-0873fdcdff0b",
              "zh": "通过小田的介绍我认识了小张。",
              "pinyin": "Tōngguò Xiǎo Tián de jièshào wǒ rènshi le Xiǎo Zhāng.",
              "vi": "Thông qua sự giới thiệu của Tiểu Điền, tôi quen Tiểu Trương.",
              "en": "",
              "highlight": [
                "通过"
              ],
              "grammar_refs": [],
              "vocab_refs": [],
              "source_ref": "",
              "note_vi": "",
              "audio_key": "",
              "source_origin": "textbook",
              "check_needed": false
            }
          ],
          "notes_vi": []
        }
      ],
      "legacy_ids": [
        "grammar_q3_l23_03"
      ]
    },
    {
      "id": "grammar_q3_l23_04",
      "type": "grammar_point",
      "order": 4,
      "title": "适合",
      "title_vi": "phù hợp; thích hợp",
      "level": "HSK3+",
      "tags": [
        "词语用法"
      ],
      "source_origin": "textbook",
      "check_needed": false,
      "blocks": [
        {
          "id": "6b109e8c-3e57-466f-89ea-5e3dd68f03d9",
          "type": "grammar_overview",
          "order": 1,
          "title": "Bản chất",
          "content_vi": "适合 nghĩa là phù hợp với tình hình thực tế hoặc yêu cầu khách quan; có thể mang tân ngữ là danh từ, đại từ, động từ hoặc tiểu cú, và có thể được bổ nghĩa bởi phó từ mức độ.",
          "examples": []
        },
        {
          "id": "3ecf1989-24b0-4088-8831-c92b1fd6d541",
          "type": "grammar_structure",
          "order": 2,
          "title": "Cấu trúc chính",
          "pattern": "A 适合 B",
          "meaning_vi": "A phù hợp với B.",
          "examples": [
            {
              "id": "4c24a67d-5112-438c-96a0-1fe26e7867ad",
              "zh": "学生可以选择适合自己程度的教材和自己喜欢的教师。",
              "pinyin": "Xuéshēng kěyǐ xuǎnzé shìhé zìjǐ chéngdù de jiàocái hé zìjǐ xǐhuan de jiàoshī.",
              "vi": "Học sinh có thể chọn tài liệu phù hợp với trình độ của mình và giáo viên mình thích.",
              "en": "",
              "highlight": [
                "适合"
              ],
              "grammar_refs": [],
              "vocab_refs": [],
              "source_ref": "p007",
              "note_vi": "",
              "audio_key": "",
              "source_origin": "textbook",
              "check_needed": false
            },
            {
              "id": "857c43af-3f3e-491c-988c-f6e69807c407",
              "zh": "这个菜比较清淡，很适合我。",
              "pinyin": "Zhège cài bǐjiào qīngdàn, hěn shìhé wǒ.",
              "vi": "Món này khá thanh đạm, rất hợp với tôi.",
              "en": "",
              "highlight": [
                "适合"
              ],
              "grammar_refs": [],
              "vocab_refs": [],
              "source_ref": "",
              "note_vi": "",
              "audio_key": "",
              "source_origin": "textbook",
              "check_needed": false
            },
            {
              "id": "38e52309-29d4-419f-b95a-6dad25f96eb9",
              "zh": "这本书适合不适合初级班的学生用？",
              "pinyin": "Zhè běn shū shìhé bù shìhé chūjí bān de xuéshēng yòng?",
              "vi": "Quyển sách này có phù hợp cho học sinh lớp sơ cấp dùng không?",
              "en": "",
              "highlight": [
                "适合"
              ],
              "grammar_refs": [],
              "vocab_refs": [],
              "source_ref": "",
              "note_vi": "",
              "audio_key": "",
              "source_origin": "textbook",
              "check_needed": false
            }
          ],
          "notes_vi": [
            "Có thể nói: 很适合、比较适合、不适合、适合不适合.",
            "Không dùng dạng lặp lại *适合适合."
          ]
        }
      ],
      "legacy_ids": [
        "grammar_q3_l23_04"
      ]
    },
    {
      "id": "grammar_q3_l23_05",
      "type": "grammar_point",
      "order": 5,
      "title": "为……而……",
      "title_vi": "vì/để… mà…",
      "level": "HSK3+",
      "tags": [
        "词语用法",
        "formal_style"
      ],
      "source_origin": "textbook",
      "check_needed": false,
      "blocks": [
        {
          "id": "24a8fcd1-e9b7-43bf-92dc-3d3cc3fb385e",
          "type": "grammar_overview",
          "order": 1,
          "title": "Bản chất",
          "content_vi": "为 nêu mục đích hoặc nguyên nhân của hành động; 而 nối sang hành động phía sau.",
          "examples": []
        },
        {
          "id": "b7be4295-e408-4edd-882f-3fff358754f0",
          "type": "grammar_structure",
          "order": 2,
          "title": "Cấu trúc chính",
          "pattern": "为 + mục đích/nguyên nhân + 而 + hành động",
          "meaning_vi": "Vì / để / nhằm… mà làm gì.",
          "examples": [
            {
              "id": "528ab4f2-319d-4271-8800-f92a399a6e8c",
              "zh": "作为一个从事远程教育的教师，我为自己培养了无数学生而感到自豪。",
              "pinyin": "Zuòwéi yí ge cóngshì yuǎnchéng jiàoyù de jiàoshī, wǒ wèi zìjǐ péiyǎng le wúshù xuéshēng ér gǎndào zìháo.",
              "vi": "Là một giáo viên làm giáo dục từ xa, tôi cảm thấy tự hào vì mình đã đào tạo được vô số học sinh.",
              "en": "",
              "highlight": [
                "为",
                "而"
              ],
              "grammar_refs": [],
              "vocab_refs": [],
              "source_ref": "p009",
              "note_vi": "",
              "audio_key": "",
              "source_origin": "textbook",
              "check_needed": false
            },
            {
              "id": "b50bbea9-e176-4f1d-a9da-57239b4a25e0",
              "zh": "他为以后在中国开展业务而来学习汉语。",
              "pinyin": "Tā wèi yǐhòu zài Zhōngguó kāizhǎn yèwù ér lái xuéxí Hànyǔ.",
              "vi": "Anh ấy đến học tiếng Hán để sau này phát triển nghiệp vụ ở Trung Quốc.",
              "en": "",
              "highlight": [
                "为",
                "而"
              ],
              "grammar_refs": [],
              "vocab_refs": [],
              "source_ref": "",
              "note_vi": "",
              "audio_key": "",
              "source_origin": "textbook",
              "check_needed": false
            },
            {
              "id": "6afe794f-bd28-4d3b-9e91-419edfb74f42",
              "zh": "我是为开办公司而来的。",
              "pinyin": "Wǒ shì wèi kāibàn gōngsī ér lái de.",
              "vi": "Tôi đến là để mở công ty.",
              "en": "",
              "highlight": [
                "为",
                "而"
              ],
              "grammar_refs": [],
              "vocab_refs": [],
              "source_ref": "",
              "note_vi": "",
              "audio_key": "",
              "source_origin": "textbook",
              "check_needed": false
            }
          ],
          "notes_vi": [
            "Sắc thái hơi trang trọng/văn viết hơn 为了."
          ]
        }
      ],
      "legacy_ids": [
        "grammar_q3_l23_05"
      ]
    }
  ]
}
