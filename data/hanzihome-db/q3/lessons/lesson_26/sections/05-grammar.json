  "items": [
    {
      "id": "d5eaf408-514c-4987-b142-668f43d140be",
      "type": "grammar_point",
      "order": 1,
      "title": "由于",
      "title_vi": "Do / bởi vì",
      "level": "HSK3+",
      "tags": [
        "词语用法"
      ],
      "source_origin": "textbook/generated_mixed",
      "page_start": 218,
      "page_end": 222,
      "check_needed": false,
      "blocks": [
        {
          "id": "b7c5d870-2db8-4e2e-950f-f0e6e522ac16",
          "type": "grammar_overview",
          "order": 1,
          "title": "Bản chất",
          "content_vi": "由于 nêu nguyên nhân hoặc lý do. Trong khẩu ngữ thường dùng 因为 hơn; 由于 có sắc thái văn viết hơn.",
          "examples": []
        },
        {
          "id": "b3534a40-3bab-464a-97dd-67889b8bcb7b",
          "type": "grammar_structure",
          "order": 2,
          "title": "Cấu trúc",
          "pattern": "由于 + nguyên nhân，所以/因此/因而 + kết quả",
          "meaning_vi": "Do nguyên nhân nào đó nên có kết quả phía sau.",
          "formulas": [
            {
              "label": "cause_result",
              "pattern": "由于 A，所以/因此/因而 B"
            }
          ],
          "examples": [
            {
              "id": "2e38466f-cc5f-451a-9612-b188f7cd2dcf",
              "zh": "由于古时候女子不能上学读书，所以祝英台常常站在窗前。",
              "pinyin": "Yóuyú gǔ shíhou nǚzǐ bù néng shàngxué dúshū, suǒyǐ Zhù Yīngtái chángcháng zhàn zài chuāng qián.",
              "vi": "Do thời xưa phụ nữ không thể đi học nên Chúc Anh Đài thường đứng bên cửa sổ.",
              "en": "",
              "highlight": [
                "由于",
                "所以"
              ],
              "grammar_refs": [
                "d5eaf408-514c-4987-b142-668f43d140be"
              ],
              "vocab_refs": [],
              "source_ref": "4a807389-3592-4cf4-973f-6589e0118fb2",
              "note_vi": "",
              "audio_key": "",
              "source_origin": "textbook",
              "check_needed": false
            }
          ],
          "notes_vi": [
            "由于 có thể đứng sau 是: 他不参加比赛是由于最近身体不太好。",
            "因为 có thể đứng ở vế sau; 由于 thường không đứng ở vế sau theo kiểu khẩu ngữ."
          ]
        }
      ]
    },
    {
      "id": "a8720887-db26-4d49-b41f-8a6d646a791d",
      "type": "grammar_point",
      "order": 2,
      "title": "为",
      "title_vi": "Làm thành / vì / bởi",
      "level": "HSK3+",
      "tags": [
        "词语用法"
      ],
      "source_origin": "textbook/generated_mixed",
      "page_start": 218,
      "page_end": 222,
      "check_needed": false,
      "blocks": [
        {
          "id": "470b1ca1-e0a1-449f-b55e-a8aa481a4dd4",
          "type": "grammar_overview",
          "order": 1,
          "title": "Bản chất",
          "content_vi": "为 trong bài có nhiều cách dùng: 为 wéi là làm/đóng vai, trở thành, làm, là; 为 wéi còn xuất hiện trong mẫu bị động văn viết 为……所……. 为 wèi mới là “vì/cho”.",
          "examples": []
        },
        {
          "id": "0ef2b790-3209-4b5c-a519-ca5a424e4d49",
          "type": "grammar_structure",
          "order": 2,
          "title": "为 = trở thành / hóa thành",
          "pattern": "A + 化为 / 结拜为 + B",
          "meaning_vi": "A trở thành hoặc được kết thành B.",
          "formulas": [
            {
              "label": "become",
              "pattern": "A + 为 + B"
            }
          ],
          "examples": [
            {
              "id": "148dd5b4-2deb-4724-b898-7d508f8a6e77",
              "zh": "后来，他们结拜为兄弟。",
              "pinyin": "Hòulái, tāmen jiébài wéi xiōngdì.",
              "vi": "Về sau, họ kết nghĩa làm anh em.",
              "en": "",
              "highlight": [
                "化为"
              ],
              "grammar_refs": [
                "a8720887-db26-4d49-b41f-8a6d646a791d"
              ],
              "vocab_refs": [],
              "source_ref": "grammar_page_219",
              "note_vi": "",
              "audio_key": "",
              "source_origin": "textbook",
              "check_needed": false
            }
          ],
          "notes_vi": [
            "为 wéi: làm thành, trở thành, là; ví dụ 结拜为兄弟, 化为一对蝴蝶.",
            "为……所…… là mẫu bị động văn viết; trong bài đọc thêm có 祖国将要为强大的秦国所消灭.",
            "为 wèi: vì/cho; đọc khác với wéi."
          ]
        }
      ]
    },
    {
