        {
          "id": "50dcd503-1832-4112-a0be-e09408954b90",
          "type": "grammar_overview",
          "order": 1,
          "title": "Bản chất",
          "content_vi": "始终 nghĩa là từ đầu đến cuối, luôn luôn; trong sách ghi thường dùng với phủ định.",
          "examples": []
        },
        {
          "id": "2a6a13b8-74d6-4b36-a365-dd671224bcb6",
          "type": "grammar_negative_form",
          "order": 2,
          "title": "Dạng phủ định thường gặp",
          "pattern": "始终 + 不/没 + V",
          "wrong_pattern": "一直 có thể thay trong nhiều câu, nhưng 始终 nhấn mạnh toàn bộ quá trình.",
          "meaning_vi": "Từ đầu đến cuối vẫn không/chưa làm gì.",
          "correct_examples": [
            {
              "id": "3620f823-6377-41e3-9821-e498d2c8ac94",
              "zh": "山伯始终不知英台是个女孩子。",
              "pinyin": "Shānbó shǐzhōng bù zhī Yīngtái shì ge nǚháizi.",
              "vi": "Sơn Bá từ đầu đến cuối vẫn không biết Anh Đài là con gái.",
              "highlight": [
                "始终不知道"
              ],
              "explanation_vi": "Nhấn mạnh suốt cả quá trình ba năm và lúc tiễn biệt vẫn không biết."
            }
          ],
          "wrong_examples": []
        }
      ]
    },
