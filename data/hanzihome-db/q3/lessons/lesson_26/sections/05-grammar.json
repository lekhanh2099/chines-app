          "type": "grammar_structure",
          "order": 1,
          "title": "Cấu trúc",
          "pattern": "Câu trước， 不然 / 要不然 / 要不 + hậu quả",
          "meaning_vi": "Nếu không làm theo điều vừa nói thì sẽ xảy ra hậu quả phía sau.",
          "formulas": [
            {
              "label": "otherwise",
              "pattern": "A，不然 B"
            }
          ],
          "examples": [
            {
              "id": "4c24a67d-5112-438c-96a0-1fe26e7867ad",
              "zh": "还是给他打个电话吧，不然他会担心的。",
              "pinyin": "Háishi gěi tā dǎ ge diànhuà ba, bùrán tā huì dānxīn de.",
              "vi": "Vẫn nên gọi điện cho anh ấy, nếu không anh ấy sẽ lo.",
              "en": "",
              "highlight": [
                "不然"
              ],
              "grammar_refs": [
                "43a1f72d-1510-4a57-a1fa-0af2b4890023"
              ],
              "vocab_refs": [],
              "source_ref": "grammar_page_222",
              "note_vi": "",
              "audio_key": "",
              "source_origin": "textbook",
              "check_needed": false
            }
          ],
          "notes_vi": [
            "不然 cũng có thể nói 要不然 hoặc 要不 trong khẩu ngữ."
          ]
        }
      ]
    },
