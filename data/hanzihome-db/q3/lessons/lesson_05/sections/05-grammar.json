      "blocks": [
        {
          "id": "b7c5d870-2db8-4e2e-950f-f0e6e522ac16",
          "type": "grammar_overview",
          "order": 1,
          "title": "Bản chất",
          "content_vi": "Diễn tả sự thật phía sau, thường để đính chính, giải thích hoặc bổ sung điều người nghe/người nói tưởng trước đó.",
          "examples": [],
          "source_origin": "textbook/generated_mixed",
          "check_needed": false
        },
        {
          "id": "b3534a40-3bab-464a-97dd-67889b8bcb7b",
          "type": "grammar_structure",
          "order": 2,
          "title": "Cấu trúc chính",
          "pattern": "其实 + câu thật sự",
          "meaning_vi": "Thật ra / thực ra / trên thực tế là...",
          "formulas": [
            {
              "label": "Cấu trúc",
              "pattern": "其实 + câu thật sự"
            }
          ],
          "examples": [
            {
              "id": "5e614bf9-2578-4d49-87dc-107e6f3605d4",
              "zh": "其实，北京人最爱说的一句话是“回头再说”。",
              "vi": "Thật ra, câu người Bắc Kinh thích nói nhất là “回头再说” — “để sau rồi nói”.",
              "pinyin": "Qíshí, Běijīng rén zuì ài shuō de yí jù huà shì “huítóu zài shuō”.",
              "highlight": [
                "其实"
              ],
              "grammar_refs": [
                "f8ec59f3-898a-47b2-b536-44dfd8183393"
              ],
              "vocab_refs": [],
              "source_origin": "textbook/generated_mixed",
              "check_needed": false
            },
            {
              "id": "7ccdc8f9-59f3-4c7b-bd28-247acb68c535",
              "zh": "你以为他回国了，其实他去云南旅行了。",
              "vi": "Bạn tưởng anh ấy đã về nước rồi, thật ra anh ấy đi du lịch Vân Nam.",
              "pinyin": "Nǐ yǐwéi tā huíguó le, qíshí tā qù Yúnnán lǚxíng le.",
              "highlight": [
                "其实"
              ],
              "grammar_refs": [
                "f8ec59f3-898a-47b2-b536-44dfd8183393"
              ],
              "vocab_refs": [],
              "source_origin": "textbook/generated_mixed",
              "check_needed": false
            },
            {
              "id": "d84397d0-7b22-492a-a594-cb58d4dd46e0",
              "zh": "其实我没去过北京。",
              "vi": "Thật ra tôi chưa từng đi Bắc Kinh.",
              "pinyin": "Qíshí wǒ méi qù guo Běijīng.",
              "highlight": [
                "其实"
              ],
              "grammar_refs": [
                "f8ec59f3-898a-47b2-b536-44dfd8183393"
              ],
              "vocab_refs": [],
              "source_origin": "textbook/generated_mixed",
              "check_needed": false
            }
          ],
          "notes_vi": [
            "Phủ định nằm trong mệnh đề sau 其实, không phủ định vào 其实.",
            "其实 thường đứng đầu câu hoặc sau chủ ngữ."
          ],
          "source_origin": "textbook/generated_mixed",
          "check_needed": false
        }
      ]
    },
    {
      "id": "57b14753-688a-41b6-9e0d-b61dbbf574d7",
      "type": "grammar_point",
