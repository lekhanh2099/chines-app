              "check_needed": false
            },
            {
              "id": "11c0241f-0901-42a3-879e-03e8696d3e40",
              "zh": "我实在不知道。",
              "vi": "Tôi thật sự không biết.",
              "pinyin": "Wǒ shízài bù zhīdào.",
              "highlight": [
                "实在"
              ],
              "grammar_refs": [
                "fa804fff-372b-4874-8571-f54e613d7e07"
              ],
              "vocab_refs": [],
              "source_origin": "textbook/generated_mixed",
              "check_needed": false
            }
          ],
          "notes_vi": [
            "实在不 + tính từ/động từ = thật sự không...",
            "不实在 = không thật thà / không thực tế / không đáng tin."
          ],
          "source_origin": "textbook/generated_mixed",
          "check_needed": false
        }
      ]
