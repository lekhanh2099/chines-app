      "source_origin": "textbook/generated_mixed",
      "check_needed": false,
      "blocks": [
        {
          "id": "470b1ca1-e0a1-449f-b55e-a8aa481a4dd4",
          "type": "grammar_overview",
          "order": 1,
          "title": "Bản chất",
          "content_vi": "Trong bài nghĩa là để sau rồi tính / để lúc khác nói; có thể là lời hẹn thật hoặc lời từ chối khéo.",
          "examples": [],
          "source_origin": "textbook/generated_mixed",
          "check_needed": false
        },
        {
          "id": "0ef2b790-3209-4b5c-a519-ca5a424e4d49",
          "type": "grammar_structure",
          "order": 2,
          "title": "Cấu trúc chính",
          "pattern": "以后 / 回头 / 有空儿 + 再说",
          "meaning_vi": "Để sau nói, để sau tính, lúc khác xử lý.",
          "formulas": [
            {
              "label": "Cấu trúc",
              "pattern": "以后 / 回头 / 有空儿 + 再说"
            }
          ],
          "examples": [
            {
              "id": "c8674d77-7e1f-44f8-9e45-e0a03accdc05",
              "zh": "这一段工作太忙，回头再说吧。",
              "vi": "Dạo này công việc bận quá, để sau rồi nói nhé.",
              "pinyin": "Zhè yí duàn gōngzuò tài máng, huítóu zài shuō ba.",
              "highlight": [
                "再说"
              ],
              "grammar_refs": [
                "57b14753-688a-41b6-9e0d-b61dbbf574d7"
              ],
              "vocab_refs": [],
              "source_origin": "textbook/generated_mixed",
              "check_needed": false
            },
            {
              "id": "1096379b-a91d-48aa-bc98-42ebe110f965",
              "zh": "这件事以后再说吧。",
              "vi": "Chuyện này để sau rồi nói nhé.",
              "pinyin": "Zhè jiàn shì yǐhòu zài shuō ba.",
              "highlight": [
                "再说"
              ],
              "grammar_refs": [
                "57b14753-688a-41b6-9e0d-b61dbbf574d7"
              ],
              "vocab_refs": [],
              "source_origin": "textbook/generated_mixed",
              "check_needed": false
            },
            {
              "id": "89cf2ddf-bb30-48d6-8d3d-9566092b6154",
              "zh": "时间太晚了，我们明天再说吧。",
              "vi": "Muộn quá rồi, chúng ta để mai nói tiếp nhé.",
              "pinyin": "Shíjiān tài wǎn le, wǒmen míngtiān zài shuō ba.",
              "highlight": [
                "再说"
              ],
              "grammar_refs": [
                "57b14753-688a-41b6-9e0d-b61dbbf574d7"
              ],
              "vocab_refs": [],
              "source_origin": "textbook/generated_mixed",
              "check_needed": false
            }
          ],
          "notes_vi": [
            "Không dùng 不再说 để diễn đạt “không bàn nữa” trong ngữ cảnh này; nói 不说了 hoặc 这件事别说了.",
            "回头再说 mềm hơn 不行, nhưng có thể hàm ý từ chối khéo."
          ],
          "source_origin": "textbook/generated_mixed",
          "check_needed": false
        }
      ]
    },
