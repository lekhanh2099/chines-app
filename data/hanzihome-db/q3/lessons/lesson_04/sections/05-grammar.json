    {
      "id": "grammar_q3_l04_01",
      "type": "grammar_point",
      "order": 1,
      "title": "一点儿 + 也/都 + 不/没……",
      "title_vi": "Một chút cũng không",
      "level": "HSK3+",
      "tags": [
        "词语用法",
        "negation"
      ],
      "source_origin": "textbook",
      "check_needed": false,
      "blocks": [
        {
          "id": "b7c5d870-2db8-4e2e-950f-f0e6e522ac16",
          "type": "grammar_overview",
          "order": 1,
          "title": "Bản chất",
          "content_vi": "Dùng để phủ định tuyệt đối, nghĩa là “không hề… một chút nào”, mạnh hơn 不 / 没 bình thường.",
          "examples": [
            {
              "id": "2e38466f-cc5f-451a-9612-b188f7cd2dcf",
              "zh": "我对南京一点儿也不了解。",
              "pinyin": "Wǒ duì Nánjīng yìdiǎnr yě bù liǎojiě.",
              "vi": "Tôi hoàn toàn không hiểu gì về Nam Kinh.",
              "en": "",
              "highlight": [
                "一点儿也不了解"
              ],
              "grammar_refs": [
                "grammar_q3_l04_01"
              ],
              "vocab_refs": [],
              "source_ref": "",
              "note_vi": "",
              "audio_key": "",
              "source_origin": "textbook/generated_mixed",
              "check_needed": false
            },
            {
              "id": "64dc50f6-13c5-4723-9aed-94e0d978cb90",
              "zh": "我一点儿都不知道。",
              "pinyin": "Wǒ yìdiǎnr dōu bù zhīdào.",
              "vi": "Tôi một chút cũng không biết.",
              "en": "",
              "highlight": [
                "一点儿都不知道"
              ],
              "grammar_refs": [
                "grammar_q3_l04_01"
              ],
              "vocab_refs": [],
              "source_ref": "",
              "note_vi": "",
              "audio_key": "",
              "source_origin": "textbook/generated_mixed",
              "check_needed": false
            }
          ],
          "check_needed": false
        },
        {
          "id": "b3534a40-3bab-464a-97dd-67889b8bcb7b",
          "type": "grammar_structure",
          "order": 2,
          "title": "Cấu trúc",
          "pattern": "一点儿 + 也 / 都 + 不 / 没 + 动词 / 形容词",
          "meaning_vi": "Một chút cũng không…",
          "formulas": [
            {
              "label": "Phủ định trạng thái",
              "pattern": "一点儿也/都不 + 形容词"
            },
            {
              "label": "Phủ định sự việc đã xảy ra/không xảy ra",
              "pattern": "一点儿也/都没 + 动词"
            }
          ],
          "examples": [
            {
              "id": "b7a3d982-8f73-4ed4-b3d6-828fba6e2949",
              "zh": "他一点儿也不紧张。",
              "pinyin": "Tā yìdiǎnr yě bù jǐnzhāng.",
              "vi": "Anh ấy chẳng căng thẳng chút nào.",
              "en": "",
              "highlight": [
                "一点儿也不"
              ],
              "grammar_refs": [
                "grammar_q3_l04_01"
              ],
              "vocab_refs": [],
              "source_ref": "",
              "note_vi": "",
              "audio_key": "",
              "source_origin": "textbook/generated_mixed",
              "check_needed": false
            },
            {
              "id": "7aa9ef46-6f3d-4ea1-b0f6-1ba89dd9b81b",
              "zh": "他一点儿都没变。",
              "pinyin": "Tā yìdiǎnr dōu méi biàn.",
              "vi": "Anh ấy chẳng thay đổi chút nào.",
              "en": "",
              "highlight": [
                "一点儿都没"
              ],
              "grammar_refs": [
                "grammar_q3_l04_01"
              ],
              "vocab_refs": [],
              "source_ref": "",
              "note_vi": "",
              "audio_key": "",
              "source_origin": "textbook/generated_mixed",
              "check_needed": false
            }
          ],
          "notes_vi": [
            "也 và 都 đều được; 都 thường tạo cảm giác quét sạch/nhấn mạnh hơn một chút.",
            "Không nói 我一点儿知道; phải có 也/都 + phủ định."
          ],
          "check_needed": false
        }
      ],
      "legacy_ids": [
        "grammar_q3_l04_01"
      ]
    },
    {
      "id": "grammar_q3_l04_02",
      "type": "grammar_point",
      "order": 2,
      "title": "当然",
      "title_vi": "Đương nhiên / tất nhiên",
      "level": "HSK3+",
      "tags": [
        "词语用法",
        "adverb"
      ],
      "source_origin": "textbook",
      "check_needed": false,
      "blocks": [
        {
          "id": "470b1ca1-e0a1-449f-b55e-a8aa481a4dd4",
          "type": "grammar_overview",
          "order": 1,
          "title": "Bản chất",
          "content_vi": "Dùng khi người nói cho rằng việc đó hiển nhiên, hợp lý, không cần nghi ngờ.",
          "examples": [
            {
              "id": "148dd5b4-2deb-4724-b898-7d508f8a6e77",
              "zh": "这样当然好。",
              "pinyin": "Zhèyàng dāngrán hǎo.",
              "vi": "Như vậy tất nhiên là tốt rồi.",
              "en": "",
              "highlight": [
                "当然"
              ],
              "grammar_refs": [
                "grammar_q3_l04_02"
              ],
              "vocab_refs": [],
              "source_ref": "",
              "note_vi": "",
              "audio_key": "",
              "source_origin": "textbook/generated_mixed",
              "check_needed": false
            },
            {
              "id": "34fb6f43-cac8-4ca9-9004-ccfbcfc6d263",
              "zh": "我当然愿意帮助你。",
              "pinyin": "Wǒ dāngrán yuànyì bāngzhù nǐ.",
              "vi": "Tôi đương nhiên sẵn lòng giúp bạn.",
              "en": "",
              "highlight": [
                "当然"
              ],
              "grammar_refs": [
                "grammar_q3_l04_02"
              ],
              "vocab_refs": [],
              "source_ref": "",
              "note_vi": "",
              "audio_key": "",
              "source_origin": "textbook/generated_mixed",
              "check_needed": false
            }
          ],
          "check_needed": false
        },
        {
          "id": "21fbb1a3-0847-4c15-9ca8-be559cee0dd7",
          "type": "grammar_usage_notes",
          "order": 2,
          "title": "Lưu ý",
          "notes_vi": [
            "当然 nhấn mạnh “hiển nhiên/hợp lý”.",
            "一定 nhấn mạnh “chắc chắn/nhất định”."
          ],
          "examples": [
            {
              "id": "e32b9b44-0167-4608-818f-ad358140a4ff",
              "zh": "你是我的朋友，我当然要帮你。",
              "pinyin": "Nǐ shì wǒ de péngyou, wǒ dāngrán yào bāng nǐ.",
              "vi": "Bạn là bạn của tôi, tất nhiên tôi phải giúp bạn.",
              "en": "",
              "highlight": [
                "当然"
              ],
              "grammar_refs": [
                "grammar_q3_l04_02"
              ],
              "vocab_refs": [],
              "source_ref": "",
              "note_vi": "",
              "audio_key": "",
              "source_origin": "textbook/generated_mixed",
              "check_needed": false
            },
            {
              "id": "3d218f68-a9a9-46a3-8ff6-83866693abad",
              "zh": "我一定会把汉语学好。",
              "pinyin": "Wǒ yídìng huì bǎ Hànyǔ xué hǎo.",
              "vi": "Tôi nhất định sẽ học tốt tiếng Hán.",
              "en": "",
              "highlight": [
                "一定"
              ],
              "grammar_refs": [
                "grammar_q3_l04_02"
              ],
              "vocab_refs": [],
              "source_ref": "",
              "note_vi": "",
              "audio_key": "",
              "source_origin": "textbook/generated_mixed",
              "check_needed": false
            }
          ],
          "check_needed": false
        }
      ],
      "legacy_ids": [
        "grammar_q3_l04_02"
      ]
