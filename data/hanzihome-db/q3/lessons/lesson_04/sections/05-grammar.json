        {
          "id": "3de2e20b-7535-4f1b-8355-4209acba1551",
          "type": "grammar_structure",
          "order": 2,
          "title": "Cấu trúc",
          "pattern": "句子 A，不过 + 句子 B",
          "meaning_vi": "A, nhưng / chỉ là B.",
          "formulas": [],
