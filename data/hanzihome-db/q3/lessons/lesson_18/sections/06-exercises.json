      "source_origin": "textbook_question_generated_answer",
      "check_needed": false,
      "questions": [
        {
          "id": "l18_ex07_01",
          "wrong_sentence": "别着急，你渐渐吃，我等着你。",
          "correct_sentence": "别着急，你慢慢吃，我等着你。",
          "explanation_vi": "渐渐不能修饰自主动作，也不能用于祈使语境；这里应说慢慢吃。",
          "answer_verified": true,
          "check_needed": false
        },
        {
          "id": "l18_ex07_02",
          "wrong_sentence": "我本来打算从北京到香港坐火车，但是没买到票，只好没办法。",
          "correct_sentence": "我本来打算从北京到香港坐火车，但是没买到票，只好另想办法。",
          "explanation_vi": "只好后面要接具体可做的办法；‘只好没办法’语义矛盾。",
          "answer_verified": true,
          "check_needed": false
        },
        {
          "id": "l18_ex07_03",
          "wrong_sentence": "我们一边谈话关于中国和外国的社会，一边听音乐。",
          "correct_sentence": "我们一边谈中国和外国的社会问题，一边听音乐。",
          "explanation_vi": "关于 + 名词短语作状语时一般放在主语前；这里动词谈可直接带谈论内容。",
          "answer_verified": true,
          "check_needed": false
        },
        {
          "id": "l18_ex07_04",
          "wrong_sentence": "他已经悄悄感冒了一个星期。",
          "correct_sentence": "他已经感冒了一个星期了。",
          "explanation_vi": "悄悄修饰有意控制的动作；感冒不是自主动作。",
          "answer_verified": true,
          "check_needed": false
        },
        {
          "id": "l18_ex07_05",
          "wrong_sentence": "我把我钱包里一切的钱都给他了。",
          "correct_sentence": "我把我钱包里所有的钱都给他了。",
          "explanation_vi": "所有修饰具体范围内的名词更自然；一切一般作代词，不能说一切的钱。",
          "answer_verified": true,
          "check_needed": false
        },
        {
          "id": "l18_ex07_06",
          "wrong_sentence": "我起床晚了，来不及早饭就来教室。",
          "correct_sentence": "我起床晚了，来不及吃早饭就来教室了。",
          "explanation_vi": "来不及后面要接动词；早饭前应补吃。",
          "answer_verified": true,
          "check_needed": false
        }
      ],
      "answer_verified": true,
