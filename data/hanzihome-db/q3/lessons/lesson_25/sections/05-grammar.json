              "check_needed": false
            },
            {
              "id": "grammar_006_ex_002",
              "zh": "他握着我的手，久久说不出话来。",
              "pinyin": "Tā wòzhe wǒ de shǒu, jiǔjiǔ shuō bù chū huà lái.",
              "vi": "Ông ấy nắm tay tôi, rất lâu không nói nên lời.",
              "highlight": [
