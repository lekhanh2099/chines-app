        {
          "id": "b7be4295-e408-4edd-882f-3fff358754f0",
          "type": "grammar_structure",
          "order": 2,
          "title": "Cấu trúc chính",
          "pattern": "一会儿 + 动作/状态1，一会儿 + 动作/状态2",
          "meaning_vi": "Biểu thị hành động/trạng thái thay phiên nhau xảy ra.",
          "examples": [
            {
              "id": "grammar_005_ex_001",
              "zh": "一会儿给我倒水，一会儿又为我扇扇子。",
              "pinyin": "Yíhuìr gěi wǒ dào shuǐ, yíhuìr yòu wèi wǒ shān shànzi.",
              "vi": "Lúc thì rót nước cho tôi, lúc lại quạt cho tôi.",
              "highlight": [
                "一会儿……一会儿……"
              ],
              "source_origin": "textbook_pdf_checked",
              "check_needed": false
            },
            {
              "id": "grammar_005_ex_002",
              "zh": "这里的天气变化很快，一会儿下雨，一会儿又刮起了大风。",
              "pinyin": "Zhèlǐ de tiānqì biànhuà hěn kuài, yíhuìr xià yǔ, yíhuìr yòu guā qǐ le dà fēng.",
              "vi": "Thời tiết ở đây thay đổi rất nhanh, lúc thì mưa, lúc lại nổi gió lớn.",
              "highlight": [
                "一会儿……一会儿……"
              ],
              "source_origin": "textbook_pdf_checked",
              "check_needed": false
            }
          ],
          "notes_vi": []
        }
