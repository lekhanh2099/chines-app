          "type": "grammar_structure",
          "order": 2,
          "title": "Cấu trúc chính",
          "pattern": "主语 + 难以 + 双音节动词 / 动词词组",
          "meaning_vi": "Khó mà, khó có thể; trang trọng hơn 很难, thiên về văn viết.",
          "examples": [
            {
              "id": "grammar_003_ex_001",
              "zh": "我实在难以忍受孤独和寂寞。",
              "pinyin": "Wǒ shízài nányǐ rěnshòu gūdú hé jìmò.",
              "vi": "Tôi thật sự khó có thể chịu đựng sự cô độc và lẻ loi.",
              "highlight": [
                "难以"
              ],
              "source_origin": "textbook_pdf_checked",
              "check_needed": false
            },
            {
              "id": "grammar_003_ex_002",
              "zh": "你这样解释是难以让人相信的。",
              "pinyin": "Nǐ zhèyàng jiěshì shì nányǐ ràng rén xiāngxìn de.",
              "vi": "Bạn giải thích như vậy thì khó khiến người khác tin được.",
              "highlight": [
                "难以"
