    {
      "id": "grammar_q3_l25_01",
      "type": "grammar_point",
      "order": 1,
      "title": "从不",
      "title_vi": "从不",
      "level": "HSK3+",
      "tags": [
        "词语用法"
      ],
      "source_origin": "textbook_pdf_checked",
      "check_needed": false,
      "blocks": [
        {
          "id": "b7c5d870-2db8-4e2e-950f-f0e6e522ac16",
          "type": "grammar_overview",
          "order": 1,
          "title": "Bản chất",
          "content_vi": "从不 = 从来不, nhấn mạnh từ trước đến nay không / chưa từng.",
          "examples": []
        },
        {
          "id": "b3534a40-3bab-464a-97dd-67889b8bcb7b",
          "type": "grammar_structure",
          "order": 2,
          "title": "Cấu trúc chính",
          "pattern": "主语 + 从不 + 动词 / 形容词",
          "meaning_vi": "从不 = 从来不, nhấn mạnh từ trước đến nay không / chưa từng.",
          "examples": [
            {
              "id": "grammar_001_ex_001",
              "zh": "家里桌上的月饼一盒比一盒好，我从不吃。",
              "pinyin": "Jiālǐ zhuō shang de yuèbing yì hé bǐ yì hé hǎo, wǒ cóng bù chī.",
              "vi": "Bánh Trung thu trên bàn nhà tôi hộp này tốt hơn hộp kia, tôi chưa bao giờ ăn.",
              "highlight": [
                "从不"
              ],
              "source_origin": "textbook_pdf_checked",
              "check_needed": false
            },
            {
              "id": "grammar_001_ex_002",
              "zh": "她是个学习非常努力的学生，从不迟到早退。",
              "pinyin": "Tā shì ge xuéxí fēicháng nǔlì de xuésheng, cóng bù chídào zǎotuì.",
              "vi": "Cô ấy là học sinh rất chăm chỉ, chưa bao giờ đi muộn về sớm.",
              "highlight": [
                "从不"
              ],
              "source_origin": "textbook_pdf_checked",
              "check_needed": false
            }
          ],
          "notes_vi": []
        }
      ]
    },
