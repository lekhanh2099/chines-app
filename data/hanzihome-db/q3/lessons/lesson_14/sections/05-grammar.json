    {
      "id": "grammar_q3_l14_01",
      "type": "grammar_point",
      "order": 1,
      "title": "由",
      "title_vi": "Giới từ 由",
      "level": "HSK3+",
      "tags": [
        "词语用法"
      ],
      "source_origin": "textbook_pdf_crosschecked",
      "check_needed": false,
      "blocks": [
        {
          "id": "54506f23-ba32-4dd1-bf0c-77a1d4687547",
          "type": "grammar_overview",
          "order": 1,
          "title": "Bản chất",
          "content_vi": "由 dùng để nêu người, tổ chức hoặc yếu tố phụ trách, quyết định, thực hiện hoặc gây ra một việc.",
          "examples": [
            {
              "id": "f7773bb0-298e-467c-8e8e-ae17f080bf1c",
              "zh": "小事由妻子决定，大事都由我做主。",
              "pinyin": "Xiǎoshì yóu qīzi juédìng, dàshì dōu yóu wǒ zuòzhǔ.",
              "vi": "Việc nhỏ do vợ quyết định, việc lớn đều do tôi làm chủ.",
              "en": "",
              "highlight": [
                "由妻子决定",
                "由我做主"
              ],
              "grammar_refs": [],
              "vocab_refs": [],
              "source_ref": "",
              "note_vi": "",
              "audio_key": "",
              "source_origin": "textbook_pdf_crosschecked",
              "check_needed": false
            },
            {
              "id": "505e1c2f-30a8-40ab-8d64-2e3fe702a007",
              "zh": "这些大事都由我考虑。",
              "pinyin": "Zhèxiē dàshì dōu yóu wǒ kǎolǜ.",
              "vi": "Những việc lớn này đều do tôi suy nghĩ.",
              "en": "",
              "highlight": [
                "由我考虑"
              ],
              "grammar_refs": [],
              "vocab_refs": [],
              "source_ref": "",
              "note_vi": "",
              "audio_key": "",
              "source_origin": "textbook_pdf_crosschecked",
              "check_needed": false
            }
          ]
        }
      ]
    },
    {
      "id": "grammar_q3_l14_02",
      "type": "grammar_point",
      "order": 2,
      "title": "马上",
      "title_vi": "Phó từ 马上",
      "level": "HSK3+",
      "tags": [
        "词语用法"
      ],
      "source_origin": "textbook_pdf_crosschecked",
      "check_needed": false,
      "blocks": [
        {
          "id": "249a92f0-1d36-4028-a5d4-527a623428f0",
          "type": "grammar_overview",
          "order": 1,
          "title": "Bản chất",
          "content_vi": "马上 nghĩa là ngay, lập tức, sắp ngay; dùng khi hành động xảy ra rất nhanh sau thời điểm nói hoặc sau một sự việc khác.",
          "examples": [
            {
              "id": "4c40d9fa-eb9d-4b2f-a8e1-12567cef50e7",
              "zh": "负责人说马上派工人去修。",
              "pinyin": "Fùzérén shuō mǎshàng pài gōngrén qù xiū.",
              "vi": "Người phụ trách nói sẽ lập tức cử thợ đến sửa.",
              "en": "",
              "highlight": [
                "马上"
              ],
              "grammar_refs": [],
              "vocab_refs": [],
              "source_ref": "",
              "note_vi": "",
              "audio_key": "",
              "source_origin": "textbook_pdf_crosschecked",
              "check_needed": false
            },
            {
              "id": "8ddf6977-04e6-4c73-98f0-65b6900ab7cf",
              "zh": "我马上回来。",
              "pinyin": "Wǒ mǎshàng huílai.",
              "vi": "Tôi quay lại ngay.",
              "en": "",
              "highlight": [
                "马上"
              ],
              "grammar_refs": [],
              "vocab_refs": [],
              "source_ref": "",
              "note_vi": "",
              "audio_key": "",
              "source_origin": "textbook_pdf_crosschecked",
              "check_needed": false
            }
          ]
        }
      ]
    },
    {
      "id": "grammar_q3_l14_03",
      "type": "grammar_point",
      "order": 3,
      "title": "并",
      "title_vi": "Phó từ 并",
      "level": "HSK3+",
      "tags": [
        "词语用法"
      ],
      "source_origin": "textbook_pdf_crosschecked",
      "check_needed": false,
      "blocks": [
        {
          "id": "c0574390-27b1-4b68-89f7-715bb504bdf8",
          "type": "grammar_overview",
          "order": 1,
          "title": "Bản chất",
          "content_vi": "并 thường đi trước 不/没有 để nhấn mạnh phủ định: thực ra không, hoàn toàn không như tưởng. Ngoài ra 并且 có thể nối ý theo nghĩa ‘và/hơn nữa’.",
          "examples": [
            {
              "id": "c67dd38a-8d36-4d50-b27a-972bb8f8f18b",
              "zh": "医生似乎并不着急查看我的伤腿。",
              "pinyin": "Yīshēng sìhū bìng bù zháojí chákàn wǒ de shāng tuǐ.",
              "vi": "Bác sĩ dường như không hề vội xem chân bị thương của tôi.",
              "en": "",
              "highlight": [
                "并不"
              ],
              "grammar_refs": [],
              "vocab_refs": [],
              "source_ref": "",
              "note_vi": "",
              "audio_key": "",
              "source_origin": "textbook_pdf_crosschecked",
              "check_needed": false
            },
            {
              "id": "76799b1b-cace-4650-abb5-8c4f2aebfb67",
              "zh": "他并没有生气。",
              "pinyin": "Tā bìng méiyǒu shēngqì.",
              "vi": "Anh ấy thực ra không giận.",
              "en": "",
              "highlight": [
                "并没有"
              ],
              "grammar_refs": [],
              "vocab_refs": [],
              "source_ref": "",
              "note_vi": "",
              "audio_key": "",
              "source_origin": "textbook_pdf_crosschecked",
              "check_needed": false
            }
          ]
        }
      ]
    },
    {
      "id": "grammar_q3_l14_04",
      "type": "grammar_point",
      "order": 4,
      "title": "似乎",
      "title_vi": "Phó từ 似乎",
      "level": "HSK3+",
      "tags": [
        "词语用法"
      ],
      "source_origin": "textbook_pdf_crosschecked",
      "check_needed": false,
      "blocks": [
        {
          "id": "6c8102ab-c13b-45e1-b81f-38a56a2ddf2e",
          "type": "grammar_overview",
          "order": 1,
          "title": "Bản chất",
          "content_vi": "似乎 nghĩa là dường như, có vẻ như; dùng khi người nói không khẳng định tuyệt đối mà chỉ suy đoán từ quan sát.",
          "examples": [
            {
              "id": "0aa414e8-aa38-4a42-b8e6-0abe09e190de",
              "zh": "医生似乎并不着急查看我的伤腿。",
              "pinyin": "Yīshēng sìhū bìng bù zháojí chákàn wǒ de shāng tuǐ.",
              "vi": "Bác sĩ dường như không hề vội xem chân bị thương của tôi.",
              "en": "",
              "highlight": [
                "似乎"
              ],
              "grammar_refs": [],
              "vocab_refs": [],
              "source_ref": "",
              "note_vi": "",
              "audio_key": "",
              "source_origin": "textbook_pdf_crosschecked",
              "check_needed": false
            },
            {
              "id": "d1100917-7e46-48bb-88dd-4aabc00e2bb2",
              "zh": "这回医生似乎听明白了怎么回事。",
              "pinyin": "Zhè huí yīshēng sìhū tīng míngbai le zěnme huí shì.",
              "vi": "Lần này bác sĩ dường như đã hiểu chuyện gì xảy ra.",
              "en": "",
              "highlight": [
                "似乎"
              ],
              "grammar_refs": [],
              "vocab_refs": [],
              "source_ref": "",
              "note_vi": "",
              "audio_key": "",
              "source_origin": "textbook_pdf_crosschecked",
              "check_needed": false
            }
          ]
        }
      ]
    },
    {
      "id": "grammar_q3_l14_05",
      "type": "grammar_point",
      "order": 5,
      "title": "顿时",
      "title_vi": "Phó từ 顿时",
      "level": "HSK3+",
      "tags": [
        "词语用法"
      ],
      "source_origin": "textbook_pdf_crosschecked",
      "check_needed": false,
      "blocks": [
        {
          "id": "8195bff5-9a31-4b10-8a2b-d39dcd96c701",
          "type": "grammar_overview",
          "order": 1,
          "title": "Bản chất",
          "content_vi": "顿时 nhấn mạnh phản ứng hoặc thay đổi xảy ra đột ngột ngay sau một tình huống.",
          "examples": [
            {
              "id": "fbf2f9b9-2762-4579-96d4-91285b663e24",
              "zh": "全班同学顿时哈哈大笑起来。",
              "pinyin": "Quán bān tóngxué dùnshí hāhā dà xiào qǐlai.",
              "vi": "Cả lớp lập tức phá lên cười.",
              "en": "",
              "highlight": [
                "顿时"
              ],
              "grammar_refs": [],
              "vocab_refs": [],
              "source_ref": "",
              "note_vi": "",
              "audio_key": "",
              "source_origin": "textbook_pdf_crosschecked",
              "check_needed": false
            },
            {
              "id": "a3e37e5d-1fc6-4f25-930f-72334cae130f",
              "zh": "老师一进来，教室里顿时安静了。",
              "pinyin": "Lǎoshī yì jìnlai, jiàoshì lǐ dùnshí ānjìng le.",
              "vi": "Thầy giáo vừa bước vào, lớp học lập tức yên lặng.",
              "en": "",
              "highlight": [
                "顿时"
              ],
              "grammar_refs": [],
              "vocab_refs": [],
              "source_ref": "",
              "note_vi": "",
              "audio_key": "",
              "source_origin": "textbook_pdf_crosschecked",
              "check_needed": false
            }
          ]
        }
      ]
    },
