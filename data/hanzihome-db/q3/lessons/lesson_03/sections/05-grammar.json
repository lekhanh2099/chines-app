    {
      "id": "grammar_q3_l03_01",
      "type": "grammar_point",
      "order": 1,
      "title": "拿",
      "title_vi": "拿...来说: lấy... mà nói",
      "level": "HSK3+",
      "tags": [
        "词语用法"
      ],
      "source_origin": "textbook/generated_mixed",
      "check_needed": false,
      "blocks": [
        {
          "id": "b7c5d870-2db8-4e2e-950f-f0e6e522ac16",
          "type": "grammar_overview",
          "order": 1,
          "title": "Bản chất",
          "content_vi": "拿 nghĩa gốc là cầm/lấy. Trong cấu trúc 拿...来说, nó dùng để mở chủ đề bằng cách lấy một trường hợp cụ thể ra làm ví dụ.",
          "examples": [
            {
              "id": "2e38466f-cc5f-451a-9612-b188f7cd2dcf",
              "zh": "拿北京来说，秋天是最美的季节。",
              "pinyin": "Ná Běijīng lái shuō, qiūtiān shì zuì měi de jìjié.",
              "vi": "Lấy Bắc Kinh mà nói, mùa thu là mùa đẹp nhất.",
              "en": "",
              "highlight": [
                "拿北京来说"
              ],
              "grammar_refs": [
                "grammar_q3_l03_01"
              ],
              "vocab_refs": [],
              "source_ref": "",
              "note_vi": "",
              "audio_key": "",
              "source_origin": "textbook/generated_mixed",
              "check_needed": false
            }
          ]
        },
        {
          "id": "b3534a40-3bab-464a-97dd-67889b8bcb7b",
          "type": "grammar_structure",
          "order": 2,
          "title": "Cấu trúc chính",
          "pattern": "拿 + N + 来说 / 来讲 / 来看",
          "meaning_vi": "Lấy N làm ví dụ / xét từ N mà nói.",
          "examples": [
            {
              "id": "64dc50f6-13c5-4723-9aed-94e0d978cb90",
              "zh": "拿学习汉语来说，每天复习比一次学很多更有用。",
              "pinyin": "Ná xuéxí Hànyǔ lái shuō, měitiān fùxí bǐ yícì xué hěn duō gèng yǒuyòng.",
              "vi": "Lấy việc học tiếng Trung mà nói, mỗi ngày ôn một chút hữu ích hơn là một lần học quá nhiều.",
              "en": "",
              "highlight": [
                "拿学习汉语来说"
              ],
              "grammar_refs": [
                "grammar_q3_l03_01"
              ],
              "vocab_refs": [],
              "source_ref": "",
              "note_vi": "",
              "audio_key": "",
              "source_origin": "textbook/generated_mixed",
              "check_needed": false
            }
          ]
        },
        {
          "id": "f9d96f02-6b23-4c56-a739-db75b628cdcf",
          "type": "grammar_usage_notes",
          "order": 3,
          "title": "Lưu ý",
          "notes_vi": [
            "拿...来说 = lấy... làm ví dụ để bàn.",
            "对于...来说 = đối với... mà nói, nghiêng về góc nhìn/đối tượng đánh giá.",
            "关于... = về/chủ đề liên quan đến..."
          ],
          "examples": []
        }
      ]
    },
    {
      "id": "grammar_q3_l03_02",
      "type": "grammar_point",
      "order": 2,
      "title": "动词 + 下",
      "title_vi": "Động từ + 下",
      "level": "HSK3+",
      "tags": [
        "词语用法",
        "result_complement"
      ],
      "source_origin": "textbook/generated_mixed",
      "check_needed": false,
      "blocks": [
        {
          "id": "470b1ca1-e0a1-449f-b55e-a8aa481a4dd4",
          "type": "grammar_overview",
          "order": 1,
          "title": "Bản chất",
          "content_vi": "V + 下 thường biểu thị hành động có kết quả rời ra, hạ xuống, dừng lại hoặc giữ lại.",
          "examples": [
            {
              "id": "148dd5b4-2deb-4724-b898-7d508f8a6e77",
              "zh": "人们脱下冬衣，换上春装。",
              "pinyin": "Rénmen tuō xià dōngyī, huàn shàng chūnzhuāng.",
              "vi": "Mọi người cởi áo mùa đông ra, thay sang quần áo mùa xuân.",
              "en": "",
              "highlight": [
                "脱下"
              ],
              "grammar_refs": [
                "grammar_q3_l03_02"
              ],
              "vocab_refs": [],
              "source_ref": "",
              "note_vi": "",
              "audio_key": "",
              "source_origin": "textbook/generated_mixed",
              "check_needed": false
            }
          ]
        },
        {
          "id": "0ef2b790-3209-4b5c-a519-ca5a424e4d49",
          "type": "grammar_structure",
          "order": 2,
          "title": "Cấu trúc chính",
          "pattern": "V + 下 + O",
          "meaning_vi": "Làm cho vật rời khỏi vị trí cũ / lưu lại kết quả / dừng lại.",
          "examples": [
            {
              "id": "34fb6f43-cac8-4ca9-9004-ccfbcfc6d263",
              "zh": "请你把这个地址记下来。",
              "pinyin": "Qǐng nǐ bǎ zhè ge dìzhǐ jì xiàlai.",
              "vi": "Bạn hãy ghi địa chỉ này lại.",
              "en": "",
              "highlight": [
                "记下来"
              ],
              "grammar_refs": [
                "grammar_q3_l03_02"
              ],
              "vocab_refs": [],
              "source_ref": "",
              "note_vi": "",
              "audio_key": "",
              "source_origin": "textbook/generated_mixed",
              "check_needed": false
            },
            {
              "id": "e32b9b44-0167-4608-818f-ad358140a4ff",
              "zh": "他停下来，看了看四周。",
              "pinyin": "Tā tíng xiàlai, kàn le kan sìzhōu.",
              "vi": "Anh ấy dừng lại, nhìn xung quanh.",
              "en": "",
              "highlight": [
                "停下来"
              ],
              "grammar_refs": [
                "grammar_q3_l03_02"
              ],
              "vocab_refs": [],
              "source_ref": "",
              "note_vi": "",
              "audio_key": "",
              "source_origin": "textbook/generated_mixed",
              "check_needed": false
            }
          ]
        },
        {
          "id": "7ef0fe1b-7a15-4bc5-a252-97371e9335a3",
          "type": "grammar_usage_notes",
          "order": 3,
          "title": "Dạng khả năng",
          "notes_vi": [
            "V + 得 + 下: làm/ chứa được.",
            "V + 不 + 下: không làm/không chứa nổi.",
            "Không phải mọi 下 đều dịch là xuống."
          ],
          "examples": [
            {
              "id": "3d218f68-a9a9-46a3-8ff6-83866693abad",
              "zh": "这间房子住得下五个人。",
              "pinyin": "Zhè jiān fángzi zhù de xià wǔ ge rén.",
              "vi": "Căn phòng này ở được năm người.",
              "en": "",
              "highlight": [
                "住得下"
              ],
              "grammar_refs": [
                "grammar_q3_l03_02"
              ],
              "vocab_refs": [],
              "source_ref": "",
              "note_vi": "",
              "audio_key": "",
              "source_origin": "textbook/generated_mixed",
              "check_needed": false
            },
            {
              "id": "e66913ba-defd-4199-8a9f-6f8d46fa8a4a",
              "zh": "这间房子住不下十个人。",
              "pinyin": "Zhè jiān fángzi zhù bu xià shí ge rén.",
              "vi": "Căn phòng này không ở nổi mười người.",
              "en": "",
              "highlight": [
                "住不下"
              ],
              "grammar_refs": [
                "grammar_q3_l03_02"
              ],
              "vocab_refs": [],
              "source_ref": "",
              "note_vi": "",
              "audio_key": "",
              "source_origin": "textbook/generated_mixed",
              "check_needed": false
            }
          ]
        }
      ]
