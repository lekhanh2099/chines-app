          "order": 2,
          "title": "Cấu trúc chính",
          "pattern": "主语 + 终于 + 动词/动词短语 + 了",
          "meaning_vi": "Cuối cùng cũng đã…",
          "formulas": [
            {
              "label": "pattern",
              "pattern": "主语 + 终于 + 动词/动词短语 + 了"
            }
