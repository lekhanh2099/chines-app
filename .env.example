# Public Supabase configuration
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_APP_URL=http://localhost:3001
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_replace_me
# Legacy fallback only. Prefer NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY.
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_PROJECT_REF=pdrzkirlhbkmfpbcsujp
# Required by the Supabase CLI for `npm run types:supabase`.
SUPABASE_ACCESS_TOKEN=

# Server-only Supabase configuration
SUPABASE_SECRET_KEY=
# Legacy fallback only. Never expose this value to the browser.
SUPABASE_SERVICE_ROLE_KEY=

# Server-only infrastructure secret for encrypting per-user BYOK credentials.
# User-facing provider API keys are added in Settings → AI and stored encrypted
# in user_api_keys. Do not configure provider keys as application environment
# fallbacks.
# Required to encrypt new BYOK values. Supabase server credentials are legacy
# decrypt-only fallback material and must never be used as the normal BYOK key.
BYOK_ENCRYPTION_SECRET=
