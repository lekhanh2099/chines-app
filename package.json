{
 "name": "chines-app",
 "version": "0.1.0",
 "private": true,
 "packageManager": "npm@11.6.1",
 "engines": {
  "node": ">=22"
 },
 "knip": {
  "ignoreDependencies": [
   "supabase"
  ]
 },
 "overrides": {
  "next": {
   "postcss": "8.5.10"
  }
 },
 "scripts": {
  "prepare": "husky",
  "dev": "next dev -p 3001",
  "build": "next build --webpack",
  "data:hanzihome:db-rebuild": "node --experimental-strip-types scripts/rebuild-hanzihome-db.ts",
  "data:hanzihome:db-audit": "node --experimental-strip-types scripts/audit-hanzihome-db.ts && node --experimental-strip-types scripts/audit-hanzihome-db-runtime.ts",
  "data:hanzihome:seed-audit": "node --experimental-strip-types scripts/audit-hanzihome-seed-readiness.ts",
  "data:hanzihome:seed-supabase": "node --experimental-strip-types scripts/seed-hanzihome-supabase.ts",
  "data:hanzihome:verify-supabase": "node --experimental-strip-types scripts/verify-hanzihome-supabase-seed.ts",
  "data:hanzihome:import-external": "node --experimental-strip-types scripts/import-hanzihome-external-seed.ts",
  "data:hanzihome:import-boya-9e": "node --experimental-strip-types scripts/import-hanzihome-boya-nine-volume.ts",
  "data:hanzihome:import-vocab-enrichment": "node --experimental-strip-types scripts/import-hanzihome-vocab-enrichment.ts",
  "data:hanzihome:listening-audit": "node --experimental-strip-types scripts/audit-hanzihome-listening-supabase.ts",
  "format": "prettier --write .",
  "format:check": "prettier --check .",
  "start": "next start",
  "lint": "eslint",
  "typecheck": "tsc --noEmit",
  "test": "vitest",
  "test:run": "vitest run",
  "test:coverage": "vitest run --coverage",
  "deps:check": "knip --dependencies",
  "source:check": "node scripts/check-source-standards.mjs",
  "audit:prod": "npm audit --omit=dev --audit-level=moderate",
  "types:supabase": "node scripts/generate-supabase-types.mjs",
  "types:supabase:check": "node scripts/generate-supabase-types.mjs --check",
  "check": "npm run format:check && npm run lint && npm run source:check && npm run typecheck && npm run test:run && npm run deps:check && npm run audit:prod && npm run build",
  "check:hanzihome:perf": "node scripts/check-hanzihome-performance.mjs"
 },
 "dependencies": {
  "@base-ui/react": "^1.2.0",
  "@codemirror/lang-html": "^6.4.11",
  "@elevenlabs/elevenlabs-js": "^2.38.1",
  "@lexical/code": "^0.45.0",
  "@lexical/link": "^0.45.0",
  "@lexical/list": "^0.45.0",
  "@lexical/react": "^0.45.0",
  "@lexical/rich-text": "^0.45.0",
  "@lexical/selection": "^0.45.0",
  "@lexical/table": "^0.45.0",
  "@lexical/utils": "^0.45.0",
  "@supabase/ssr": "^0.10.3",
  "@supabase/supabase-js": "^2.98.0",
  "@tailwindcss/typography": "^0.5.19",
  "@tanstack/react-form": "^1.28.3",
  "@tanstack/react-query": "^5.90.21",
  "@tanstack/react-store": "^0.11.0",
  "@uiw/react-codemirror": "^4.25.10",
  "class-variance-authority": "^0.7.1",
  "clsx": "^2.1.1",
  "date-fns": "^4.1.0",
  "hanzi-writer": "^3.7.3",
  "lexical": "^0.45.0",
  "lucide-react": "^1.17.0",
  "next": "^16.2.10",
  "pinyin-pro": "^3.28.0",
  "prettier": "^3.9.1",
  "radix-ui": "^1.4.3",
  "react": "^19.2.7",
  "react-dom": "^19.2.7",
  "react-resizable-panels": "^4.11.1",
  "server-only": "^0.0.1",
  "shadcn": "^4.8.0",
  "sonner": "^2.0.7",
  "tailwind-merge": "^3.6.0",
  "tw-animate-css": "^1.4.0",
  "zod": "^4.4.3",
  "zustand": "^5.0.11"
 },
 "devDependencies": {
  "@tailwindcss/postcss": "^4",
  "@types/node": "^25.9.2",
  "@types/react": "^19.2.17",
  "@types/react-dom": "^19.2.3",
  "@vitest/coverage-v8": "^4.1.10",
  "dotenv": "^17.4.2",
  "eslint": "^9.39.4",
  "eslint-config-next": "^16.2.7",
  "husky": "^9.1.7",
  "knip": "^5.82.0",
  "postcss": "^8.5.19",
  "supabase": "^2.109.1",
  "tailwindcss": "^4",
  "typescript": "^6.0.3",
  "vitest": "^4.1.7"
 }
}
