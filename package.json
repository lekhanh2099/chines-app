{
 "name": "chines-app",
 "version": "0.1.0",
 "private": true,
 "packageManager": "npm@12.2.0",
 "engines": {
  "node": ">=22.22.2",
  "npm": ">=12.2.0"
 },
 "overrides": {
  "@tailwindcss/typography": {
   "postcss-selector-parser": "7.1.6"
  },
  "@workflow/core": {
   "nanoid": "5.1.16",
   "devalue": "5.9.4"
  },
  "@workflow/world-local": {
   "undici": "7.30.0"
  },
  "@workflow/world-vercel": {
   "undici": "7.30.0"
  },
  "next": {
   "postcss": "8.5.28"
  }
 },
 "scripts": {
  "data:hanzihome:studio:import:preview": "node --experimental-strip-types scripts/hanzihome-studio-import.ts",
  "data:hanzihome:studio:check": "node --experimental-strip-types scripts/hanzihome-studio-inventory.ts",
  "data:hanzihome:studio:assets:check": "node --experimental-strip-types scripts/hanzihome-studio-inventory.ts --check-assets --destination .",
  "dev": "next dev -p 3001",
  "build": "next build --webpack",
  "format": "oxfmt --write .",
  "format:check": "oxfmt --check .",
  "start": "next start",
  "lint": "oxlint --deny-warnings .",
  "typecheck": "next typegen && tsc --noEmit",
  "test": "vitest",
  "test:run": "vitest run",
  "test:e2e": "playwright test",
  "e2e:seed": "node scripts/e2e/seed-fixtures.mjs",
  "test:coverage": "vitest run --coverage",
  "source:check": "node scripts/check-source-standards.mjs",
  "route:check": "node scripts/check-route-integrity.mjs",
  "ui:check": "node scripts/check-ui-standards.mjs",
  "api:check": "node scripts/check-api-registry.mjs",
  "audit:prod": "node scripts/check-npm-audit.mjs",
  "audit:prod:raw": "npm audit --omit=dev --audit-level=moderate",
  "types:supabase": "node scripts/generate-supabase-types.mjs",
  "types:supabase:check": "node scripts/generate-supabase-types.mjs --check",
  "verify:auth:sessions": "node scripts/verify-auth-session-limit.mjs",
  "check": "npm run lint && npm run source:check && npm run route:check && npm run ui:check && npm run api:check && npm run typecheck && npm run test:run && npm run format:check && npm run audit:prod && npm run build",
  "check:hanzihome:perf": "node scripts/check-hanzihome-performance.mjs",
  "prepare": "husky"
 },
 "dependencies": {
  "@base-ui/react": "^1.8.0",
  "@codemirror/lang-html": "^6.4.12",
  "@lexical/code": "^0.52.0",
  "@lexical/link": "^0.52.0",
  "@lexical/list": "^0.52.0",
  "@lexical/markdown": "^0.52.0",
  "@lexical/react": "^0.52.0",
  "@lexical/rich-text": "^0.52.0",
  "@lexical/selection": "^0.52.0",
  "@lexical/table": "^0.52.0",
  "@lexical/utils": "^0.52.0",
  "@supabase/ssr": "^0.12.7",
  "@supabase/supabase-js": "^2.117.2",
  "@tailwindcss/typography": "^0.5.20",
  "@tanstack/react-form": "^1.33.5",
  "@tanstack/react-query": "^5.104.1",
  "@tanstack/react-store": "^0.11.2",
  "@uiw/react-codemirror": "^4.25.12",
  "class-variance-authority": "^0.7.1",
  "clsx": "^2.1.1",
  "date-fns": "^4.4.0",
  "edge-tts-ts": "^1.0.0",
  "hanzi-writer": "^3.7.3",
  "lexical": "^0.52.0",
  "lucide-react": "^1.50.0",
  "next": "^16.3.8",
  "next-intl": "^4.14.9",
  "pinyin-pro": "^3.29.4",
  "prettier": "^3.9.9",
  "radix-ui": "^1.6.7",
  "react": "^19.3.0",
  "react-dom": "^19.3.0",
  "react-resizable-panels": "^4.14.2",
  "server-only": "^0.0.1",
  "sonner": "^2.0.8",
  "tailwind-merge": "^3.7.0",
  "tw-animate-css": "^1.4.0",
  "workflow": "5.0.1",
  "zod": "^4.6.5"
 },
 "devDependencies": {
  "@playwright/test": "^1.63.0",
  "@tailwindcss/postcss": "^4.3.3",
  "@types/node": "^26.6.4",
  "@types/react": "^19.3.0",
  "@types/react-dom": "^19.3.0",
  "@typescript/native": "npm:typescript@^7.0.2",
  "@vitest/coverage-v8": "^5.0.3",
  "eslint-plugin-react": "^7.37.5",
  "eslint-plugin-react-hooks": "^7.1.1",
  "husky": "^9.1.7",
  "lint-staged": "^17.6.0",
  "oxfmt": "^0.71.0",
  "oxlint": "^1.86.0",
  "postcss": "^8.5.28",
  "supabase": "^2.119.0",
  "tailwindcss": "^4.3.3",
  "typescript": "npm:@typescript/typescript6@^6.0.2",
  "vitest": "^5.0.3"
 },
 "lint-staged": {
  "*.{js,jsx,mjs,cjs,ts,tsx,mts,cts,json,jsonc,md,mdx,yml,yaml,css,scss}": "oxfmt --write --no-error-on-unmatched-pattern",
  "*.{js,jsx,mjs,cjs,ts,tsx,mts,cts}": "oxlint --deny-warnings --no-error-on-unmatched-pattern"
 },
 "packageExtensions": {
  "@workflow/nest@5.0.1": {
   "peerDependenciesMeta": {
    "@swc/cli": {
     "optional": true
    }
   }
  }
 },
 "allowScripts": {
  "@parcel/watcher@2.6.0": true,
  "@swc/core@1.15.3": true,
  "@swc/core@1.16.13": true,
  "cbor-extract@2.2.2": true,
  "esbuild@0.28.2": true,
  "fsevents@2.3.3": true
 }
}
