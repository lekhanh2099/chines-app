{
 "$schema": "./node_modules/oxlint/configuration_schema.json",
 "plugins": ["eslint", "typescript", "import", "react", "jsx-a11y", "nextjs"],
 "categories": {
  "correctness": "off",
  "suspicious": "off",
  "pedantic": "off",
  "perf": "off",
  "style": "off",
  "restriction": "off",
  "nursery": "off"
 },
 "jsPlugins": [
  {
   "name": "react-eslint",
   "specifier": "eslint-plugin-react"
  },
  {
   "name": "react-hooks-eslint",
   "specifier": "eslint-plugin-react-hooks"
  }
 ],
 "ignorePatterns": [".next/**", "out/**", "build/**", "scripts/**/*.js", "next-env.d.ts"],
 "options": {
  "maxWarnings": 0
 },
 "rules": {
  "nextjs/google-font-display": "warn",
  "nextjs/google-font-preconnect": "warn",
  "nextjs/inline-script-id": "error",
  "nextjs/next-script-for-ga": "warn",
  "nextjs/no-assign-module-variable": "error",
  "nextjs/no-async-client-component": "warn",
  "nextjs/no-before-interactive-script-outside-document": "warn",
  "nextjs/no-css-tags": "warn",
  "nextjs/no-document-import-in-page": "error",
  "nextjs/no-duplicate-head": "error",
  "nextjs/no-head-element": "warn",
  "nextjs/no-head-import-in-document": "error",
  "nextjs/no-html-link-for-pages": "error",
  "nextjs/no-img-element": "warn",
  "nextjs/no-page-custom-font": "warn",
  "nextjs/no-script-component-in-head": "error",
  "nextjs/no-styled-jsx-in-document": "warn",
  "nextjs/no-sync-scripts": "error",
  "nextjs/no-title-in-document-head": "warn",
  "nextjs/no-typos": "warn",
  "nextjs/no-unwanted-polyfillio": "warn",
  "typescript/ban-ts-comment": "error",
  "typescript/no-array-constructor": "error",
  "typescript/no-duplicate-enum-values": "error",
  "typescript/no-empty-object-type": "error",
  "typescript/no-explicit-any": "error",
  "typescript/no-extra-non-null-assertion": "error",
  "typescript/no-misused-new": "error",
  "typescript/no-namespace": "error",
  "typescript/no-non-null-asserted-optional-chain": "error",
  "typescript/no-require-imports": "error",
  "typescript/no-this-alias": "error",
  "typescript/no-unnecessary-type-constraint": "error",
  "typescript/no-unsafe-declaration-merging": "error",
  "typescript/no-unsafe-function-type": "error",
  "typescript/no-unused-expressions": "warn",
  "typescript/no-unused-vars": "warn",
  "typescript/no-wrapper-object-types": "error",
  "typescript/prefer-as-const": "error",
  "typescript/prefer-namespace-keyword": "error",
  "typescript/triple-slash-reference": "error",
  "import/no-anonymous-default-export": "warn",
  "jsx-a11y/alt-text": [
   "warn",
   {
    "elements": ["img"],
    "img": ["Image"]
   }
  ],
  "jsx-a11y/aria-props": "warn",
  "jsx-a11y/aria-proptypes": "warn",
  "jsx-a11y/aria-unsupported-elements": "warn",
  "jsx-a11y/role-has-required-aria-props": "warn",
  "jsx-a11y/role-supports-aria-props": "warn",
  "no-var": "error",
  "prefer-const": "error",
  "prefer-rest-params": "error",
  "prefer-spread": "error",
  "react-hooks-eslint/config": "error",
  "react-hooks-eslint/error-boundaries": "error",
  "react-hooks-eslint/exhaustive-deps": "warn",
  "react-hooks-eslint/gating": "error",
  "react-hooks-eslint/globals": "error",
  "react-hooks-eslint/immutability": "error",
  "react-hooks-eslint/incompatible-library": "warn",
  "react-hooks-eslint/preserve-manual-memoization": "error",
  "react-hooks-eslint/purity": "error",
  "react-hooks-eslint/refs": "error",
  "react-hooks-eslint/rules-of-hooks": "error",
  "react-hooks-eslint/set-state-in-effect": "error",
  "react-hooks-eslint/set-state-in-render": "error",
  "react-hooks-eslint/static-components": "error",
  "react-hooks-eslint/unsupported-syntax": "warn",
  "react-hooks-eslint/use-memo": "error",
  "react/display-name": "error",
  "react/jsx-key": "error",
  "react/jsx-no-comment-textnodes": "error",
  "react/jsx-no-duplicate-props": "error",
  "react/jsx-no-undef": "error",
  "react-eslint/jsx-uses-react": "error",
  "react-eslint/jsx-uses-vars": "error",
  "react/no-children-prop": "error",
  "react/no-danger-with-children": "error",
  "react-eslint/no-deprecated": "error",
  "react/no-direct-mutation-state": "error",
  "react/no-find-dom-node": "error",
  "react/no-is-mounted": "error",
  "react/no-render-return-value": "error",
  "react/no-string-refs": "error",
  "react/no-unescaped-entities": "error",
  "react/require-render-return": "error",
  "eslint/max-lines": [
   "error",
   {
    "max": 800,
    "skipBlankLines": true,
    "skipComments": true
   }
  ],
  "eslint/max-lines-per-function": [
   "error",
   {
    "max": 300,
    "skipBlankLines": true,
    "skipComments": true
   }
  ]
 },
 "overrides": [
  {
   "files": ["src/**/*.{js,jsx,ts,tsx}"],
   "rules": {
    "no-console": "error"
   }
  },
  {
   "files": ["src/lib/logger.ts"],
   "rules": {
    "no-console": "off"
   }
  },
  {
   "files": [
    "e2e/**",
    "**/*.test.mjs",
    "**/*.test.ts",
    "**/*.test.tsx",
    "**/*.fixture.ts",
    "**/*.fixture.tsx",
    "src/types/supabase.generated.ts",
    "src/features/developer-api/api-registry.ts",
    "src/lib/pronunciation/pinyin-engine.ts",
    "src/features/hanzihome/schemas/hanyu-lesson.schema.ts"
   ],
   "rules": {
    "eslint/max-lines": "off",
    "eslint/max-lines-per-function": "off"
   }
  },
  {
   "files": [
    "src/components/editor/EditorFloatingMenu.tsx",
    "src/components/editor/plugins/ToolbarPlugin.tsx",
    "src/features/daily-reading/components/DailyReadingLibrary.tsx",
    "src/features/dictation/StudioDictationWorkspace.tsx",
    "src/features/hanzihome/ai-conversation/AiConversationWorkspace.tsx",
    "src/features/hanzihome/ai-conversation/server/ai-conversation-persistence.server.ts",
    "src/features/hanzihome/components/business-chinese/BusinessChineseStudyWorkspace.tsx",
    "src/features/hanzihome/components/review/AmbientPipDictationCard.tsx",
    "src/features/hanzihome/components/vocab/VocabBulkEditDialog.tsx",
    "src/features/hanzihome/data/server/supabase-hanzihome-content-repository.ts",
    "src/features/hanzihome/html-artifacts/HanziHomeHtmlArtifactsPage.tsx",
    "src/features/hanzihome/listening/ListeningExerciseItems.tsx",
    "src/features/translation/TranslationWorkspace.tsx",
    "src/lib/pronunciation/contextual-pronunciation.ts",
    "src/services/ai/ai.service.ts",
    "src/services/vocab/vocab.service.ts"
   ],
   "rules": {
    "eslint/max-lines": "off"
   }
  },
  {
   "files": [
    "src/app/api/ai/conversation/route.ts",
    "src/components/editor/EditorFloatingMenu.tsx",
    "src/features/daily-reading/components/DailyReadingLearningSupportPanel.tsx",
    "src/features/daily-reading/components/DailyReadingLibrary.tsx",
    "src/features/daily-reading/components/DailyReadingSettingsPanel.tsx",
    "src/features/developer-api/DeveloperApiPage.tsx",
    "src/features/dictation/StudioDictationEditor.tsx",
    "src/features/dictation/StudioDictationWorkspace.tsx",
    "src/features/hanzihome/HanziHomeAggregateLibrary.tsx",
    "src/features/hanzihome/HanziHomeLibraryHome.tsx",
    "src/features/hanzihome/ai-conversation/AiConversationWorkspace.tsx",
    "src/features/hanzihome/annotations/LessonAnnotationProvider.tsx",
    "src/features/hanzihome/components/business-chinese/BusinessChineseStudyWorkspace.tsx",
    "src/features/hanzihome/components/layout/ModuleSplitWorkspaceContent.tsx",
    "src/features/hanzihome/components/lesson-overview/exercise-section/QuestionExerciseBody.tsx",
    "src/features/hanzihome/components/lesson-overview/exercise-section/SubstitutionExerciseBody.tsx",
    "src/features/hanzihome/components/practice/UniversalExerciseRunner.tsx",
    "src/features/hanzihome/components/review/AmbientPipDictationCard.tsx",
    "src/features/hanzihome/components/review/AmbientPipExerciseRunner.tsx",
    "src/features/hanzihome/components/review/AmbientPipFlashcard.tsx",
    "src/features/hanzihome/components/review/AmbientPipGrammarCard.tsx",
    "src/features/hanzihome/components/review/UnifiedVocabStudyHub.tsx",
    "src/features/hanzihome/components/vocab/VocabBulkEditDialog.tsx",
    "src/features/hanzihome/hooks/useLearningState.ts",
    "src/features/hanzihome/html-artifacts/HanziHomeHtmlArtifactsPage.tsx",
    "src/features/hanzihome/learning-loop/LearningLoopWorkspace.tsx",
    "src/features/hanzihome/practice/LessonTranslationWorkspace.tsx",
    "src/features/hanzihome/search/GlobalSearchDialog.tsx",
    "src/features/hanzihome/tts/TtsStudioWorkspace.tsx",
    "src/features/notes/components/NoteEditorPanel.tsx",
    "src/features/notes/hooks/useNoteEditor.ts",
    "src/features/reader/components/ReaderSegment.tsx",
    "src/features/reading/components/ShadowingPracticePanel.tsx",
    "src/features/reading/hooks/useReaderSelectionActions.tsx",
    "src/features/reading/pdf/PdfReaderWorkspace.tsx",
    "src/features/reading/workspaces/ReaderDocumentStudy.tsx",
    "src/features/reading/workspaces/ReaderWorkspace.tsx",
    "src/features/settings/components/AddApiKeyDialog.tsx",
    "src/features/settings/components/AiTaskSettingsSection.tsx",
    "src/features/translation/TranslationWorkspace.tsx",
    "src/hooks/useTTS.ts"
   ],
   "rules": {
    "eslint/max-lines-per-function": "off"
   }
  }
 ]
}
